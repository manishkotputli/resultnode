<%
var pageStyles = `
.product-wrapper { max-width: 900px; margin: 40px auto 60px; padding: 0 15px; }
.product-card { background: #fff; border: 1px solid #eee; border-radius: 14px; padding: 30px; box-shadow: 0px 3px 12px rgba(0,0,0,0.05); }
.product-card h1 { color: #111; font-size: 28px; margin: 0 0 10px; }
.product-card .desc { color: #555; font-size: 15px; line-height: 1.7; margin-bottom: 20px; }
.price-row { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
.price-now { font-size: 26px; font-weight: 800; color: #c00; }
.price-old { font-size: 16px; color: #999; text-decoration: line-through; }
.buy-btn { display: inline-block; background: #c00; color: #fff; padding: 13px 30px; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; }
.buy-btn:hover { background: #900; }
.owned-badge { display: inline-block; background: #0a8a3e; color: #fff; padding: 12px 24px; border-radius: 8px; font-weight: 700; }
`;
%>
<%- include('../../weblayout/layout-top', { title: title, pageStyles: pageStyles }) %>

<div class="product-wrapper">
  <div class="product-card">
    <h1><%= testSeries.title %></h1>
    <p class="desc"><%= testSeries.description %></p>
    <div class="price-row">
      <span class="price-now">&#8377;<%= testSeries.discount_price || testSeries.price %></span>
      <% if (testSeries.discount_price) { %><span class="price-old">&#8377;<%= testSeries.price %></span><% } %>
    </div>
    <% if (owned) { %>
      <span class="owned-badge">&#10003; You own this test series</span>
    <% } else { %>
      <form method="POST" action="/test-series/<%= testSeries.slug %>/buy">
        <button type="submit" class="buy-btn">Buy Now</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('../../weblayout/layout-bottom') %>
