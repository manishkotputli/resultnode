<%
var pageStyles = `
/* -------------------------------------------------------------------------- */
/* 1. CSS VARIABLES & CORE CONTAINER SETUP                                     */
/* -------------------------------------------------------------------------- */
:root {
  --sr-red: #b91c1c;
  --sr-red-hover: #991b1b;
  --sr-red-light: #fef2f2;
  --sr-navy: #0f172a;
  --sr-navy-muted: #334155;
  --sr-bg-page: #f8fafc;
  --sr-card-bg: #ffffff;
  --sr-border: #e2e8f0;
  --sr-text: #0f172a;
  --sr-text-muted: #64748b;
  --sr-green-check: #16a34a;
  --sr-radius: 16px;
  --sr-radius-sm: 8px;
  --sr-shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.04);
  --sr-shadow-md: 0 4px 14px rgba(15, 23, 42, 0.06);
  --sr-shadow-hover: 0 10px 22px rgba(15, 23, 42, 0.1);
  --sr-transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.sr-contact-container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px;
  box-sizing: border-box;
}

@media (max-width: 992px) {
  .sr-contact-container { padding: 0 20px; }
}

@media (max-width: 576px) {
  .sr-contact-container { padding: 0 14px; }
}

/* -------------------------------------------------------------------------- */
/* 2. PAGE HEADER                                                             */
/* -------------------------------------------------------------------------- */
.sr-page-header {
  text-align: center;
  padding: 36px 0 28px;
}

.sr-header-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--sr-red-light);
  color: var(--sr-red);
  font-size: 13px;
  font-weight: 700;
  padding: 5px 14px;
  border-radius: 50px;
  border: 1px solid #fecaca;
  margin-bottom: 12px;
}

.sr-page-header h1 {
  font-size: 38px;
  color: var(--sr-navy);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin: 0 0 10px 0;
  line-height: 1.2;
}

.sr-page-header .sr-subtitle {
  color: var(--sr-text-muted);
  font-size: 16px;
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 992px) {
  .sr-page-header h1 { font-size: 32px; }
}
@media (max-width: 576px) {
  .sr-page-header { padding: 24px 0 20px; }
  .sr-page-header h1 { font-size: 26px; }
  .sr-page-header .sr-subtitle { font-size: 14px; }
}

/* -------------------------------------------------------------------------- */
/* 3. CONTACT WRAPPER (INFO + FORM)                                           */
/* -------------------------------------------------------------------------- */
.sr-contact-wrapper {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 28px;
  margin-bottom: 50px;
}

@media (max-width: 850px) {
  .sr-contact-wrapper { grid-template-columns: 1fr; }
}

.sr-info-card, .sr-form-card {
  background: var(--sr-card-bg);
  padding: 30px;
  border: 1px solid var(--sr-border);
  border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow-md);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sr-section-title {
  color: var(--sr-navy);
  margin: 0 0 20px 0;
  font-size: 20px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 2px solid var(--sr-red-light);
  padding-bottom: 10px;
}

.sr-section-title span.icon {
  color: var(--sr-red);
}

.sr-info-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 18px;
}

.sr-info-icon {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--sr-red-light);
  color: var(--sr-red);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
  margin-top: 2px;
}

.sr-info-text label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--sr-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 2px;
}

.sr-info-text p {
  font-size: 15px;
  color: var(--sr-text);
  font-weight: 600;
  margin: 0;
  line-height: 1.4;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.sr-social-links {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.sr-social-links a {
  display: inline-flex;
  align-items: center;
  padding: 8px 14px;
  background: var(--sr-bg-page);
  border: 1px solid var(--sr-border);
  border-radius: var(--sr-radius-sm);
  font-size: 13px;
  color: var(--sr-navy-muted);
  font-weight: 700;
  text-decoration: none;
  transition: var(--sr-transition);
}

.sr-social-links a:hover {
  background: var(--sr-red);
  color: #ffffff;
  border-color: var(--sr-red);
}

/* Form Elements */
.sr-form-group {
  margin-bottom: 18px;
}

.sr-form-group label {
  font-weight: 700;
  font-size: 13px;
  color: var(--sr-navy);
  margin-bottom: 6px;
  display: block;
}

.sr-form-group input, 
.sr-form-group textarea {
  width: 100%;
  border: 1px solid var(--sr-border);
  border-radius: var(--sr-radius-sm);
  padding: 0 14px;
  font-size: 14px;
  background: #ffffff;
  color: var(--sr-text);
  box-sizing: border-box;
  transition: var(--sr-transition);
  font-family: inherit;
}

.sr-form-group input {
  height: 46px;
}

.sr-form-group textarea {
  height: 130px;
  padding-top: 12px;
  padding-bottom: 12px;
  resize: vertical;
}

.sr-form-group input:focus, 
.sr-form-group textarea:focus {
  border-color: var(--sr-red);
  outline: none;
  box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.12);
}

.sr-btn-submit {
  width: 100%;
  height: 48px;
  background: var(--sr-red);
  color: #ffffff;
  border: none;
  border-radius: var(--sr-radius-sm);
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition: var(--sr-transition);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.sr-btn-submit:hover {
  background: var(--sr-red-hover);
  box-shadow: 0 4px 12px rgba(185, 28, 28, 0.25);
}

/* -------------------------------------------------------------------------- */
/* 4. EDITORIAL TEAM SECTION — PREMIUM REDESIGN                               */
/* -------------------------------------------------------------------------- */
.sr-team-section {
  width: 100%;
  margin: 60px 0;
  position: relative;
}

.sr-team-header {
  text-align: center;
  margin-bottom: 36px;
}

.sr-team-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, #fef2f2, #fff1f1);
  color: var(--sr-red);
  font-size: 12px;
  font-weight: 800;
  padding: 5px 14px;
  border-radius: 50px;
  border: 1px solid #fecaca;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 12px;
}

.sr-team-header h2 {
  font-size: 30px;
  font-weight: 800;
  color: var(--sr-navy);
  margin: 0 0 8px 0;
  letter-spacing: -0.01em;
}

.sr-team-header p {
  color: var(--sr-text-muted);
  font-size: 15px;
  margin: 0 auto;
  max-width: 680px;
  line-height: 1.6;
}

/* CENTERING FLEX GRID */
.sr-team-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: stretch;
  gap: 26px;
}

/* PREMIUM CARD */
.sr-team-card {
  width: 260px;
  max-width: 260px;
  flex: 0 1 260px;
  min-height: 300px;
  background: var(--sr-card-bg);
  border: 1px solid var(--sr-border);
  border-radius: 20px;
  padding: 30px 20px 24px;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: var(--sr-transition);
  position: relative;
  overflow: hidden;
}

/* Top gradient accent bar */
.sr-team-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--sr-red), #f97373, var(--sr-navy));
  opacity: 0;
  transition: opacity 0.25s ease;
}

.sr-team-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 18px 34px rgba(15, 23, 42, 0.14);
  border-color: transparent;
}

.sr-team-card:hover::before {
  opacity: 1;
}

/* Avatar with glow ring — fully circular (50% radius) */
.sr-avatar-wrapper {
  position: relative;
  width: 100px;
  height: 100px;
  margin-bottom: 16px;
  flex-shrink: 0;
  border-radius: 50%;
  padding: 4px;
  background: linear-gradient(135deg, var(--sr-red), #fca5a5, var(--sr-navy));
}

.sr-avatar-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
  display: block;
}

.sr-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  background: var(--sr-bg-page);
}

.sr-verified-badge {
  position: absolute;
  bottom: 2px;
  right: 2px;
  background: var(--sr-green-check);
  color: #ffffff;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
  border: 2.5px solid #ffffff;
  box-shadow: 0 2px 6px rgba(22, 163, 74, 0.4);
}

.sr-team-name {
  font-size: 17px;
  font-weight: 800;
  color: var(--sr-navy);
  margin-bottom: 6px;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.sr-team-role {
  display: inline-block;
  background: var(--sr-red-light);
  color: var(--sr-red);
  font-size: 11px;
  font-weight: 800;
  padding: 4px 12px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 12px;
}

.sr-team-bio {
  font-size: 12.5px;
  color: var(--sr-text-muted);
  margin: 0 0 16px 0;
  line-height: 1.5;
}

/* PREMIUM SOCIAL ICON ROW — Email / Mobile / Instagram */
.sr-team-social-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px dashed var(--sr-border);
  width: 100%;
}

.sr-team-social-row a {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  text-decoration: none;
  background: var(--sr-bg-page);
  border: 1px solid var(--sr-border);
  color: var(--sr-navy-muted);
  transition: var(--sr-transition);
}

.sr-team-social-row a.icon-email:hover {
  background: var(--sr-red);
  border-color: var(--sr-red);
  color: #ffffff;
  transform: translateY(-3px);
}

.sr-team-social-row a.icon-mobile:hover {
  background: #16a34a;
  border-color: #16a34a;
  color: #ffffff;
  transform: translateY(-3px);
}

.sr-team-social-row a.icon-instagram:hover {
  background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af, #515bd4);
  border-color: transparent;
  color: #ffffff;
  transform: translateY(-3px);
}

@media (max-width: 576px) {
  .sr-team-grid {
    gap: 16px;
  }
  .sr-team-card {
    width: min(100%, 320px);
    max-width: min(100%, 320px);
    flex: 0 1 min(100%, 320px);
  }
}

/* -------------------------------------------------------------------------- */
/* 5. FAQ ACCORDION SECTION                                                   */
/* -------------------------------------------------------------------------- */
.sr-faq-section {
  width: 100%;
  margin: 54px 0;
}

.sr-faq-title {
  text-align: center;
  font-size: 26px;
  font-weight: 800;
  color: var(--sr-navy);
  margin-bottom: 28px;
}

.sr-faq-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sr-faq-item {
  background: var(--sr-card-bg);
  border: 1px solid var(--sr-border);
  border-radius: var(--sr-radius-sm);
  box-shadow: var(--sr-shadow-sm);
  overflow: hidden;
}

.sr-faq-question {
  width: 100%;
  padding: 16px 20px;
  background: transparent;
  border: none;
  text-align: left;
  font-size: 16px;
  font-weight: 700;
  color: var(--sr-navy);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.sr-faq-icon {
  font-size: 18px;
  color: var(--sr-red);
  transition: transform 0.2s ease;
}

.sr-faq-item.active .sr-faq-icon {
  transform: rotate(45deg);
}

.sr-faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s cubic-bezier(0, 1, 0, 1);
  background: #fafafa;
  border-top: 1px solid transparent;
}

.sr-faq-item.active .sr-faq-answer {
  max-height: 300px;
  border-top-color: var(--sr-border);
}

.sr-faq-answer p {
  padding: 16px 20px;
  margin: 0;
  font-size: 14px;
  color: var(--sr-text-muted);
  line-height: 1.6;
}

/* -------------------------------------------------------------------------- */
/* 6. MAP SECTION                                                             */
/* -------------------------------------------------------------------------- */
.sr-map-section {
  width: 100%;
  margin: 48px 0 24px;
  text-align: center;
}

.sr-map-title {
  font-size: 22px;
  margin-bottom: 18px;
  color: var(--sr-navy);
  font-weight: 800;
}

.sr-map-frame-wrapper {
  border-radius: var(--sr-radius);
  overflow: hidden;
  border: 1px solid var(--sr-border);
  box-shadow: var(--sr-shadow-md);
  height: 350px;
  width: 100%;
}

.sr-map-frame-wrapper iframe {
  width: 100%;
  height: 100%;
  border: 0;
}

@media (max-width: 576px) {
  .sr-map-frame-wrapper { height: 260px; }
}

/* Disclaimer Notice */
.sr-disclaimer-notice {
  text-align: center;
  font-size: 13px;
  color: var(--sr-text-muted);
  margin: 32px 0 10px;
  padding: 12px;
  background: var(--sr-red-light);
  border: 1px dashed #fecaca;
  border-radius: var(--sr-radius-sm);
}
`;
%>

<%- include('../weblayout/layout-top', { title: title, pageStyles: pageStyles }) %>

<div class="sr-contact-container">

  <!-- PAGE HEADER -->
  <header class="sr-page-header">
    <div class="sr-header-badge">✓ Help & Support Center</div>
    <h1>Contact Our Team</h1>
    <p class="sr-subtitle">Have questions regarding Sarkari results, job notifications, admit cards, answer keys or government recruitment updates? Get in touch with our team.</p>
  </header>

  <!-- CONTACT INFO & FORM SECTION -->
  <div class="sr-contact-wrapper">
    
    <!-- LEFT: Contact Information Card -->
    <div class="sr-info-card">
      <h2 class="sr-section-title"><span class="icon">&#128222;</span> Get in Touch</h2>
      
      <div class="sr-info-item">
        <div class="sr-info-icon">&#9993;</div>
        <div class="sr-info-text">
          <label>Email Support</label>
          <p><%= (site_setting && site_setting.contact_email) || 'Not Available' %></p>
        </div>
      </div>

      <div class="sr-info-item">
        <div class="sr-info-icon">&#128222;</div>
        <div class="sr-info-text">
          <label>Phone Line</label>
          <p><%= (site_setting && site_setting.contact_phone) || 'Not Available' %></p>
        </div>
      </div>

      <div class="sr-info-item">
        <div class="sr-info-icon">&#128336;</div>
        <div class="sr-info-text">
          <label>Working Hours</label>
          <p><%= (site_setting && site_setting.contact_hours) || 'Mon - Sat (10:00 AM - 6:00 PM)' %></p>
        </div>
      </div>

      <h2 class="sr-section-title" style="margin-top: 24px;"><span class="icon">&#127760;</span> Office Address</h2>
      <div class="sr-info-item">
        <div class="sr-info-icon">&#128205;</div>
        <div class="sr-info-text">
          <label>Location</label>
          <p><%- ((site_setting && site_setting.contact_address) || 'Address not available.').replace(/\n/g, '<br>') %></p>
        </div>
      </div>

      <% if (site_setting && (site_setting.facebook_url || site_setting.instagram_url || site_setting.twitter_url || site_setting.youtube_url || site_setting.telegram_url)) { %>
        <h2 class="sr-section-title" style="margin-top: 24px;"><span class="icon">&#128279;</span> Official Handles</h2>
        <div class="sr-social-links">
          <% if (site_setting.facebook_url) { %><a href="<%= site_setting.facebook_url %>" target="_blank" rel="noopener">Facebook</a><% } %>
          <% if (site_setting.instagram_url) { %><a href="<%= site_setting.instagram_url %>" target="_blank" rel="noopener">Instagram</a><% } %>
          <% if (site_setting.twitter_url) { %><a href="<%= site_setting.twitter_url %>" target="_blank" rel="noopener">Twitter</a><% } %>
          <% if (site_setting.youtube_url) { %><a href="<%= site_setting.youtube_url %>" target="_blank" rel="noopener">YouTube</a><% } %>
          <% if (site_setting.telegram_url) { %><a href="<%= site_setting.telegram_url %>" target="_blank" rel="noopener">Telegram</a><% } %>
        </div>
      <% } %>
    </div>

    <!-- RIGHT: Send Us A Message Form -->
    <div class="sr-form-card">
      <h2 class="sr-section-title"><span class="icon">&#128231;</span> Send Us a Message</h2>
      <form action="/contact/send" method="POST">
        <div class="sr-form-group">
          <label for="input-name">Your Name</label>
          <input type="text" id="input-name" name="name" placeholder="Enter your full name" required>
        </div>
        
        <div class="sr-form-group">
          <label for="input-email">Your Email</label>
          <input type="email" id="input-email" name="email" placeholder="Enter your email address" required>
        </div>
        
        <div class="sr-form-group">
          <label for="input-subject">Subject</label>
          <input type="text" id="input-subject" name="subject" placeholder="What is this regarding?">
        </div>
        
        <div class="sr-form-group">
          <label for="input-message">Your Message</label>
          <textarea id="input-message" name="message" placeholder="Write your message here..." required></textarea>
        </div>
        
        <button type="submit" class="sr-btn-submit">
          <span>Send Message</span> &#10148;
        </button>
      </form>
    </div>

  </div>

  <!-- EDITORIAL TEAM SECTION — PREMIUM -->
  <% if (team_members && team_members.length > 0) { %>
    <section class="sr-team-section">
      <div class="sr-team-header">
        <span class="sr-team-badge">&#11088; Verified Editorial Staff</span>
        <h2>Meet Our Editorial Board</h2>
        <p>Our editorial team works behind the scenes to verify exam results, admit cards, answer keys, recruitment notifications and important government updates.</p>
      </div>

      <!-- CENTERED FLEX GRID -->
      <div class="sr-team-grid">
        <% team_members.forEach(function(member) { %>
          <div class="sr-team-card">
            <div class="sr-avatar-wrapper">
              <span class="sr-avatar-inner">
                <%
                  var avatarSrc = member.profile_photo
                    ? '/uploads/users/' + member.profile_photo
                    : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(member.name) + '&background=b91c1c&color=fff&bold=true';
                %>
                <img src="<%= avatarSrc %>" alt="<%= member.name %>" class="sr-avatar-img" loading="lazy" onerror="this.src='https://ui-avatars.com/api/?name=User&background=0f172a&color=fff'">
              </span>
              <span class="sr-verified-badge" title="Verified Author"><i class="ti ti-check"></i></span>
            </div>

            <div class="sr-team-name"><%= member.name %></div>
            <div class="sr-team-role">
              <%
                var roleId = Number(member.role_id);
                var roleName = member.role_name || (member.Role ? member.Role.name : '');

                if (roleId === 2 || roleId === 3) {
                  roleName = 'Owner';
                } else if (roleId === 4) {
                  roleName = 'Developer';
                } else if (!roleName) {
                  roleName = 'Editorial Member';
                }
              %>
              <%= roleName %>
            </div>

            <% if (member.bio || member.description) { %>
              <p class="sr-team-bio"><%= member.bio || member.description %></p>
            <% } %>

            <div class="sr-team-social-row">
              <% if (member.email) { %>
                <a href="mailto:<%= member.email %>" class="icon-email" title="Email <%= member.name %>" aria-label="Email">
                  <i class="ti ti-mail"></i>
                </a>
              <% } %>
              <% if (member.phone || member.mobile) { %>
                <a href="tel:<%= member.phone || member.mobile %>" class="icon-mobile" title="Call <%= member.name %>" aria-label="Call">
                  <i class="ti ti-phone"></i>
                </a>
              <% } %>
              <% if (member.instagram_url) { %>
                <a href="<%= member.instagram_url %>" target="_blank" rel="noopener" class="icon-instagram" title="Instagram" aria-label="Instagram">
                  <i class="ti ti-brand-instagram"></i>
                </a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- FAQ SECTION -->
  <section class="sr-faq-section">
    <h2 class="sr-faq-title">Frequently Asked Questions</h2>
    <div class="sr-faq-container">
      
      <div class="sr-faq-item">
        <button class="sr-faq-question" type="button">
          <span>📌 How can I check my exam results?</span>
          <span class="sr-faq-icon">+</span>
        </button>
        <div class="sr-faq-answer">
          <p>You can check all government exam results directly from the "Result" section on our homepage.</p>
        </div>
      </div>

      <div class="sr-faq-item">
        <button class="sr-faq-question" type="button">
          <span>📌 How do I apply for government jobs?</span>
          <span class="sr-faq-icon">+</span>
        </button>
        <div class="sr-faq-answer">
          <p>Visit the "Latest Jobs" section to find active vacancies along with official application links.</p>
        </div>
      </div>

      <div class="sr-faq-item">
        <button class="sr-faq-question" type="button">
          <span>📌 How can I download my admit card?</span>
          <span class="sr-faq-icon">+</span>
        </button>
        <div class="sr-faq-answer">
          <p>Navigate to the "Admit Card" tab where verified hall tickets are updated daily.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- GOOGLE MAP SECTION -->
  <% if (site_setting && site_setting.google_map_embed) { %>
    <section class="sr-map-section">
      <h2 class="sr-map-title">&#128205; Find Us on Google Maps</h2>
      <div class="sr-map-frame-wrapper">
        <iframe src="<%= site_setting.google_map_embed %>" allowfullscreen="" loading="lazy"></iframe>
      </div>
    </section>
  <% } %>

  <!-- DISCLAIMER -->
  <div class="sr-disclaimer-notice">
    <strong>Disclaimer:</strong> This is an informational portal. Please verify all details on the official website before applying.
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var faqQuestions = document.querySelectorAll('.sr-faq-question');
    faqQuestions.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = this.parentElement;
        var isActive = item.classList.contains('active');
        
        // Close all faq items
        document.querySelectorAll('.sr-faq-item').forEach(function(el) {
          el.classList.remove('active');
        });

        // Toggle clicked item
        if (!isActive) {
          item.classList.add('active');
        }
      });
    });
  });
</script>

<%- include('../weblayout/layout-bottom') %>
