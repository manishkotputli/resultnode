
<%
var pageStyles = `
/* =========================================================
   PRIVACY POLICY PAGE
   SEO + READABILITY + MOBILE FRIENDLY
   ========================================================= */

.page-header {
    text-align: center;
    margin: 42px auto 24px;
    padding: 0 15px;
    max-width: 900px;
}

.page-header h1 {
    font-size: 34px;
    line-height: 1.25;
    color: #b31335;
    font-weight: 800;
    margin: 0 0 10px;
}

.page-header .subtitle {
    font-size: 15px;
    line-height: 1.7;
    color: #666;
    margin: 0 auto;
    max-width: 760px;
}

.policy-wrapper {
    max-width: 900px;
    margin: 0 auto 70px;
    padding: 0 15px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.policy-card {
    background: #fff;
    border-radius: 10px;
    padding: 24px 28px;
    border: 1px solid #e9e9e9;
    box-shadow: 0 5px 18px rgba(0,0,0,0.035);
}

.policy-card h2 {
    color: #1b1b1b;
    font-size: 20px;
    line-height: 1.4;
    margin: 0 0 12px;
    font-weight: 750;
}

.policy-card h3 {
    color: #333;
    font-size: 16px;
    line-height: 1.5;
    margin: 18px 0 8px;
    font-weight: 700;
}

.policy-card p,
.policy-card li {
    color: #444;
    font-size: 15px;
    line-height: 1.75;
}

.policy-card p {
    margin: 0 0 12px;
}

.policy-card p:last-child {
    margin-bottom: 0;
}

.policy-card ul {
    margin: 8px 0 14px 21px;
    padding: 0;
}

.policy-card li {
    margin-bottom: 5px;
}

.policy-card a {
    color: #0033cc;
    text-decoration: none;
    font-weight: 600;
}

.policy-card a:hover {
    color: #b31335;
    text-decoration: underline;
}

.policy-highlight {
    background: #fff8f8;
    border-left: 4px solid #b31335;
    padding: 14px 16px;
    margin: 15px 0;
    border-radius: 4px;
}

.policy-highlight p {
    margin: 0;
}

.policy-date {
    font-size: 13px !important;
    color: #777 !important;
    margin-top: 18px !important;
}

.policy-small {
    font-size: 13px !important;
    color: #666 !important;
}

.policy-link-list {
    margin-top: 8px;
}

.policy-link-list a {
    display: inline-block;
    margin: 3px 0;
}

.contact-box {
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 14px 16px;
}

@media(max-width: 768px) {

    .page-header {
        margin: 28px auto 18px;
        padding: 0 12px;
    }

    .page-header h1 {
        font-size: 28px;
    }

    .page-header .subtitle {
        font-size: 14px;
        line-height: 1.65;
    }

    .policy-wrapper {
        padding: 0 10px;
        gap: 12px;
        margin-bottom: 45px;
    }

    .policy-card {
        padding: 19px 16px;
        border-radius: 8px;
    }

    .policy-card h2 {
        font-size: 18px;
    }

    .policy-card h3 {
        font-size: 15px;
        margin-top: 16px;
    }

    .policy-card p,
    .policy-card li {
        font-size: 14px;
        line-height: 1.7;
    }

    .policy-card ul {
        margin-left: 19px;
    }
}
`;
%>

<%- include('../weblayout/layout-top', {
    title: title || 'Privacy Policy - SarkariResultess.Com',
    pageStyles: pageStyles
}) %>

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<header class="page-header">

    <h1>Privacy Policy</h1>

    <p class="subtitle">
        Learn how SarkariResultess.Com collects, uses, protects and
        handles information when you visit or use our website.
    </p>

</header>


<main class="policy-wrapper">

    <!-- =====================================================
         1. INTRODUCTION
         ===================================================== -->

    <section class="policy-card">

        <h2>1. Introduction</h2>

        <p>
            Welcome to
            <strong>
                <%= (site_setting && site_setting.site_title) || 'SarkariResultess.Com' %>
            </strong>.
        </p>

        <p>
            We respect your privacy and are committed to providing
            transparent information about how data may be collected and
            used when you access our website.
        </p>

        <p>
            This Privacy Policy explains the types of information that
            may be collected, the purposes for which information may be
            used, the role of cookies and third-party services, and the
            choices available to website visitors.
        </p>

        <p>
            This policy applies to visitors who access our website,
            including its pages, articles, search features, contact
            forms and other online functionality.
        </p>

        <p class="policy-date">
            <strong>Last Updated:</strong>
            <%= new Date().toLocaleDateString('en-IN', {
                day: '2-digit',
                month: 'long',
                year: 'numeric'
            }) %>
        </p>

    </section>


    <!-- =====================================================
         2. INFORMATION WE COLLECT
         ===================================================== -->

    <section class="policy-card">

        <h2>2. Information We May Collect</h2>

        <h3>Information You Voluntarily Provide</h3>

        <p>
            If you choose to contact us or use a feature that requires
            information, we may receive information that you voluntarily
            submit, which may include:
        </p>

        <ul>
            <li>Name</li>
            <li>Email address</li>
            <li>Phone number, if voluntarily provided</li>
            <li>Messages or enquiries submitted through contact forms</li>
            <li>Other information that you voluntarily choose to provide</li>
        </ul>

        <h3>Information Collected Automatically</h3>

        <p>
            When you visit our website, certain technical and usage
            information may be collected automatically by our website,
            hosting provider, analytics services or advertising partners.
        </p>

        <ul>
            <li>IP address</li>
            <li>Browser type and version</li>
            <li>Device type</li>
            <li>Operating system</li>
            <li>Pages or content viewed</li>
            <li>Approximate website usage information</li>
            <li>Referring website or page</li>
            <li>Date and time of access</li>
        </ul>

        <p>
            This information may be used for website operation,
            security, analytics, performance measurement and other
            legitimate website-related purposes.
        </p>

    </section>


    <!-- =====================================================
         3. COOKIES
         ===================================================== -->

    <section class="policy-card">

        <h2>3. Cookies and Similar Technologies</h2>

        <p>
            SarkariResultess.Com may use cookies and similar technologies
            to support website functionality, remember preferences,
            understand website usage, measure performance and improve
            the browsing experience.
        </p>

        <p>
            Cookies are small files or identifiers stored by a browser
            or used by services operating on a website. Different
            services may use different types of cookies or similar
            technologies.
        </p>

        <h3>Third-Party Cookies</h3>

        <p>
            Third-party service providers, including advertising and
            analytics providers, may use cookies, web beacons, IP
            addresses or similar technologies when their services are
            used on our website.
        </p>

        <p>
            You can control or delete cookies through your browser
            settings. Some website functionality may be affected if
            certain cookies are disabled.
        </p>

    </section>


    <!-- =====================================================
         4. GOOGLE ADVERTISING
         ===================================================== -->

    <section class="policy-card">

        <h2>4. Google Advertising and Third-Party Advertising</h2>

        <p>
            We may use Google advertising services, including Google
            AdSense, to display advertisements on our website.
        </p>

        <p>
            Third-party vendors, including Google, may use cookies to
            serve advertisements based on a user's prior visits to this
            website or other websites.
        </p>

        <p>
            Google's use of advertising cookies enables Google and its
            partners to serve advertisements based on a user's visits
            to this website and/or other websites on the Internet.
        </p>

        <p>
            Advertising services may use cookies, web beacons, IP
            addresses and similar technologies to deliver advertisements,
            measure advertising performance, prevent repeated
            advertisements and support advertising-related reporting.
        </p>

        <div class="policy-highlight">

            <p>
                <strong>Advertising preferences:</strong>
                Users may be able to control or opt out of personalized
                advertising through Google's advertising settings.
            </p>

        </div>

        <p class="policy-link-list">
            <strong>Useful Google privacy and advertising resources:</strong>
        </p>

        <p class="policy-link-list">

            <a
                href="https://adssettings.google.com/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Google Ads Settings
            </a>

            <br>

            <a
                href="https://policies.google.com/technologies/partner-sites"
                target="_blank"
                rel="noopener noreferrer"
            >
                How Google uses information from sites or apps that use
                its services
            </a>

        </p>

        <p>
            Other advertising networks or partners may also be used on
            the website. Where applicable, their respective privacy
            policies and cookie practices may apply.
        </p>

    </section>


    <!-- =====================================================
         5. ANALYTICS
         ===================================================== -->

    <section class="policy-card">

        <h2>5. Analytics and Website Measurement</h2>

        <p>
            We may use analytics and website measurement services to
            understand how visitors use our website and to improve
            website performance and content.
        </p>

        <p>
            Depending on the services implemented on the website,
            analytics providers may process information such as
            approximate location, device information, browser
            information, pages viewed, traffic sources and usage
            events.
        </p>

        <p>
            Analytics providers process information according to their
            own privacy policies and applicable terms.
        </p>

    </section>


    <!-- =====================================================
         6. HOW INFORMATION IS USED
         ===================================================== -->

    <section class="policy-card">

        <h2>6. How We Use Information</h2>

        <p>
            Information collected through the website may be used for
            legitimate purposes such as:
        </p>

        <ul>

            <li>
                Providing and maintaining website functionality
            </li>

            <li>
                Responding to enquiries and support requests
            </li>

            <li>
                Improving website content and user experience
            </li>

            <li>
                Understanding website traffic and usage
            </li>

            <li>
                Monitoring website performance
            </li>

            <li>
                Detecting technical problems and security issues
            </li>

            <li>
                Preventing spam, abuse and fraudulent activity
            </li>

            <li>
                Providing communications that users have requested
            </li>

            <li>
                Complying with applicable legal or regulatory obligations
            </li>

        </ul>

    </section>


    <!-- =====================================================
         7. INFORMATION SHARING
         ===================================================== -->

    <section class="policy-card">

        <h2>7. Sharing of Information</h2>

        <p>
            We do not sell personal information as a standalone
            commercial product.
        </p>

        <p>
            Information may be shared with service providers or
            technology partners when reasonably necessary to operate,
            maintain, secure, analyse or improve the website.
        </p>

        <p>
            Such providers may include hosting providers, analytics
            services, advertising providers, security services,
            communication providers and other technical service
            providers used by the website.
        </p>

        <p>
            Information may also be disclosed when required by applicable
            law, legal process, court order or to protect the rights,
            security or property of the website, its users or others.
        </p>

    </section>


    <!-- =====================================================
         8. EXTERNAL LINKS
         ===================================================== -->

    <section class="policy-card">

        <h2>8. External Links and Official Sources</h2>

        <p>
            SarkariResultess.Com may contain links to external websites,
            including government departments, examination authorities,
            recruitment boards, universities, educational institutions
            and other third-party websites.
        </p>

        <p>
            These links are provided as useful references. Once you
            leave our website, the privacy policy, terms and data
            practices of the external website may apply.
        </p>

        <p>
            We do not control the privacy practices, security practices
            or content of independent external websites.
        </p>

    </section>


    <!-- =====================================================
         9. DATA SECURITY
         ===================================================== -->

    <section class="policy-card">

        <h2>9. Data Security</h2>

        <p>
            We take reasonable technical and organisational measures
            appropriate to the nature of the information handled through
            our website to help protect it from unauthorized access,
            misuse, alteration or disclosure.
        </p>

        <p>
            However, no internet transmission, website or electronic
            storage system can be guaranteed to be completely secure.
            Users should therefore avoid submitting unnecessary
            sensitive information through public forms or online
            communications.
        </p>

    </section>


    <!-- =====================================================
         10. DATA RETENTION
         ===================================================== -->

    <section class="policy-card">

        <h2>10. Data Retention</h2>

        <p>
            Information may be retained for as long as reasonably
            necessary for the purpose for which it was collected,
            including providing website services, maintaining records,
            complying with applicable obligations, resolving disputes,
            preventing abuse and protecting legitimate interests.
        </p>

        <p>
            Retention periods may vary depending on the type of
            information and the reason for processing it.
        </p>

    </section>


    <!-- =====================================================
         11. PRIVACY CHOICES
         ===================================================== -->

    <section class="policy-card">

        <h2>11. Your Privacy Choices</h2>

        <p>
            Depending on applicable law and the circumstances in which
            information is processed, you may have certain rights or
            choices regarding your personal information.
        </p>

        <ul>

            <li>
                Request information about personal data we may hold
            </li>

            <li>
                Request correction of inaccurate information
            </li>

            <li>
                Request deletion where legally applicable
            </li>

            <li>
                Withdraw consent where processing is based on consent
            </li>

            <li>
                Control cookies through browser settings
            </li>

            <li>
                Manage certain advertising preferences through
                applicable advertising provider settings
            </li>

        </ul>

        <p>
            To make a privacy-related request, please contact us using
            the contact information provided below.
        </p>

    </section>


    <!-- =====================================================
         12. CHILDREN
         ===================================================== -->

    <section class="policy-card">

        <h2>12. Children's Privacy</h2>

        <p>
            Our website provides general information relating to
            government jobs, examinations, admissions, results,
            answer keys and educational opportunities.
        </p>

        <p>
            We do not knowingly request unnecessary personal information
            from children.
        </p>

        <p>
            If you believe that a child has provided personal information
            through our website without appropriate authorization,
            please contact us so that the matter can be reviewed.
        </p>

    </section>


    <!-- =====================================================
         13. GOVERNMENT INFORMATION DISCLAIMER
         ===================================================== -->

    <section class="policy-card">

        <h2>13. Government Information Disclaimer</h2>

        <div class="policy-highlight">

            <p>
                <strong>Important:</strong>
                SarkariResultess.Com is an independent informational
                website. It is not a government website and is not
                affiliated with, authorized by, endorsed by or officially
                connected with any government department, recruitment
                board, examination authority, university or other
                government organization unless specifically stated.
            </p>

        </div>

        <p>
            We publish recruitment, examination, admission, result,
            answer key, syllabus, eligibility, application and other
            educational information for informational purposes.
        </p>

        <p>
            Before applying for a job, examination, admission or other
            opportunity, users should verify the relevant details,
            eligibility requirements, dates, fees, notices and application
            instructions from the applicable official source.
        </p>

    </section>


    <!-- =====================================================
         14. ACCURACY OF INFORMATION
         ===================================================== -->

    <section class="policy-card">

        <h2>14. Information Accuracy</h2>

        <p>
            We make reasonable efforts to provide useful and up-to-date
            information. However, information published on the website
            may change after publication due to updates issued by
            official authorities or other sources.
        </p>

        <p>
            We do not guarantee that every piece of information will
            always be complete, current or error-free.
        </p>

        <p>
            Users should rely on the relevant official notification or
            official website for final confirmation before making
            important decisions.
        </p>

    </section>


    <!-- =====================================================
         15. POLICY CHANGES
         ===================================================== -->

    <section class="policy-card">

        <h2>15. Changes to This Privacy Policy</h2>

        <p>
            We may update this Privacy Policy from time to time to
            reflect changes in our website, services, technology,
            advertising partners, analytics tools, legal requirements
            or privacy practices.
        </p>

        <p>
            Any updated version will be published on this page with a
            revised "Last Updated" date.
        </p>

        <p>
            We encourage visitors to review this page periodically to
            understand the latest privacy practices applicable to the
            website.
        </p>

    </section>


    <!-- =====================================================
         16. CONTACT US
         ===================================================== -->

    <section class="policy-card">

        <h2>16. Contact Us</h2>

        <p>
            If you have questions, concerns or requests regarding this
            Privacy Policy or the handling of information through our
            website, you can contact us using the details below.
        </p>

        <div class="contact-box">

            <% if (site_setting && site_setting.contact_email) { %>

                <p>
                    <strong>Email:</strong>
                    <%= site_setting.contact_email %>
                </p>

            <% } %>


            <% if (site_setting && site_setting.contact_phone) { %>

                <p>
                    <strong>Phone:</strong>
                    <%= site_setting.contact_phone %>
                </p>

            <% } %>


            <% if (
                (!site_setting || !site_setting.contact_email) &&
                (!site_setting || !site_setting.contact_phone)
            ) { %>

                <p>
                    Please visit our
                    <a href="/contact">
                        Contact Us
                    </a>
                    page to get in touch with us.
                </p>

            <% } %>

        </div>

    </section>


    <!-- =====================================================
         17. FINAL NOTICE
         ===================================================== -->

    <section class="policy-card">

        <h2>17. Important Notice</h2>

        <div class="policy-highlight">

            <p>
                SarkariResultess.Com is an independent information
                platform. Content available on this website is provided
                for general informational purposes. Users should verify
                important recruitment, examination, admission, result,
                eligibility, fee, deadline and application information
                through the applicable official source before taking
                action.
            </p>

        </div>

        <p class="policy-small">
            By continuing to use this website, you acknowledge that you
            have read this Privacy Policy and understand the general
            information provided about cookies, advertising, analytics
            and data handling.
        </p>

    </section>

</main>


<%- include('../weblayout/layout-bottom') %>
