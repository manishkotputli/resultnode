<%
var pageStyles = `
.page-header {
    text-align: center;
    margin: 40px 0 20px;
}

.page-header h1 {
    font-size: 32px;
    color: #b31335;
    font-weight: 800;
    margin-bottom: 8px;
}

.page-header .subtitle {
    font-size: 15px;
    color: #666;
    margin: 0;
}

.policy-wrapper {
    max-width: 900px;
    margin: 0 auto 60px;
    padding: 0 15px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.policy-card {
    background: #fff;
    border-radius: 10px;
    padding: 22px 26px;
    border: 1px solid #ececec;
    box-shadow: 0 6px 20px rgba(0,0,0,0.03);
}

.policy-card h2 {
    color: #1b1b1b;
    font-size: 19px;
    margin: 0 0 10px;
    font-weight: 700;
}

.policy-card h3 {
    color: #333;
    font-size: 16px;
    margin: 14px 0 8px;
    font-weight: 700;
}

.policy-card p,
.policy-card li {
    color: #444;
    font-size: 15px;
    line-height: 1.7;
}

.policy-card p {
    margin: 0 0 10px;
}

.policy-card p:last-child {
    margin-bottom: 0;
}

.policy-card ul {
    margin: 8px 0 12px 20px;
    padding: 0;
}

.policy-card li {
    margin-bottom: 4px;
}

.policy-card a {
    color: #0033cc;
    text-decoration: none;
    font-weight: 600;
}

.policy-card a:hover {
    color: #b31335;
    text-decoration: underline;
}

.policy-highlight {
    background: #fff8f8;
    border-left: 4px solid #b31335;
    padding: 12px 15px;
    margin: 12px 0;
}

.policy-date {
    font-size: 13px !important;
    color: #777 !important;
}

@media(max-width: 768px) {

    .page-header {
        margin: 25px 0 15px;
        padding: 0 10px;
    }

    .page-header h1 {
        font-size: 27px;
    }

    .page-header .subtitle {
        font-size: 14px;
    }

    .policy-wrapper {
        padding: 0 10px;
        gap: 12px;
    }

    .policy-card {
        padding: 18px 16px;
        border-radius: 8px;
    }

    .policy-card h2 {
        font-size: 18px;
    }

    .policy-card h3 {
        font-size: 15px;
    }

    .policy-card p,
    .policy-card li {
        font-size: 14px;
        line-height: 1.65;
    }
}
`;
%>

<%- include('../weblayout/layout-top', {
    title: title,
    pageStyles: pageStyles
}) %>


<div class="page-header">

    <h1>Privacy Policy</h1>

    <p class="subtitle">
        Learn how SarkariResultess.Com collects, uses and protects information.
    </p>

</div>


<div class="policy-wrapper">


    <!-- INTRODUCTION -->

    <div class="policy-card">

        <h2>1. Introduction</h2>

        <p>
            Welcome to
            <strong>
                <%= (site_setting && site_setting.site_title) || 'SarkariResultess.Com' %>
            </strong>.
        </p>

        <p>
            We respect your privacy and are committed to protecting the
            information that you provide while using our website. This
            Privacy Policy explains what information may be collected,
            how it may be used, and the choices available to you.
        </p>

        <p>
            This policy applies to visitors and users who access or interact
            with our website, its pages, forms, services and other online
            features.
        </p>

        <p class="policy-date">
            Last Updated:
            <%= new Date().toLocaleDateString('en-IN', {
                day: '2-digit',
                month: 'long',
                year: 'numeric'
            }) %>
        </p>

    </div>


    <!-- INFORMATION WE COLLECT -->

    <div class="policy-card">

        <h2>2. Information We May Collect</h2>

        <h3>Information You Provide</h3>

        <p>
            Depending on the features you use, we may receive information
            that you voluntarily provide, such as:
        </p>

        <ul>
            <li>Name</li>
            <li>Email address</li>
            <li>Phone number, if voluntarily submitted</li>
            <li>Messages or information submitted through contact forms</li>
            <li>Other information you choose to provide</li>
        </ul>


        <h3>Automatically Collected Information</h3>

        <p>
            When you visit the website, certain technical information may
            be collected automatically by our website, hosting provider,
            analytics tools or advertising services.
        </p>

        <ul>
            <li>IP address</li>
            <li>Browser type and version</li>
            <li>Device type</li>
            <li>Operating system</li>
            <li>Pages visited</li>
            <li>Approximate usage information</li>
            <li>Referring pages</li>
            <li>Date and time of access</li>
        </ul>

    </div>


    <!-- COOKIES -->

    <div class="policy-card">

        <h2>3. Cookies and Similar Technologies</h2>

        <p>
            SarkariResultess.Com may use cookies and similar technologies
            to improve website functionality, remember preferences,
            understand website usage and provide a better browsing
            experience.
        </p>

        <p>
            Cookies may also be used by third-party services such as
            analytics providers or advertising partners.
        </p>

        <p>
            You can control or disable cookies through your browser
            settings. However, disabling certain cookies may affect
            some website functionality.
        </p>

    </div>


    <!-- USE OF INFORMATION -->

    <div class="policy-card">

        <h2>4. How We Use Information</h2>

        <p>
            Information collected through the website may be used for
            legitimate website-related purposes, including:
        </p>

        <ul>
            <li>Providing and maintaining website functionality</li>

            <li>Responding to contact or support requests</li>

            <li>Improving website content and user experience</li>

            <li>Understanding website traffic and usage patterns</li>

            <li>Detecting technical problems or security issues</li>

            <li>Preventing abuse, spam or fraudulent activity</li>

            <li>Sending requested communications or updates</li>
        </ul>

    </div>


    <!-- ADVERTISING -->

    <div class="policy-card">

        <h2>5. Advertising and Third-Party Services</h2>

        <p>
            We may display advertisements through third-party advertising
            networks. These services may use cookies or similar technologies
            to provide relevant advertisements and measure advertising
            performance.
        </p>

        <p>
            Third-party advertising providers may collect information
            according to their own privacy policies. We do not control
            the data practices of independent third-party services.
        </p>

        <div class="policy-highlight">

            <strong>Important:</strong>

            <p>
                If advertisements are displayed on this website, the
                advertising provider may process information according to
                its own privacy policy and applicable settings.
            </p>

        </div>

    </div>


    <!-- ANALYTICS -->

    <div class="policy-card">

        <h2>6. Analytics</h2>

        <p>
            We may use analytics services to understand how visitors use
            the website. Analytics information can help us understand
            popular pages, traffic sources, device types and general
            website performance.
        </p>

        <p>
            Analytics providers may process information according to
            their respective privacy policies.
        </p>

    </div>


    <!-- EXTERNAL LINKS -->

    <div class="policy-card">

        <h2>7. External Links</h2>

        <p>
            Our website may contain links to external websites, including
            government websites, examination authorities, recruitment
            portals and other useful resources.
        </p>

        <p>
            Once you leave SarkariResultess.Com and visit an external
            website, that website's privacy policy and terms may apply.
            We are not responsible for the privacy practices, security or
            content of external websites.
        </p>

    </div>


    <!-- DATA SECURITY -->

    <div class="policy-card">

        <h2>8. Data Security</h2>

        <p>
            We take reasonable technical and organisational measures to
            protect information handled through our website against
            unauthorised access, misuse, alteration or disclosure.
        </p>

        <p>
            However, no internet transmission or online storage system
            can be guaranteed to be completely secure. Users should
            therefore avoid submitting unnecessary sensitive information
            through public forms or communications.
        </p>

    </div>


    <!-- DATA RETENTION -->

    <div class="policy-card">

        <h2>9. Data Retention</h2>

        <p>
            We retain information only for as long as reasonably necessary
            for the purpose for which it was collected, to provide our
            services, comply with applicable obligations, resolve disputes
            or protect our legitimate interests.
        </p>

    </div>


    <!-- USER RIGHTS -->

    <div class="policy-card">

        <h2>10. Your Privacy Choices</h2>

        <p>
            Depending on applicable law and the nature of the information,
            you may have rights or choices regarding your personal
            information.
        </p>

        <ul>
            <li>Request information about personal data we may hold</li>
            <li>Request correction of inaccurate information</li>
            <li>Request deletion where legally applicable</li>
            <li>Withdraw consent where processing is based on consent</li>
            <li>Control cookies through your browser settings</li>
        </ul>

        <p>
            To make a privacy-related request, please contact us using
            the contact information provided below.
        </p>

    </div>


    <!-- CHILDREN -->

    <div class="policy-card">

        <h2>11. Children's Privacy</h2>

        <p>
            Our website is intended for general audiences and government
            job and examination information. We do not knowingly request
            unnecessary personal information from children.
        </p>

        <p>
            If you believe that a child has provided personal information
            through our website without appropriate permission, please
            contact us so that the matter can be reviewed.
        </p>

    </div>


    <!-- CHANGES -->

    <div class="policy-card">

        <h2>12. Changes to This Privacy Policy</h2>

        <p>
            We may update this Privacy Policy from time to time to reflect
            changes in our website, services, technology, legal requirements
            or privacy practices.
        </p>

        <p>
            Any updated version will be published on this page with a
            revised "Last Updated" date.
        </p>

    </div>


    <!-- CONTACT -->

    <div class="policy-card">

        <h2>13. Contact Us</h2>

        <p>
            If you have questions, concerns or requests regarding this
            Privacy Policy, you can contact us using the details below.
        </p>

        <p>

            <% if (site_setting && site_setting.contact_email) { %>

                <strong>Email:</strong>
                <%= site_setting.contact_email %>

            <% } %>

            <% if (
                site_setting &&
                site_setting.contact_email &&
                site_setting.contact_phone
            ) { %>

                <br>

            <% } %>

            <% if (site_setting && site_setting.contact_phone) { %>

                <strong>Phone:</strong>
                <%= site_setting.contact_phone %>

            <% } %>

        </p>

        <% if (
            (!site_setting || !site_setting.contact_email) &&
            (!site_setting || !site_setting.contact_phone)
        ) { %>

            <p>
                Please visit our
                <a href="/contact">
                    Contact Us
                </a>
                page to get in touch with us.
            </p>

        <% } %>

    </div>


    <!-- FINAL NOTICE -->

    <div class="policy-card">

        <h2>14. Important Notice</h2>

        <div class="policy-highlight">

            <p>
                SarkariResultess.Com is an independent information website.
                Information published on the website is intended for general
                informational purposes. Users should verify important
                recruitment, examination, result, eligibility, fee and
                application information from the official source before
                taking any action.
            </p>

        </div>

    </div>


</div>


<%- include('../weblayout/layout-bottom') %>