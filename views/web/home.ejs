<!-- MARQUEE NEWS TICKER -->
<div class="news-marquee-wrapper">
  <% (marqueeRows || []).forEach(function(entry) { %>
    <% var categoryName = entry[0]; var items = entry[1]; %>
    <marquee behavior="alternate" onmouseover="this.stop()" onmouseout="this.start()" class="news-marquee">
      <% items.forEach(function(post, idx) { %>
        <a href="/post/<%= post.slug %>" target="_blank" style="color:<%= post.highlight_color || '#0033cc' %>;">
          <%= post.title %>
        </a>
        <% if (idx !== items.length - 1) { %>
          <span style="color:red; font-weight:bold;"> || </span>
        <% } %>
      <% }) %>
    </marquee>
  <% }) %>
</div>


<!-- BANNERS SECTION -->
<!-- BANNER CAROUSEL SECTION -->
<% if (typeof banners !== 'undefined' && banners && banners.length > 0) { %>
  <div class="banner-carousel-container">
    <div class="banner-carousel-track" id="bannerTrack">
      <% banners.forEach(function(banner) { %>
        <div class="banner-slide">
          <a href="<%= banner.url || '#' %>" target="_blank" class="banner-link">
            <% if (banner.image) { %>
              <img src="<%= banner.image %>" alt="<%= banner.text || 'Banner' %>" class="banner-img" />
            <% } else { %>
              <div class="banner-text-box" style="background-color: <%= banner.color || '#ab2828' %>;">
                <%= banner.text %>
              </div>
            <% } %>
          </a>
        </div>
      <% }); %>
    </div>
  </div>

  <style>
    .banner-carousel-container {
      max-width: 1000px;
      margin: 10px auto;
      overflow: hidden;
      position: relative;
      border-radius: 6px;
    }
    .banner-carousel-track {
      display: flex;
      transition: transform 0.5s ease-in-out;
    }
    .banner-slide {
      min-width: 100%;
      box-sizing: border-box;
    }
    .banner-link {
      display: block;
      text-decoration: none;
    }
    .banner-img {
      width: 100%;
      max-height: 250px;
      object-fit:scale-down;
      display: block;
      border-radius: 6px;
    }
    .banner-text-box {
      padding: 12px 20px;
      color: #ffffff;
      font-weight: bold;
      text-align: center;
      font-size: 15px;
      border-radius: 4px;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const track = document.getElementById('bannerTrack');
      const slides = track ? track.children : [];
      if (slides.length > 1) {
        let currentIndex = 0;
        setInterval(() => {
          currentIndex = (currentIndex + 1) % slides.length;
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
        }, 4000); // Har 4 second me slide switch hoga
      }
    });
  </script>
<% } %>


<!-- TOP BUTTON GRID (2 COLUMNS ON MOBILE) -->
<div class="top-boxes">
  <% (topPosts || []).forEach(function(post) { %>
    <a href="/post/<%= post.slug %>" target="_blank" class="top-box-item" style="background: <%= post.highlight_color || '#0033cc' %>">
      <%= post.title %>
    </a>
  <% }) %>
</div>

<!-- DYNAMIC HOME SECTIONS (2 COLUMNS ON MOBILE) -->
<div class="columns">
  <% (dynamicSections || []).forEach(function(sec) { %>
    <div class="col-box">
      <div>
        <div class="col-title <%= sec.colorClass || 't-red' %>">
          <%= sec.title %>
        </div>
        <div class="col-links">
          <% if (sec.posts && sec.posts.length) { %>
            <% sec.posts.forEach(function(item) { %>
  <a href="/post/<%= item.slug %>" target="_blank" class="post-link">
    &bull; <%= item.title %>

    <% 
      const postDate = item.post_date 
        ? new Date(item.post_date).toISOString().split('T')[0] 
        : '';
      
      const today = new Date().toISOString().split('T')[0];
    %>

    <% if (postDate === today) { %>
      <img src="/admin-assets/new.gif" class="new-post-gif" alt="NEW">
    <% } %>
  </a>
<% }) %>
          <% } else { %>
            <span style="font-size:11px; color:#666;">No posts available</span>
          <% } %>
        </div>
      </div>
      <div class="view-all-wrapper">
        <a href="/category/<%= sec.category ? sec.category.slug : '' %>" target="_blank" class="view-all-btn">View All &rarr;</a>
      </div>
    </div>
  <% }) %>
</div>

