<%
var pageStyles = `
.blog-page{ max-width:1280px; margin:0 auto 60px; padding:0 15px; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.blog-hero{ background:linear-gradient(120deg,#eef1fd,#f7f8fe); border-radius:20px; padding:50px 40px; margin:30px 0; }
.blog-hero .tag{ color:#0a58ca; font-weight:700; font-size:13px; letter-spacing:1px; }
.blog-hero h1{ font-size:38px; font-weight:800; margin:10px 0; color:#111; }
.blog-hero p{ color:#666; max-width:520px; font-size:15px; }

.blog-toolbar{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:15px; margin-bottom:25px; }
.filter-tabs{ display:flex; gap:8px; flex-wrap:wrap; }
.filter-tabs a{ padding:8px 16px; border-radius:20px; font-size:14px; font-weight:600; color:#333; text-decoration:none; background:#f1f2f6; }
.filter-tabs a.active{ background:#0a58ca; color:#fff; }
.sort-box select{ padding:8px 14px; border-radius:8px; border:1px solid #ddd; font-size:14px; }

.blog-layout{ display:grid; grid-template-columns:2.3fr 1fr; gap:30px; }

.blog-card{ display:grid; grid-template-columns:280px 1fr; gap:20px; background:#fff; border:1px solid #eee; border-radius:16px; overflow:hidden; margin-bottom:22px; text-decoration:none; color:inherit; transition:.2s; }
.blog-card:hover{ box-shadow:0 8px 24px rgba(0,0,0,.08); }
.blog-card .thumb{ position:relative; }
.blog-card .thumb img{ width:100%; height:100%; object-fit:cover; display:block; background:#ddd; }
.blog-card .cat-badge{ position:absolute; top:12px; left:12px; background:#0a58ca; color:#fff; font-size:12px; font-weight:600; padding:4px 12px; border-radius:20px; }
.blog-card .body{ padding:18px 18px 18px 0; display:flex; flex-direction:column; justify-content:center; }
.blog-card h2{ font-size:20px; font-weight:700; margin-bottom:8px; color:#111; }
.blog-card p{ color:#666; font-size:14px; line-height:1.6; margin-bottom:12px; }
.blog-card .meta{ font-size:13px; color:#888; display:flex; gap:14px; align-items:center; flex-wrap:wrap; }
.blog-card .read-more{ color:#0a58ca; font-weight:600; font-size:14px; margin-top:10px; display:inline-block; }
@media(max-width:767px){ .blog-card{ grid-template-columns:1fr; } .blog-card .thumb{ height:200px; } .blog-card .body{ padding:15px; } }

.pagination{ display:flex; justify-content:center; gap:8px; margin-top:20px; }
.pagination a, .pagination span{ width:36px; height:36px; display:flex; align-items:center; justify-content:center; border-radius:8px; border:1px solid #ddd; color:#333; text-decoration:none; font-size:14px; }
.pagination .active{ background:#0a58ca; color:#fff; border-color:#0a58ca; }

.sidebar-box{ background:#fafafa; border-radius:16px; padding:20px; margin-bottom:20px; }
.sidebar-box h3{ font-size:18px; margin-bottom:15px; color:#111; }
.search-box{ display:flex; }
.search-box input{ flex:1; padding:10px 12px; border:1px solid #ddd; border-radius:8px 0 0 8px; font-size:14px; }
.search-box button{ background:#0a58ca; border:none; color:#fff; padding:0 16px; border-radius:0 8px 8px 0; cursor:pointer; }
.cat-list a{ display:flex; justify-content:space-between; padding:8px 0; color:#333; text-decoration:none; font-size:14px; border-bottom:1px solid #eee; }
.cat-list a.active{ color:#0a58ca; font-weight:700; }
.cat-list span.count{ background:#eef1fd; color:#0a58ca; font-size:12px; padding:2px 8px; border-radius:10px; }
.popular-item{ display:flex; gap:10px; margin-bottom:14px; text-decoration:none; color:inherit; }
.popular-item img{ width:64px; height:56px; object-fit:cover; border-radius:8px; background:#ddd; }
.popular-item h4{ font-size:14px; font-weight:600; margin-bottom:4px; }
.popular-item span{ font-size:12px; color:#888; }
.newsletter-box{ background:#0a58ca; color:#fff; border-radius:16px; padding:20px; }
.newsletter-box h3{ color:#fff; }
.newsletter-box p{ font-size:13px; opacity:.9; margin-bottom:12px; }
.newsletter-box input{ width:100%; padding:10px; border-radius:8px; border:none; margin-bottom:10px; }
.newsletter-box button{ width:100%; padding:10px; border-radius:8px; border:none; background:#fff; color:#0a58ca; font-weight:700; cursor:pointer; }
.no-results{ padding:40px; text-align:center; color:#888; }
@media(max-width:991px){ .blog-layout{ grid-template-columns:1fr; } }
`;
function thumb(b) { return b.thumbnail ? '' + b.thumbnail : '/images/placeholder.svg'; }
function qs(params) {
  var url = new URLSearchParams();
  Object.keys(params).forEach(function(k){ if (params[k]) url.set(k, params[k]); });
  var str = url.toString();
  return str ? '?' + str : '';
}
%>
<%- include('../weblayout/layout-top', { title: title, pageStyles: pageStyles }) %>

<div class="blog-page">
  <div class="blog-hero">
    <div class="tag">BLOG</div>
    <h1>Our Latest Articles</h1>
    <p>Explore our latest insights, tips and trends on education, learning strategies, and personal growth.</p>
  </div>

  <div class="blog-layout">
    <div class="blog-main">
      <div class="blog-toolbar">
        <div class="filter-tabs">
          <a href="/blog<%= qs({ sort: sort, q: search }) %>" class="<%= !activeCategory ? 'active' : '' %>">All Posts</a>
          <% categories.forEach(function(c) { %>
            <a href="/blog<%= qs({ category: c.slug, sort: sort, q: search }) %>" class="<%= activeCategory === c.slug ? 'active' : '' %>"><%= c.name %></a>
          <% }) %>
        </div>
        <div class="sort-box">
          <form method="GET" action="/blog" id="sortForm">
            <% if (activeCategory) { %><input type="hidden" name="category" value="<%= activeCategory %>"><% } %>
            <% if (search) { %><input type="hidden" name="q" value="<%= search %>"><% } %>
            <select name="sort" onchange="document.getElementById('sortForm').submit()">
              <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Latest</option>
              <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
            </select>
          </form>
        </div>
      </div>

      <% if (blogs && blogs.length) { %>
        <% blogs.forEach(function(blog) { %>
          <a href="/blog/<%= blog.slug %>" class="blog-card">
            <div class="thumb">
              <span class="cat-badge"><%= blog.BlogCategory ? blog.BlogCategory.name : 'General' %></span>
              <img src="<%= thumb(blog) %>" alt="<%= blog.title %>">
            </div>
            <div class="body">
              <h2><%= blog.title %></h2>
              <p><%= blog.short_description %></p>
              <div class="meta">
                <span>&#128197; <%= blog.published_at ? formatDate(blog.published_at, 'DD MMM YYYY') : '' %></span>
                <span>&#8226;</span>
                <span>&#128340; <%= blog.read_time || 1 %> min read</span>
                <span>&#8226;</span>
                <span>&#128172; <%= blog.comments_count || 0 %> Comments</span>
              </div>
              <span class="read-more">Read More &rarr;</span>
            </div>
          </a>
        <% }) %>

        <% if (totalPages > 1) { %>
          <div class="pagination">
            <a href="/blog<%= qs({ category: activeCategory, sort: sort, q: search, page: Math.max(1, currentPage - 1) }) %>">&lsaquo;</a>
            <% for (var p = 1; p <= totalPages; p++) { %>
              <a href="/blog<%= qs({ category: activeCategory, sort: sort, q: search, page: p }) %>" class="<%= p === currentPage ? 'active' : '' %>"><%= p %></a>
            <% } %>
            <a href="/blog<%= qs({ category: activeCategory, sort: sort, q: search, page: Math.min(totalPages, currentPage + 1) }) %>">&rsaquo;</a>
          </div>
        <% } %>
      <% } else { %>
        <div class="no-results">No blogs found.</div>
      <% } %>
    </div>

    <aside class="blog-sidebar">
      <div class="sidebar-box">
        <h3>Search Articles</h3>
        <form class="search-box" method="GET" action="/blog">
          <input type="text" name="q" placeholder="Search articles..." value="<%= search || '' %>">
          <button type="submit">&#128269;</button>
        </form>
      </div>

      <div class="sidebar-box">
        <h3>Categories</h3>
        <div class="cat-list">
          <% categories.forEach(function(c) { %>
            <a href="/blog?category=<%= c.slug %>" class="<%= activeCategory === c.slug ? 'active' : '' %>">
              <%= c.name %> <span class="count"><%= c.count %></span>
            </a>
          <% }) %>
        </div>
      </div>

      <div class="sidebar-box">
        <h3>Popular Posts</h3>
        <% (popularBlogs || []).forEach(function(pb) { %>
          <a href="/blog/<%= pb.slug %>" class="popular-item">
            <img src="<%= thumb(pb) %>" alt="<%= pb.title %>">
            <div>
              <h4><%= pb.title %></h4>
              <span><%= pb.published_at ? formatDate(pb.published_at, 'DD MMM YYYY') : '' %></span>
            </div>
          </a>
        <% }) %>
      </div>

      <div class="newsletter-box">
        <h3>Newsletter</h3>
        <p>Get the latest updates and articles straight to your inbox.</p>
        <form method="POST" action="/newsletter/subscribe">
          <input type="email" name="email" placeholder="Enter your email" required>
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </aside>
  </div>
</div>

<%- include('../weblayout/layout-bottom') %>