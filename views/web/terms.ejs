<%
var pageStyles = `
.page-header { text-align: center; margin: 40px 0 20px; }
.page-header h1 { font-size: 32px; color: #c00; font-weight: 800; }
.page-header .subtitle { font-size: 15px; color: #666; }
.terms-container { max-width: 960px; margin: 0 auto 60px; padding: 0 15px; }
.terms-card { background: #fff; border-radius: 10px; padding: 26px; border: 1px solid #ececec; box-shadow: 0 6px 20px rgba(0,0,0,0.03); }
.meta { color: #666; font-size: 14px; margin-bottom: 18px; }
.terms-card h2 { color: #1b1b1b; font-size: 18px; margin-top: 18px; margin-bottom: 10px; font-weight: 700; }
.terms-card p { color: #444; font-size: 15px; line-height: 1.7; margin-bottom: 8px; }
.terms-card ul { margin-left: 18px; margin-bottom: 12px; }
.terms-card li { margin-bottom: 6px; color: #444; }
.contact-block a { color: #0b63c4; text-decoration: none; }
.contact-block a:hover { text-decoration: underline; }
.terms-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 22px; }
.btn-back { background: #f2f2f2; color: #222; padding: 8px 14px; border-radius: 6px; text-decoration: none; border: 1px solid #e0e0e0; }
.btn-back:hover { background: #e9e9e9; }
.muted { color: #888; font-size: 13px; }
@media print { .btn-back, .page-header .subtitle { display: none; } .terms-card { box-shadow: none; border: none; } }
@media (max-width: 640px) { .terms-card { padding: 18px; } .terms-footer { flex-direction: column; gap: 12px; align-items: flex-start; } }
`;
%>
<%- include('../weblayout/layout-top', { title: title, pageStyles: pageStyles }) %>

<div class="page-header">
  <h1>Terms & Conditions</h1>
  <p class="subtitle">Please read these terms carefully before using our website.</p>
</div>

<div class="terms-container">
