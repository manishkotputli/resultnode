        <!-- =================================================
             18. CONTACT US
             ================================================= -->

        <h2>18. Contact Us</h2>

        <p>
            If you have questions, concerns or suggestions regarding
            these Terms & Conditions, please contact us using the
            details below.
        </p>

        <div class="contact-box">

            <% if (site_setting && site_setting.contact_email) { %>

                <p class="contact-block">
                    <strong>Email:</strong>
                    <a href="mailto:<%= site_setting.contact_email %>">
                        <%= site_setting.contact_email %>
                    </a>
                </p>

            <% } %>


            <% if (site_setting && site_setting.contact_phone) { %>

                <p class="contact-block">
                    <strong>Phone:</strong>
                    <%= site_setting.contact_phone %>
                </p>

            <% } %>


            <% if (
                (!site_setting || !site_setting.contact_email) &&
                (!site_setting || !site_setting.contact_phone)
            ) { %>

                <p>
                    Please visit our
                    <a href="/contact">
                        Contact Us
                    </a>
