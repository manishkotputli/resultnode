
<%
var pageStyles = `
/* =========================================================
   TERMS & CONDITIONS
   SEO + READABILITY + MOBILE FRIENDLY
   ========================================================= */

.page-header {
    text-align: center;
    margin: 42px auto 24px;
    padding: 0 15px;
    max-width: 900px;
}

.page-header h1 {
    font-size: 34px;
    line-height: 1.25;
    color: #b31335;
    font-weight: 800;
    margin: 0 0 10px;
}

.page-header .subtitle {
    font-size: 15px;
    line-height: 1.7;
    color: #666;
    margin: 0 auto;
    max-width: 760px;
}

.terms-container {
    max-width: 900px;
    margin: 0 auto 70px;
    padding: 0 15px;
}

.terms-card {
    background: #fff;
    border-radius: 10px;
    padding: 26px 28px;
    border: 1px solid #e9e9e9;
    box-shadow: 0 5px 18px rgba(0,0,0,0.035);
}

.meta {
    color: #666;
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 20px;
}

.terms-card h2 {
    color: #1b1b1b;
    font-size: 20px;
    line-height: 1.4;
    margin: 25px 0 11px;
    font-weight: 750;
}

.terms-card h2:first-of-type {
    margin-top: 8px;
}

.terms-card p {
    color: #444;
    font-size: 15px;
    line-height: 1.75;
    margin: 0 0 12px;
}

.terms-card p:last-child {
    margin-bottom: 0;
}

.terms-card ul,
.terms-card ol {
    margin: 8px 0 15px 21px;
    padding-left: 5px;
}

.terms-card li {
    margin-bottom: 6px;
    color: #444;
    font-size: 15px;
    line-height: 1.7;
}

.terms-card a {
    color: #0b63c4;
    text-decoration: none;
    font-weight: 600;
}

.terms-card a:hover {
    text-decoration: underline;
    color: #b31335;
}

.terms-highlight {
    background: #fff8f8;
    border-left: 4px solid #b31335;
    padding: 14px 16px;
    margin: 16px 0;
    border-radius: 4px;
}

.terms-highlight p {
    margin: 0;
}

.contact-block {
    line-height: 1.8 !important;
}

.contact-box {
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 14px 16px;
}

.terms-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid #eee;
    gap: 15px;
}

.btn-back {
    background: #f2f2f2;
    color: #222 !important;
    padding: 8px 14px;
    border-radius: 6px;
    text-decoration: none !important;
    border: 1px solid #e0e0e0;
    font-weight: 600;
}

.btn-back:hover {
    background: #e9e9e9;
    color: #b31335 !important;
}

.muted {
    color: #888;
    font-size: 13px;
    line-height: 1.6;
}

@media print {

    .btn-back,
    .page-header .subtitle {
        display: none;
    }

    .terms-card {
        box-shadow: none;
        border: none;
    }

}

@media (max-width: 640px) {

    .page-header {
        margin: 28px auto 18px;
        padding: 0 12px;
    }

    .page-header h1 {
        font-size: 28px;
    }

    .page-header .subtitle {
        font-size: 14px;
        line-height: 1.65;
    }

    .terms-container {
        padding: 0 10px;
        margin-bottom: 45px;
    }

    .terms-card {
        padding: 19px 16px;
        border-radius: 8px;
    }

    .terms-card h2 {
        font-size: 18px;
    }

    .terms-card p,
    .terms-card li {
        font-size: 14px;
        line-height: 1.7;
    }

    .terms-card ul,
    .terms-card ol {
        margin-left: 19px;
    }

    .terms-footer {
        flex-direction: column;
        align-items: flex-start;
    }

}
`;
%>

<%- include('../weblayout/layout-top', {
    title: title || 'Terms & Conditions - SarkariResultess.Com',
    pageStyles: pageStyles
}) %>


<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<header class="page-header">

    <h1>Terms & Conditions</h1>

    <p class="subtitle">
        Please read these Terms & Conditions carefully before using
        SarkariResultess.Com.
