<%
var pageStyles = `
.auth-wrapper { max-width: 420px; margin: 50px auto; padding: 0 15px; }
.auth-card { background: #fff; padding: 28px; border: 1px solid #eee; border-radius: 12px; box-shadow: 0px 3px 12px rgba(0,0,0,0.05); }
.auth-card h1 { text-align: center; color: #c00; font-size: 24px; margin-bottom: 6px; }
.auth-card p.sub { text-align: center; color: #666; font-size: 14px; margin-bottom: 20px; }
.auth-card label { font-size: 14px; font-weight: 600; color: #333; }
.auth-card input { width: 100%; box-sizing: border-box; border: 1px solid #ccc; border-radius: 8px; padding: 11px; font-size: 15px; margin: 6px 0 14px; background: #fafafa; }
.auth-card button { width: 100%; background: #c00; color: #fff; padding: 12px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; }
.auth-card button:hover { background: #900; }
.auth-switch { text-align: center; margin-top: 16px; font-size: 14px; color: #555; }
.auth-switch a { color: #0077cc; text-decoration: none; font-weight: 600; }
`;
%>
<%- include('../../weblayout/layout-top', { title: title, pageStyles: pageStyles }) %>

<div class="auth-wrapper">
  <div class="auth-card">
    <h1>Welcome Back</h1>
    <p class="sub">Login to access your courses & test series</p>
    <form method="POST" action="/login">
      <label>Email</label>
      <input type="email" name="email" required>
      <label>Password</label>
      <input type="password" name="password" required>
      <button type="submit">Login</button>
    </form>
    <div class="auth-switch">New here? <a href="/register">Create an account</a></div>
  </div>
</div>

<%- include('../../weblayout/layout-bottom') %>
