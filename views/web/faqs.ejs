<%
var pageStyles = `
.page-header { text-align: center; margin: 40px 0 20px; }
.page-header h1 { font-size: 32px; color: #c00; font-weight: 800; }
.page-header .subtitle { font-size: 15px; color: #666; }
.faq-container { max-width: 900px; margin: 0 auto 60px; padding: 0 15px; }
.faq-intro p { font-size: 16px; text-align: center; color: #444; }
.faq-item { background: #fff; border: 1px solid #eee; border-radius: 12px; margin-bottom: 15px; box-shadow: 0px 3px 12px rgba(0,0,0,0.05); overflow: hidden; }
.faq-question { width: 100%; background: #f8f8f8; border: none; padding: 16px 20px; font-size: 17px; font-weight: 600; color: #111; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: .25s; }
.faq-question:hover { background: #f2f2f2; }
.arrow { transition: transform .3s; }
.faq-item.active .arrow { transform: rotate(180deg); }
.faq-answer { display: none; padding: 20px 20px 5px; }
.faq-item.active .faq-answer { display: block; }
.faq-step { display: flex; gap: 15px; margin-bottom: 25px; position: relative; }
.faq-step:before { content: ""; position: absolute; left: 14px; top: 35px; width: 2px; height: calc(100% - 40px); background: #ddd; }
.step-bullet { width: 28px; height: 28px; border-radius: 50%; background: #c00; color: #fff; text-align: center; line-height: 28px; font-weight: 700; z-index: 2; }
.step-content { background: #fafafa; padding: 12px 18px; border-radius: 10px; border: 1px solid #eee; width: 100%; }
.step-title { font-size: 17px; color: #c00; font-weight: 700; margin-bottom: 6px; }
.step-text { font-size: 15px; color: #333; }
.faq-img-box img { margin-top: 12px; width: 100%; border-radius: 10px; border: 1px solid #ddd; }
`;
var pageScripts = `
document.querySelectorAll(".faq-question").forEach(function(btn){
  btn.addEventListener("click", function(){ btn.parentElement.classList.toggle("active"); });
});
`;
%>
<%- include('../weblayout/layout-top', { title: title, pageStyles: pageStyles }) %>

<div class="page-header">
  <h1>Frequently Asked Questions (FAQ)</h1>
  <p class="subtitle">Find answers to commonly asked questions</p>
</div>

<div class="faq-container">
  <div class="faq-intro">
    <p>Below is a list of helpful FAQs asked by candidates, students & job seekers. Each question includes multiple steps, solutions, and optional images.</p>
  </div>

  <div class="faq-list">
    <% if (faqs && faqs.length) { %>
      <% faqs.forEach(function(faq) { %>
        <div class="faq-item">
          <button class="faq-question">
            <span>&#128204; <%= faq.question %></span>
            <i class="ti ti-chevron-down arrow"></i>
          </button>
          <div class="faq-answer">
            <% (faq.answers || []).forEach(function(ans, index) { %>
              <div class="faq-step">
                <div class="step-bullet"><span><%= index + 1 %></span></div>
                <div class="step-content">
                  <h4 class="step-title">Step <%= index + 1 %></h4>
                  <p class="step-text"><%- (ans.answer || '').replace(/\n/g, '<br>') %></p>
                  <% if (ans.image) { %>
                    <div class="faq-img-box"><img src="/uploads/faq/<%= ans.image %>" alt="FAQ Image"></div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-center">No FAQs added yet.</p>
    <% } %>
  </div>
</div>

<%- include('../weblayout/layout-bottom', { pageScripts: pageScripts }) %>
