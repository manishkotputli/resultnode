<%
var pageStyles = `
/* =========================================================
   SARKARIRESULTESS.COM - PREMIUM ABOUT PAGE
   ========================================================= */

:root {
    --sr-red: #b91c1c;
    --sr-red-dark: #991b1b;
    --sr-red-light: #fef2f2;
    --sr-red-soft: #fff7f7;

    --sr-navy: #0f172a;
    --sr-navy-light: #1e293b;

    --sr-text: #334155;
    --sr-muted: #64748b;

    --sr-bg: #f8fafc;
    --sr-white: #ffffff;

    --sr-border: #e2e8f0;

    --sr-green: #15803d;
    --sr-blue: #2563eb;

    --sr-radius: 16px;
    --sr-radius-sm: 10px;

    --sr-shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
    --sr-shadow-md: 0 8px 28px rgba(15, 23, 42, 0.07);
    --sr-shadow-lg: 0 18px 45px rgba(15, 23, 42, 0.10);

    --sr-transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}


/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.sr-about-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 22px 70px;
    box-sizing: border-box;
}


/* =========================================================
   HERO
   ========================================================= */

.sr-about-hero {
    position: relative;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 90% 20%,
            rgba(185, 28, 28, 0.08),
            transparent 32%
        ),
        linear-gradient(
            135deg,
            #ffffff 0%,
            #fffafa 48%,
            #f8fafc 100%
        );

    border-bottom: 1px solid #f1f5f9;
}

.sr-about-hero::before {
    content: "";

    position: absolute;

    width: 260px;
    height: 260px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(185, 28, 28, 0.08),
            transparent 68%
        );

    right: -80px;
    top: -100px;

    pointer-events: none;
}


.sr-about-hero-inner {
    max-width: 1180px;
    min-height: 370px;

    margin: 0 auto;
    padding: 58px 22px;

    display: grid;

    grid-template-columns:
        minmax(0, 1.15fr)
        minmax(300px, 0.85fr);

    align-items: center;

    gap: 50px;

    box-sizing: border-box;
    position: relative;
    z-index: 1;
}


/* =========================================================
   HERO CONTENT
   ========================================================= */

.sr-about-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 7px 14px;

    border-radius: 50px;

    background: var(--sr-red-light);
    color: var(--sr-red);

    border: 1px solid #fecaca;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 0.07em;
    text-transform: uppercase;

    margin-bottom: 16px;
}


.sr-about-hero h1 {
    margin: 0 0 14px;

    color: var(--sr-navy);

    font-size: 43px;
    line-height: 1.12;

    font-weight: 850;
    letter-spacing: -0.035em;
}


.sr-about-hero h1 span {
    color: var(--sr-red);
}


.sr-about-hero-lead {
    max-width: 680px;

    margin: 0 0 23px;

    color: var(--sr-muted);

    font-size: 16px;
    line-height: 1.75;
}


.sr-about-buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}


.sr-about-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 44px;

    padding: 0 18px;

    border-radius: 9px;

    text-decoration: none !important;

    font-size: 14px;
    font-weight: 800;

    transition: var(--sr-transition);
    box-sizing: border-box;
}


.sr-about-btn-primary {
    background: var(--sr-red);
    color: #ffffff !important;

    box-shadow:
        0 7px 18px rgba(185, 28, 28, 0.18);
}


.sr-about-btn-primary:hover {
    background: var(--sr-red-dark);

    transform: translateY(-2px);

    box-shadow:
        0 11px 24px rgba(185, 28, 28, 0.24);
}


.sr-about-btn-outline {
    background: #ffffff;

    color: var(--sr-navy) !important;

    border: 1px solid var(--sr-border);
}


.sr-about-btn-outline:hover {
    border-color: #fecaca;

    color: var(--sr-red) !important;

    transform: translateY(-2px);
}


/* =========================================================
   HERO VISUAL
   ========================================================= */

.sr-about-visual {
    display: flex;
    justify-content: center;
    align-items: center;
}


.sr-visual-card {
    width: min(100%, 390px);

    background: rgba(255, 255, 255, 0.92);

    border: 1px solid #e5e7eb;

    border-radius: 22px;

    padding: 24px;

    box-shadow: var(--sr-shadow-lg);

    position: relative;
    overflow: hidden;
}


.sr-visual-card::before {
    content: "";

    position: absolute;

    width: 150px;
    height: 150px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(185, 28, 28, 0.12),
            transparent 70%
        );

    right: -50px;
    top: -50px;
}


.sr-visual-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 22px;
}


.sr-visual-logo {
    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: var(--sr-red-light);
    color: var(--sr-red);

    font-size: 21px;
    font-weight: 900;
}


.sr-visual-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    font-size: 11px;
    font-weight: 800;

    color: var(--sr-green);

    background: #f0fdf4;

    border: 1px solid #bbf7d0;

    padding: 6px 10px;

    border-radius: 50px;
}


.sr-status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--sr-green);
}


.sr-visual-title {
    color: var(--sr-navy);

    font-size: 20px;
    font-weight: 850;

    margin-bottom: 7px;
}


.sr-visual-description {
    color: var(--sr-muted);

    font-size: 13px;
    line-height: 1.65;

    margin-bottom: 20px;
}


.sr-visual-lines {
    display: flex;
    flex-direction: column;
    gap: 9px;
}


.sr-visual-line {
    height: 10px;

    border-radius: 50px;

    background: #f1f5f9;

    overflow: hidden;
}


.sr-visual-line span {
    display: block;

    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            #fecaca,
            #b91c1c
        );
}


.sr-visual-line:nth-child(1) span {
    width: 84%;
}

.sr-visual-line:nth-child(2) span {
    width: 68%;
}

.sr-visual-line:nth-child(3) span {
    width: 92%;
}


/* =========================================================
   COMMON SECTIONS
   ========================================================= */

.sr-about-section {
    margin-top: 54px;
}


.sr-section-heading {
    text-align: center;
    margin-bottom: 28px;
}


.sr-section-heading h2 {
    margin: 0 0 8px;

    color: var(--sr-navy);

    font-size: 28px;
    font-weight: 850;

    letter-spacing: -0.025em;
}


.sr-section-heading p {
    max-width: 700px;

    margin: 0 auto;

    color: var(--sr-muted);

    font-size: 14px;
    line-height: 1.7;
}


/* =========================================================
   ABOUT GRID
   ========================================================= */

.sr-about-grid {
    display: grid;

    grid-template-columns:
        minmax(0, 1.35fr)
        minmax(300px, 0.65fr);

    gap: 24px;
}


.sr-about-card {
    background: #ffffff;

    border: 1px solid var(--sr-border);

    border-radius: var(--sr-radius);

    padding: 29px;

    box-shadow: var(--sr-shadow-md);

    box-sizing: border-box;
}


.sr-about-card h2 {
    margin: 0 0 13px;

    color: var(--sr-navy);

    font-size: 21px;
    font-weight: 850;
}


.sr-about-card h3 {
    margin: 25px 0 7px;

    color: var(--sr-navy);

    font-size: 16px;
    font-weight: 800;
}


.sr-about-card p {
    margin: 0;

    color: var(--sr-text);

    font-size: 14px;

    line-height: 1.8;
}


.sr-about-card p + p {
    margin-top: 10px;
}


/* =========================================================
   HIGHLIGHT CARD
   ========================================================= */

.sr-about-highlight {
    position: relative;

    background:
        linear-gradient(
            145deg,
            #fff7f7 0%,
            #ffffff 65%
        );

    border: 1px solid #fecaca;

    border-radius: var(--sr-radius);

    padding: 28px;

    box-shadow: var(--sr-shadow-md);

    overflow: hidden;
}


.sr-about-highlight::after {
    content: "";

    position: absolute;

    width: 130px;
    height: 130px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(185, 28, 28, 0.10),
            transparent 70%
        );

    right: -55px;
    bottom: -55px;
}


.sr-highlight-icon {
    width: 46px;
    height: 46px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: var(--sr-red);
    color: #ffffff;

    font-size: 20px;

    margin-bottom: 17px;

    box-shadow:
        0 8px 18px rgba(185, 28, 28, 0.18);
}


.sr-about-highlight h3 {
    margin: 0 0 8px;

    color: var(--sr-navy);

    font-size: 18px;
    font-weight: 850;
}


.sr-about-highlight p {
    margin: 0;

    color: var(--sr-muted);

    font-size: 13.5px;
    line-height: 1.7;

    position: relative;
    z-index: 2;
}


/* =========================================================
   PRINCIPLES
   ========================================================= */

.sr-principles-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;
}


.sr-principle {
    background: #ffffff;

    border: 1px solid var(--sr-border);

    border-radius: 14px;

    padding: 21px 18px;

    box-shadow: var(--sr-shadow-sm);

    transition: var(--sr-transition);

    position: relative;
    overflow: hidden;
}


.sr-principle:hover {
    transform: translateY(-5px);

    border-color: #fecaca;

    box-shadow: var(--sr-shadow-md);
}


.sr-principle-icon {
    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: var(--sr-red-light);
    color: var(--sr-red);

    font-size: 18px;

    margin-bottom: 14px;
}


.sr-principle h3 {
    margin: 0 0 7px;

    color: var(--sr-navy);

    font-size: 15px;
    font-weight: 850;
}


.sr-principle p {
    margin: 0;

    color: var(--sr-muted);

    font-size: 12.5px;
    line-height: 1.65;
}


/* =========================================================
   CATEGORIES
   ========================================================= */

.sr-category-section {
    margin-top: 54px;
}


.sr-category-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 17px;
}


.sr-category-card {
    display: flex;

    align-items: flex-start;

    gap: 13px;

    background: #ffffff;

    border: 1px solid var(--sr-border);

    border-radius: 13px;

    padding: 19px;

    box-shadow: var(--sr-shadow-sm);

    transition: var(--sr-transition);
}


.sr-category-card:hover {
    transform: translateY(-4px);

    border-color: #fecaca;

    box-shadow: var(--sr-shadow-md);
}


.sr-category-icon {
    width: 40px;
    height: 40px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--sr-red-light);
    color: var(--sr-red);

    font-size: 17px;
}


.sr-category-card h3 {
    margin: 0 0 5px;

    color: var(--sr-navy);

    font-size: 14px;
    font-weight: 850;
}


.sr-category-card p {
    margin: 0;

    color: var(--sr-muted);

    font-size: 12.5px;
    line-height: 1.6;
}


/* =========================================================
   APPROACH
   ========================================================= */

.sr-approach {
    margin-top: 54px;

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 18px;
}


.sr-approach-card {
    background: #ffffff;

    border: 1px solid var(--sr-border);

    border-radius: 14px;

    padding: 23px;

    box-shadow: var(--sr-shadow-sm);

    position: relative;
}


.sr-approach-number {
    font-size: 34px;

    line-height: 1;

    font-weight: 900;

    color: #fee2e2;

    margin-bottom: 12px;
}


.sr-approach-card h3 {
    margin: 0 0 7px;

    color: var(--sr-navy);

    font-size: 16px;
    font-weight: 850;
}


.sr-approach-card p {
    margin: 0;

    color: var(--sr-muted);

    font-size: 13px;
    line-height: 1.7;
}


/* =========================================================
   MANISH PRAJAPATI NOTE
   ========================================================= */

.sr-founder-note {
    margin-top: 54px;

    background:
        linear-gradient(
            135deg,
            #0f172a 0%,
            #1e293b 100%
        );

    border-radius: 20px;

    padding: 32px;

    color: #ffffff;

    position: relative;
    overflow: hidden;

    box-shadow:
        0 18px 40px rgba(15, 23, 42, 0.14);
}


.sr-founder-note::after {
    content: "";

    position: absolute;

    width: 220px;
    height: 220px;

    border-radius: 50%;

    right: -80px;
    top: -100px;

    background:
        radial-gradient(
            circle,
            rgba(248, 113, 113, 0.22),
            transparent 70%
        );
}


.sr-founder-label {
    display: inline-block;

    color: #fca5a5;

    font-size: 10px;

    font-weight: 850;

    text-transform: uppercase;

    letter-spacing: 0.1em;

    margin-bottom: 10px;
}


.sr-founder-note h2 {
    margin: 0 0 10px;

    font-size: 23px;

    font-weight: 850;

    color: #ffffff;
}


.sr-founder-note p {
    max-width: 820px;

    margin: 0;

    color: #cbd5e1;

    font-size: 14px;
    line-height: 1.8;

    position: relative;
    z-index: 2;
}


.sr-founder-name {
    margin-top: 17px;

    color: #ffffff;

    font-size: 14px;
    font-weight: 800;

    position: relative;
    z-index: 2;
}


.sr-founder-name span {
    color: #fca5a5;
    font-weight: 600;
}


/* =========================================================
   NOTICE
   ========================================================= */

.sr-about-notice {
    margin-top: 25px;

    padding: 17px 19px;

    background: var(--sr-red-light);

    border: 1px dashed #fecaca;

    border-radius: 11px;

    color: var(--sr-text);

    font-size: 13px;
    line-height: 1.7;
}


.sr-about-notice strong {
    color: var(--sr-red);
}


/* =========================================================
   POLICY LINKS
   ========================================================= */

.sr-policy-links {
    margin-top: 30px;

    display: flex;

    justify-content: center;
    align-items: center;

    flex-wrap: wrap;

    gap: 8px 18px;
}


.sr-policy-links a {
    color: var(--sr-muted);

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;

    transition: color 0.2s ease;
}


.sr-policy-links a:hover {
    color: var(--sr-red);
}


/* =========================================================
   FINAL CTA
   ========================================================= */

.sr-about-final-cta {
    margin-top: 50px;

    text-align: center;

    padding: 34px 20px;

    background:
        linear-gradient(
            135deg,
            #fff7f7,
            #ffffff
        );

    border: 1px solid #fecaca;

    border-radius: 18px;
}


.sr-about-final-cta h2 {
    margin: 0 0 8px;

    color: var(--sr-navy);

    font-size: 24px;
    font-weight: 850;
}


.sr-about-final-cta p {
    margin: 0 auto 18px;

    max-width: 650px;

    color: var(--sr-muted);

    font-size: 14px;
    line-height: 1.7;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

    .sr-about-hero-inner {
        grid-template-columns: 1fr;
        gap: 30px;

        padding-top: 48px;
        padding-bottom: 48px;
    }

    .sr-about-visual {
        justify-content: flex-start;
    }

    .sr-about-grid {
        grid-template-columns: 1fr;
    }

    .sr-principles-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sr-category-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}


@media (max-width: 720px) {

    .sr-about-container {
        padding-left: 15px;
        padding-right: 15px;
    }

    .sr-about-hero-inner {
        padding-left: 15px;
        padding-right: 15px;
    }

    .sr-about-hero h1 {
        font-size: 34px;
    }

    .sr-approach {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 560px) {

    .sr-about-hero-inner {
        min-height: auto;

        padding-top: 35px;
        padding-bottom: 38px;
    }

    .sr-about-hero h1 {
        font-size: 29px;
    }

    .sr-about-hero-lead {
        font-size: 14px;
    }

    .sr-about-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .sr-about-btn {
        width: 100%;
    }

    .sr-visual-card {
        padding: 20px;
    }

    .sr-about-card,
    .sr-about-highlight {
        padding: 22px;
    }

    .sr-section-heading h2 {
        font-size: 24px;
    }

    .sr-principles-grid,
    .sr-category-grid {
        grid-template-columns: 1fr;
    }

    .sr-founder-note {
        padding: 25px 21px;
        border-radius: 16px;
    }

    .sr-founder-note h2 {
        font-size: 21px;
    }

    .sr-policy-links {
        flex-direction: column;
        gap: 10px;
    }

}
`;
%>


<%- include("../weblayout/layout-top", {
    title: title || "About Us - SarkariResultess.Com",
    pageStyles: pageStyles
}) %>


<section class="sr-about-hero">

    <div class="sr-about-hero-inner">

        <div>

            <span class="sr-about-badge">
                ✓ About SarkariResultess.Com
            </span>

            <h1>
                About
                <span>
                    <%= (site_setting && site_setting.site_title) || "SarkariResultess.Com" %>
                </span>
            </h1>

            <p class="sr-about-hero-lead">
                SarkariResultess.Com is an independent informational
                platform created to make government job, examination,
                result, admit card, answer key, admission and other
                important educational updates easier to discover and
                understand.
            </p>

            <div class="sr-about-buttons">

                <a
                    href="/"
                    class="sr-about-btn sr-about-btn-primary"
                >
                    Explore Latest Updates
                </a>

                <a
                    href="/contact"
                    class="sr-about-btn sr-about-btn-outline"
                >
                    Contact Us
                </a>

            </div>

        </div>


        <div class="sr-about-visual">

            <div class="sr-visual-card">

                <div class="sr-visual-top">

                    <div class="sr-visual-logo">
                        SR
                    </div>

                    <div class="sr-visual-status">

                        <span class="sr-status-dot"></span>

                        Information Portal

                    </div>

                </div>

                <div class="sr-visual-title">
                    Government Exam Information
                </div>

                <div class="sr-visual-description">
                    A simple platform for finding important recruitment,
                    examination and educational updates in one place.
                </div>

                <div class="sr-visual-lines">

                    <div class="sr-visual-line">
                        <span></span>
                    </div>

                    <div class="sr-visual-line">
                        <span></span>
                    </div>

                    <div class="sr-visual-line">
                        <span></span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<div class="sr-about-container">


    <section class="sr-about-section">

        <div class="sr-about-grid">

            <article class="sr-about-card">

                <h2>Who We Are</h2>

                <p>
                    <%= (site_setting && site_setting.site_title) || "SarkariResultess.Com" %>
                    is an independent information website focused on
                    government jobs, competitive examinations, results,
                    admit cards, answer keys, admissions, syllabus
                    information and other useful updates for students
                    and job aspirants.
                </p>

                <p>
                    Our aim is to organize publicly available information
                    in a clear and easy-to-use format so that visitors can
                    quickly understand what an update is about and where
                    they should go for the official information.
                </p>

                <h3>Our Mission</h3>

                <p>
                    Our mission is to make important government examination
                    and recruitment information easier to find, easier to
                    understand and easier to access while encouraging users
                    to verify important details from the concerned official
                    source.
                </p>

                <h3>Our Vision</h3>

                <p>
                    We aim to build a useful, reliable and mobile-friendly
                    information platform where students and applicants can
                    discover relevant updates without unnecessary
                    complexity.
                </p>

            </article>


            <aside class="sr-about-highlight">

                <div class="sr-highlight-icon">
                    &#128203;
                </div>

                <h3>Information First</h3>

                <p>
                    We focus on presenting useful information in a structured
                    way, including important dates, eligibility details,
                    application information, examination updates, results,
                    answer keys and official-source references whenever
                    available.
                </p>

            </aside>

        </div>

    </section>


    <section class="sr-about-section">

        <div class="sr-section-heading">

            <h2>
                Why Use
                <%= (site_setting && site_setting.site_title) || "SarkariResultess.Com" %>?
            </h2>

            <p>
                We focus on clarity, accessibility and useful organization
                of information for students, applicants and examination
                aspirants.
            </p>

        </div>


        <div class="sr-principles-grid">

            <article class="sr-principle">

                <div class="sr-principle-icon">&#128269;</div>

                <h3>Easy to Find</h3>

                <p>
                    Important updates are organized into categories so
                    visitors can find relevant information more easily.
                </p>

            </article>


            <article class="sr-principle">

