<%
var pageStyles = `
.about-hero { background: linear-gradient(90deg, #fff 0%, #fff 60%, rgba(196,16,16,0.03) 100%); border-bottom: 1px solid rgba(0,0,0,0.04); padding: 44px 0; }
.about-hero .container { max-width: 1140px; margin: 0 auto; display:flex; align-items:center; gap: 28px; justify-content: space-between; padding: 0 12px; }
.hero-inner h1 { margin: 0 0 8px 0; font-size: 34px; color: #c41a1a; letter-spacing: 0.2px; font-weight: 800; }
.hero-inner .lead { margin: 0 0 16px 0; color: #333; font-size: 15px; }
.btn-primary-cta { display:inline-block; background: #c41a1a; color: #fff; padding: 10px 18px; border-radius: 8px; text-decoration:none; font-weight:700; box-shadow: 0 6px 18px rgba(196,26,26,0.08); }
.hero-visual { opacity: 0.9; }
.about-container { max-width: 1140px; margin: 26px auto; padding: 0 12px 60px; }
.grid-2{ display:grid; grid-template-columns: 1fr 360px; gap:24px; }
.gap-lg { gap: 24px; margin-top: 16px; }
@media(max-width:980px){ .grid-2 { grid-template-columns: 1fr; } }
.card { background:#fff; border:1px solid #eee; border-radius:10px; padding:22px; box-shadow:0 6px 20px rgba(0,0,0,0.03); }
.about-card h2, .card h3 { margin:0 0 12px 0; color:#222; font-weight:700; }
.muted { color:#666; font-size:14px; line-height:1.6; }
.stats-card { display:flex; flex-direction:column; gap:14px; align-items:stretch; }
.stat{ display:flex; justify-content:space-between; align-items:center; padding:12px; border-radius:8px; background:#fbfbfb; }
.stat-value { font-weight:800; color:#0b4ea2; font-size:20px; }
.stat-label { color:#555; font-size:13px; }
.cta-box { margin-top:6px; padding:12px; border-radius:8px; background:linear-gradient(180deg,#fff,#fbfbfb); text-align:center; }
.btn-outline { display:inline-block; padding:8px 12px; border-radius:6px; border:1px solid #dcdcdc; text-decoration:none; color:#0b4ea2; font-weight:700; }
.section-title-large { text-align:center; margin:28px 0 14px; }
.features-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-top:12px; }
.feature { background:#fff; border:1px solid #eee; padding:18px; border-radius:10px; text-align:center; }
.feature-icon { font-size:24px; margin-bottom:8px; }
.feature h4 { margin:6px 0; }
.team-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:12px; }
.member { display:flex; gap:12px; align-items:center; }
.avatar{ width:56px; height:56px; border-radius:10px; object-fit:cover; border:1px solid #eee; }
.timeline { list-style:none; padding-left:0; margin:12px 0 0 0; }
.timeline li { padding:10px 0; border-bottom:1px dashed #f0f0f0; }
.timeline li strong { display:block; font-size:15px; color:#c41a1a; }
.cta-hero { margin:36px 0 0; text-align:center; }
.cta-inner { display:inline-block; padding:22px 30px; background:#fff; border:1px solid #eee; border-radius:12px; box-shadow:0 8px 28px rgba(0,0,0,0.04); }
.cta-inner h3{ margin:0 0 6px; color:#222; }
.cta-inner .muted{ margin:0 0 12px; color:#666; }
@media(max-width:1200px){ .features-grid{ grid-template-columns:repeat(2,1fr); } .team-grid{ grid-template-columns:repeat(2,1fr); } }
@media(max-width:640px){ .features-grid{ grid-template-columns:1fr; } .team-grid{ grid-template-columns:1fr; } .hero-inner h1{ font-size:28px; } .hero-visual{ display:none; } }
`;
%>
<%- include('../weblayout/layout-top', { title: title, pageStyles: pageStyles }) %>

<div class="about-hero">
  <div class="container">
    <div class="hero-inner">
      <h1>About <%= (site_setting && site_setting.site_title) || 'Sarkari Result' %></h1>
      <p class="lead">Reliable, fast and accurate updates for Government Jobs, Admit Cards, Answer Keys, Results and more.</p>
      <a href="/contact" class="btn btn-primary-cta">Contact Us</a>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <svg width="320" height="200" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="320" height="200" rx="12" fill="#fff"/>
        <g opacity="0.06" fill="#c00"><rect x="12" y="28" width="70" height="12" rx="4"/><rect x="12" y="54" width="110" height="10" rx="4"/></g>
        <g opacity="0.06" fill="#0b4ea2"><rect x="140" y="28" width="160" height="12" rx="4"/><rect x="140" y="54" width="120" height="10" rx="4"/></g>
      </svg>
    </div>
  </div>
</div>

<div class="container about-container">
  <div class="grid-2 gap-lg">
    <section class="card about-card">
      <h2>Who We Are</h2>
      <p class="muted"><%= (site_setting && site_setting.site_title) || 'Sarkari Result' %> is India's trusted platform for government exam updates. Since inception we have focused on delivering timely and verified information - Latest Job openings, Admit Cards, Results, Answer Keys, Syllabus updates and helpful guides to help aspirants prepare and apply with confidence.</p>
      <h3>Our Mission</h3>
      <p>Deliver correct and timely information to every exam aspirant across India - simplifying the search, saving time and removing confusion around official notices.</p>
      <h3>Our Vision</h3>
      <p>To become the single most reliable hub for government exam information in India, while remaining lightweight and mobile-first.</p>
    </section>

    <aside class="card stats-card">
      <div class="stat"><div class="stat-value">+5M</div><div class="stat-label">Monthly Visits</div></div>
      <div class="stat"><div class="stat-value">120k</div><div class="stat-label">Published Notices</div></div>
      <div class="stat"><div class="stat-value">99.9%</div><div class="stat-label">Uptime</div></div>
      <div class="cta-box">
        <h4>Get daily updates</h4>
        <p class="small">Subscribe to our WhatsApp channel or newsletter for instant notifications.</p>
        <a class="btn btn-outline" href="#">Join WhatsApp</a>
      </div>
    </aside>
  </div>

  <div class="section-title-large">
    <h2>Why Choose <%= (site_setting && site_setting.site_title) || 'Sarkari Result' %></h2>
    <p class="muted">We keep it simple, reliable and fast - made for aspirants.</p>
  </div>

  <div class="features-grid">
    <div class="feature"><div class="feature-icon">&#128226;</div><h4>Real-time Updates</h4><p>We monitor official sources and publish updates within minutes.</p></div>
    <div class="feature"><div class="feature-icon">&#128737;</div><h4>Verified Notices</h4><p>Only verified and sourced information, no rumors.</p></div>
    <div class="feature"><div class="feature-icon">&#128241;</div><h4>Mobile Friendly</h4><p>Our pages are optimized for mobile devices and low bandwidth.</p></div>
    <div class="feature"><div class="feature-icon">&#128269;</div><h4>Searchable Database</h4><p>Quick search, filters and categories make finding notices easy.</p></div>
  </div>

  <div class="grid-2 gap-lg mt-30">
    <section class="card team-card">
      <h3>Meet the Team</h3>
      <div class="team-grid">
        <div class="member"><img src="/images/team-avatar.jpg" alt="Team member" class="avatar"><div><strong>Amit Kumar</strong><div class="muted small">Founder & Editor</div></div></div>
        <div class="member"><img src="/images/team-avatar.jpg" alt="Team member" class="avatar"><div><strong>Neha Sharma</strong><div class="muted small">Content Lead</div></div></div>
        <div class="member"><img src="/images/team-avatar.jpg" alt="Team member" class="avatar"><div><strong>Rohit Singh</strong><div class="muted small">Tech & Ops</div></div></div>
      </div>
    </section>

    <section class="card timeline-card">
      <h3>Our Journey</h3>
      <ol class="timeline">
        <li><strong>2010</strong><div class="muted small">Site launched - basic job listings</div></li>
        <li><strong>2015</strong><div class="muted small">Expanded to admit cards and results aggregation</div></li>
        <li><strong>2020</strong><div class="muted small">Mobile first redesign and WhatsApp alerts</div></li>
        <li><strong>2024</strong><div class="muted small">Scalable backend, faster publication workflow</div></li>
      </ol>
    </section>
  </div>

  <div class="cta-hero">
    <div class="cta-inner">
      <h3>Want to stay ahead?</h3>
      <p class="muted">Subscribe to our alerts and never miss an important notification.</p>
      <a href="/contact" class="btn btn-primary-cta">Contact & Subscribe</a>
    </div>
  </div>
</div>

<%- include('../weblayout/layout-bottom') %>
