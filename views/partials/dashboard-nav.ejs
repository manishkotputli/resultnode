<%
/*
|--------------------------------------------------------------------------
| Student Dashboard Navigation
|--------------------------------------------------------------------------
*/

const navItems = [
    {
        id: 'index',
        title: 'My Account',
        url: '/dashboard',
        icon: 'ti-user-check'
    },
    {
        id: 'purchases',
        title: 'My Purchases',
        url: '/dashboard/purchases',
        icon: 'ti-shopping-bag'
    },
    {
        id: 'income-expense',
        title: 'Income & Expense',
        url: '/dashboard/income-expense',
        icon: 'ti-chart-bar'
    },
    {
        id: 'finance-settings',
        title: 'Banks & Categories',
        url: '/dashboard/finance-settings',
        icon: 'ti-id-card'
    }
];

const dashboardTitle =
    (typeof site_setting !== 'undefined' &&
     site_setting &&
     site_setting.site_title)
        ? site_setting.site_title
        : 'Sarkari Result';
%>


<!-- =========================================================
     DASHBOARD SIDEBAR
========================================================= -->

<aside
    class="dashboard-sidebar"
    id="dashboardSidebar"
>

    <!-- =====================================================
         SIDEBAR HEADER
    ====================================================== -->

    <div class="sidebar-header">

        <div class="sidebar-brand">

            <div class="brand-icon">
                <i class="ti ti-school"></i>
            </div>

            <div class="brand-text">

                <strong>
                    <%= dashboardTitle %>
                </strong>

                <span>
                    Student Portal
                </span>

            </div>

        </div>


        <!-- Collapse Button -->

        <button
            type="button"
            class="sidebar-toggle"
            id="sidebarToggle"
            aria-label="Toggle Sidebar"
            aria-expanded="true"
        >

            <i class="ti ti-chevron-left"></i>

        </button>

    </div>


    <!-- =====================================================
         MAIN NAVIGATION
    ====================================================== -->

    <nav class="dash-nav main-nav">

        <% navItems.forEach(function(item) { %>

            <a
                href="<%= item.url %>"
                class="nav-item <%= (typeof active !== 'undefined' && active === item.id) ? 'active' : '' %>"
                data-tooltip="<%= item.title %>"
            >

                <span class="nav-icon">
                    <i class="ti <%= item.icon %>"></i>
                </span>

                <span class="nav-text">
                    <%= item.title %>
                </span>

            </a>

        <% }) %>

    </nav>


    <!-- =====================================================
         SIDEBAR BOTTOM
    ====================================================== -->

    <div class="sidebar-bottom">

        <!-- Back To Site -->

        <a
            href="/"
            class="nav-item back-site"
            data-tooltip="Back to Site"
        >

            <span class="nav-icon">
                <i class="ti ti-arrow-left"></i>
            </span>

            <span class="nav-text">
                Back to Site
            </span>

        </a>


        <!-- Logout -->

        <form
            method="POST"
            action="/logout"
            class="logout-form"
        >

            <button
                type="submit"
                class="nav-item logout-link"
                data-tooltip="Logout"
            >

                <span class="nav-icon">
                    <i class="ti ti-logout"></i>
                </span>

                <span class="nav-text">
                    Logout
                </span>

            </button>

        </form>

    </div>

</aside>


<!-- =========================================================
     MOBILE OVERLAY
========================================================= -->

<div
    class="sidebar-overlay"
    id="sidebarOverlay"
></div>


<!-- =========================================================
     SIDEBAR CSS
========================================================= -->

<style>

/* =========================================================
   DASHBOARD LAYOUT
========================================================= */

.dashboard-layout {
    width: 100%;
    min-height: 100vh;

    display: flex;
    align-items: stretch;

    background: #f6f8fc;
}


/* =========================================================
   MAIN CONTENT
========================================================= */

.dashboard-content {
    flex: 1;
    min-width: 0;
    min-height: 100vh;
}


/* =========================================================
   SIDEBAR
========================================================= */

.dashboard-sidebar {
    width: 350px;
    height: 100vh;
    min-height: 100vh;

    flex: 0 0 350px;

    position: sticky;
    top: 0;
    left: 0;

    z-index: 1000;

    display: flex;
    flex-direction: column;

    box-sizing: border-box;

    padding: 28px 18px;

    background: #080d18;
    color: #ffffff;

    overflow-x: hidden;
    overflow-y: auto;

    box-shadow: 4px 0 18px rgba(0, 0, 0, 0.08);

    transition:
        width 0.28s ease,
        flex-basis 0.28s ease,
        padding 0.28s ease,
        transform 0.28s ease;
}


/* =========================================================
   SIDEBAR SCROLLBAR
========================================================= */

.dashboard-sidebar::-webkit-scrollbar {
    width: 5px;
}

.dashboard-sidebar::-webkit-scrollbar-track {
    background: transparent;
}

.dashboard-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 20px;
}


/* =========================================================
   HEADER
========================================================= */

.sidebar-header {
    width: 100%;
    min-height: 60px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin-bottom: 35px;

    flex-shrink: 0;
}


/* =========================================================
   BRAND
========================================================= */

.sidebar-brand {
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 14px;

    flex: 1;
}


/* =========================================================
   BRAND ICON
========================================================= */

.brand-icon {
    width: 58px;
    height: 58px;
    min-width: 58px;

    border-radius: 16px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(
        135deg,
        #4f46e5,
        #2563eb
    );

    color: #ffffff;

    box-shadow:
        0 8px 22px rgba(37, 99, 235, 0.25);
}

.brand-icon i {
    font-size: 27px;
}


/* =========================================================
   BRAND TEXT
========================================================= */

.brand-text {
    min-width: 0;

    display: flex;
    flex-direction: column;

    overflow: hidden;
}

.brand-text strong {
    color: #ffffff;

    font-size: 20px;
    line-height: 1.2;
    font-weight: 700;

    white-space: nowrap;

    overflow: hidden;
    text-overflow: ellipsis;
}

.brand-text span {
    margin-top: 5px;

    color: #7f8da5;

    font-size: 14px;
    line-height: 1.3;

    white-space: nowrap;
}


/* =========================================================
   TOGGLE BUTTON
========================================================= */

.sidebar-toggle {
    width: 44px;
    height: 44px;
    min-width: 44px;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;

    background: #111827;

    color: #94a3b8;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition:
        background 0.25s ease,
        color 0.25s ease;
}

.sidebar-toggle i {
    font-size: 20px;

    transition:
        transform 0.28s ease;
}

.sidebar-toggle:hover {
    background: #1d2738;
    color: #ffffff;
}


/* =========================================================
   MAIN NAVIGATION
========================================================= */

.main-nav {
    width: 100%;

    display: flex;
    flex-direction: column;

    gap: 8px;

    flex-shrink: 0;
}


/* =========================================================
   NAV ITEM
========================================================= */

.nav-item {
    width: 100%;
    min-height: 60px;

    padding: 0 18px;

    box-sizing: border-box;

    border: 0;
    border-radius: 15px;

    background: transparent;

    color: #91a0b8;

    display: flex;
    align-items: center;

    gap: 17px;

    text-decoration: none;

    font-family: inherit;
    font-size: 16px;
    font-weight: 600;

    line-height: 1;

    cursor: pointer;

    position: relative;

    transition:
        background 0.25s ease,
        color 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.nav-item:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;

    transform: translateX(2px);
}


/* =========================================================
   ICON
========================================================= */

.nav-icon {
    width: 26px;
    min-width: 26px;

    height: 26px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.nav-icon i {
    font-size: 22px;
    line-height: 1;
}


/* =========================================================
   TEXT
========================================================= */

.nav-text {
    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

    transition:
        opacity 0.2s ease;
}


/* =========================================================
   ACTIVE
========================================================= */

.nav-item.active {
    background: linear-gradient(
        135deg,
        #4f46e5,
        #3b82f6
    );

    color: #ffffff;

    box-shadow:
        0 10px 25px rgba(59, 130, 246, 0.25);
}

.nav-item.active:hover {
    transform: none;
}


/* =========================================================
   SIDEBAR BOTTOM
========================================================= */

.sidebar-bottom {
    width: 100%;

    margin-top: auto;

    padding-top: 24px;

    display: flex;
    flex-direction: column;

    gap: 8px;

    flex-shrink: 0;

    border-top: 1px solid rgba(255, 255, 255, 0.08);
}


/* =========================================================
   BACK TO SITE
========================================================= */

.back-site {
    margin-top: 4px;

    color: #8d9ab0;
}

.back-site:hover {
    color: #ffffff;
}


/* =========================================================
   LOGOUT FORM
========================================================= */

.logout-form {
    width: 100%;

    margin: 0;
    padding: 0;
}


/* =========================================================
   LOGOUT
========================================================= */

.logout-link {
    color: #ff6b75;

    text-align: left;

    appearance: none;
}

.logout-link:hover {
    color: #ff858c;

    background: rgba(239, 68, 68, 0.10);
}


/* =========================================================
   COLLAPSED DESKTOP SIDEBAR
========================================================= */

@media (min-width: 992px) {

    .dashboard-sidebar.collapsed {
        width: 82px;
        flex-basis: 82px;

        padding-left: 13px;
        padding-right: 13px;
    }


    /* Header */

    .dashboard-sidebar.collapsed .sidebar-header {
        justify-content: center;
    }


    /* Brand */

    .dashboard-sidebar.collapsed .sidebar-brand {
        justify-content: center;
    }

    .dashboard-sidebar.collapsed .brand-text {
        display: none;
    }

    .dashboard-sidebar.collapsed .brand-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
    }


    /* Toggle */

    .dashboard-sidebar.collapsed .sidebar-toggle {
        position: absolute;

        top: 28px;
        right: 8px;

        width: 34px;
        height: 34px;
        min-width: 34px;

        border-radius: 10px;
    }

    .dashboard-sidebar.collapsed
    .sidebar-toggle i {
        transform: rotate(180deg);
    }


    /* Navigation */

    .dashboard-sidebar.collapsed .nav-item {
        justify-content: center;

        padding-left: 0;
        padding-right: 0;

        gap: 0;
    }

    .dashboard-sidebar.collapsed .nav-text {
        display: none;
    }

    .dashboard-sidebar.collapsed .nav-icon {
        width: 28px;
        min-width: 28px;
    }


    /* Tooltip */

    .dashboard-sidebar.collapsed
    .nav-item:hover::after {
        content: attr(data-tooltip);

        position: absolute;

        left: calc(100% + 12px);
        top: 50%;

        transform: translateY(-50%);

        padding: 8px 12px;

        border-radius: 8px;

        background: #111827;

        color: #ffffff;

        font-size: 13px;
        font-weight: 500;

        white-space: nowrap;

        box-shadow:
            0 8px 25px rgba(0, 0, 0, 0.25);

        z-index: 2000;

        pointer-events: none;
    }

}


/* =========================================================
   MOBILE SIDEBAR
========================================================= */

@media (max-width: 991px) {

    .dashboard-sidebar {
        width: 320px;
        flex: 0 0 320px;

        position: fixed;

        top: 0;
        left: 0;

        transform: translateX(-100%);

        box-shadow:
            15px 0 40px rgba(0, 0, 0, 0.25);
    }


    .dashboard-sidebar.mobile-open {
        transform: translateX(0);
    }


    /* Mobile toggle */

    .dashboard-sidebar .sidebar-toggle {
        width: 42px;
        height: 42px;
        min-width: 42px;
    }


    /* Mobile overlay */

    .sidebar-overlay {
        position: fixed;

        inset: 0;

        z-index: 999;

        display: block;

        background: rgba(0, 0, 0, 0.50);

        opacity: 0;
        visibility: hidden;

        transition:
            opacity 0.25s ease,
            visibility 0.25s ease;
    }

    .sidebar-overlay.active {
        opacity: 1;
        visibility: visible;
    }


    /* Mobile content */

    .dashboard-content {
        width: 100%;
        min-height: 100vh;
    }


    /* Disable desktop collapsed state on mobile */

    .dashboard-sidebar.collapsed {
        width: 320px;
        flex-basis: 320px;

        padding: 28px 18px;

        transform: translateX(-100%);
    }

    .dashboard-sidebar.collapsed.mobile-open {
        transform: translateX(0);
    }

    .dashboard-sidebar.collapsed .brand-text {
        display: flex;
    }

    .dashboard-sidebar.collapsed .sidebar-header {
        justify-content: space-between;
    }

    .dashboard-sidebar.collapsed .sidebar-brand {
        justify-content: flex-start;
    }

    .dashboard-sidebar.collapsed .nav-item {
        justify-content: flex-start;

        padding-left: 18px;
        padding-right: 18px;

        gap: 17px;
    }

    .dashboard-sidebar.collapsed .nav-text {
        display: inline;

        opacity: 1;
    }

    .dashboard-sidebar.collapsed .sidebar-toggle {
        position: static;

        width: 42px;
        height: 42px;
        min-width: 42px;
    }

    .dashboard-sidebar.collapsed
    .sidebar-toggle i {
        transform: none;
    }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 575px) {

    .dashboard-sidebar {
        width: 290px;
        flex-basis: 290px;
    }

    .dashboard-sidebar.collapsed {
        width: 290px;
        flex-basis: 290px;
    }

}

</style>


<!-- =========================================================
     SIDEBAR JAVASCRIPT
========================================================= -->

<script>

(function () {

    const sidebar =
        document.getElementById('dashboardSidebar');

    const toggle =
        document.getElementById('sidebarToggle');

    const overlay =
        document.getElementById('sidebarOverlay');


    if (!sidebar || !toggle) {
        return;
    }


    /*
    |--------------------------------------------------------------------------
    | Desktop Collapse / Mobile Open
    |--------------------------------------------------------------------------
    */

    toggle.addEventListener('click', function () {

        const isMobile =
            window.innerWidth <= 991;


        if (isMobile) {

            sidebar.classList.toggle('mobile-open');

            if (overlay) {
                overlay.classList.toggle('active');
            }

            return;
        }


        sidebar.classList.toggle('collapsed');


        const isCollapsed =
            sidebar.classList.contains('collapsed');


        toggle.setAttribute(
            'aria-expanded',
            String(!isCollapsed)
        );


        /*
        |--------------------------------------------------------------------------
        | Remember desktop sidebar state
        |--------------------------------------------------------------------------
        */

        try {

            localStorage.setItem(
                'studentSidebarCollapsed',
                isCollapsed ? '1' : '0'
            );

        } catch (error) {

            console.warn(
                'Unable to save sidebar state.'
            );

        }

    });


    /*
    |--------------------------------------------------------------------------
    | Restore Desktop Sidebar State
    |--------------------------------------------------------------------------
    */

    if (window.innerWidth > 991) {

        try {

            const savedState =
                localStorage.getItem(
                    'studentSidebarCollapsed'
                );


            if (savedState === '1') {

                sidebar.classList.add(
                    'collapsed'
                );

                toggle.setAttribute(
                    'aria-expanded',
                    'false'
                );

            }

        } catch (error) {

            console.warn(
                'Unable to restore sidebar state.'
            );

        }

    }


    /*
    |--------------------------------------------------------------------------
    | Close Mobile Sidebar
    |--------------------------------------------------------------------------
    */

    if (overlay) {

        overlay.addEventListener(
            'click',
            function () {

                sidebar.classList.remove(
                    'mobile-open'
                );

                overlay.classList.remove(
                    'active'
                );

            }
        );

    }


    /*
    |--------------------------------------------------------------------------
    | ESC Key
    |--------------------------------------------------------------------------
    */

    document.addEventListener(
        'keydown',
        function (event) {

            if (event.key !== 'Escape') {
                return;
            }


            sidebar.classList.remove(
                'mobile-open'
            );


            if (overlay) {

                overlay.classList.remove(
                    'active'
                );

            }

        }
    );


    /*
    |--------------------------------------------------------------------------
    | Window Resize
    |--------------------------------------------------------------------------
    */

    window.addEventListener(
        'resize',
        function () {

            if (window.innerWidth > 991) {

                sidebar.classList.remove(
                    'mobile-open'
                );

                if (overlay) {

                    overlay.classList.remove(
                        'active'
                    );

                }

            }

        }
    );


})();

</script>