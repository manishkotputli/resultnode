<%- include('../adminlayout/admin-layout-top') %>

<!-- Title -->
<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Dashboard</h1>
    <a href="/admin/posts/create" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
        <span class="flex"><i class="icon-plus"></i></span> Add Post
    </a>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-12 gap-4 lg:gap-6 mb-4 lg:mb-6">

    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-secondary text-white text-2xl"><i class="icon-file-text"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Total Posts</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= stats.totalPosts %></h3>
            </div>
        </div>
    </div>

    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-primary text-white text-2xl"><i class="icon-folder-tree"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Categories</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= stats.totalCategories %></h3>
            </div>
        </div>
    </div>

    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-orange text-white text-2xl"><i class="icon-newspaper"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Blog Posts</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= stats.totalBlogs %></h3>
            </div>
        </div>
    </div>

    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-success text-white text-2xl"><i class="icon-users"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Total Users</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= stats.totalUsers %></h3>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-12 gap-4 lg:gap-6">

    <!-- Recent Posts -->
    <div class="col-span-12 xxl:col-span-8">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
            <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                <h2 class="text-gray-900 text-xl font-bold mb-0">Recent Posts</h2>
                <a href="/admin/posts" class="size-10 text-lg flex items-center justify-center rounded-full bg-white border border-border-color text-dark hover:bg-primary hover:border-primary hover:text-white transition-colors" aria-label="View All Posts">
                    <i class="icon-arrow-up-right"></i>
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 border-b border-border-color">
                            <th class="py-2 pr-4 font-medium">Title</th>
                            <th class="py-2 pr-4 font-medium">Category</th>
                            <th class="py-2 pr-4 font-medium">Posted</th>
                            <th class="py-2 pr-4 font-medium text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentPosts && recentPosts.length) { %>
                            <% recentPosts.forEach(function(post) { %>
                            <tr class="border-b border-border-color last:border-0">
                                <td class="py-3 pr-4 font-medium text-gray-900"><%= post.title %></td>
                                <td class="py-3 pr-4">
                                    <span class="inline-flex items-center text-xs font-semibold text-primary bg-primary/10 border border-primary/20 rounded-md px-2 py-0.5">
                                        <%= post.Category ? post.Category.name : '-' %>
                                    </span>
                                </td>
                                <td class="py-3 pr-4 text-gray-600"><%= formatDate(post.post_date || post.created_at) %></td>
                                <td class="py-3 pr-4 text-right">
                                    <a href="/admin/posts/<%= post.id %>/edit" class="text-primary hover:text-primary-hover font-medium">Edit</a>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4" class="py-6 text-center text-gray-500">No posts yet. <a href="/admin/posts/create" class="text-primary font-medium">Add your first post</a>.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Category Breakdown -->
    <div class="col-span-12 xxl:col-span-4">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
            <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                <h2 class="text-gray-900 text-xl font-bold mb-0">Posts by Category</h2>
                <a href="/admin/categories" class="size-10 text-lg flex items-center justify-center rounded-full bg-white border border-border-color text-dark hover:bg-primary hover:border-primary hover:text-white transition-colors" aria-label="Manage Categories">
                    <i class="icon-arrow-up-right"></i>
                </a>
            </div>
            <div class="space-y-3">
                <% if (categoriesWithCounts && categoriesWithCounts.length) { %>
                    <% categoriesWithCounts.forEach(function(cat) { %>
                    <div class="flex items-center justify-between p-2 rounded-lg hover:bg-light">
                        <span class="text-sm font-medium text-gray-900"><%= cat.name %></span>
                        <span class="inline-flex items-center text-xs font-semibold text-gray-700 bg-gray-100 rounded-md px-2 py-0.5"><%= cat.get('postCount') %></span>
                    </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-sm text-gray-500">No categories yet.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../adminlayout/admin-layout-bottom') %>
