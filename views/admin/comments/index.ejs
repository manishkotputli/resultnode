<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Comments</h1>
</div>

<div class="grid grid-cols-1">
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden">
        <form method="GET" action="/admin/comments" class="flex items-center justify-end flex-wrap gap-3 p-4 border-b border-border-color">
            <select name="type" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                <option value="">All Types</option>
                <option value="post" <%= filters.type === 'post' ? 'selected' : '' %>>Post Comments</option>
                <option value="blog" <%= filters.type === 'blog' ? 'selected' : '' %>>Blog Comments</option>
            </select>
            <select name="status" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                <option value="">All Status</option>
                <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
            </select>
        </form>

        <div class="divide-y">
            <% if (comments && comments.length) { %>
                <% comments.forEach(function(c) { %>
                <div class="p-4 flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap mb-1">
                            <span class="text-sm font-semibold text-gray-900"><%= c.User ? c.User.name : 'Unknown User' %></span>
                            <span class="inline-flex items-center text-xs font-semibold text-primary bg-primary/10 border border-primary/20 rounded-md px-2 py-0.5"><%= c.commentable_type === 'blog' ? 'Blog' : 'Post' %></span>
                            <span class="inline-flex items-center text-xs font-bold rounded-lg px-2 py-0.5 border <%= c.is_approved ? 'text-success border-success' : 'text-orange border-orange' %>"><%= c.is_approved ? 'Approved' : 'Pending' %></span>
                        </div>
                        <p class="text-sm text-gray-700 mb-1"><%= c.content %></p>
                        <p class="text-xs text-gray-400 mb-0">
                            On: <% if (c.parent) { %><span class="font-medium text-gray-600"><%= c.parent.title %></span><% } else { %><span class="italic">deleted content</span><% } %>
                            &middot; <%= formatDate(c.created_at) %>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <form method="POST" action="/admin/comments/<%= c.id %>/toggle-approval">
                            <button type="submit" class="size-9 rounded-full hover:bg-gray-100 text-gray-900 flex items-center justify-center transition-colors cursor-pointer" aria-label="Toggle approval" title="<%= c.is_approved ? 'Unapprove' : 'Approve' %>">
                                <i class="<%= c.is_approved ? 'icon-eye-off' : 'icon-check' %> text-sm"></i>
                            </button>
                        </form>
                        <form method="POST" action="/admin/comments/<%= c.id %>/delete" onsubmit="return confirm('Delete this comment (and its replies)?');">
                            <button type="submit" class="size-9 rounded-full hover:bg-gray-100 text-gray-900 hover:text-danger flex items-center justify-center transition-colors cursor-pointer" aria-label="Delete"><i class="icon-trash-2 text-sm"></i></button>
                        </form>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="p-10 text-center text-gray-500">No comments found.</div>
            <% } %>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border-t border-border-color">
            <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total comments</p>
            <div class="flex items-center gap-1">
                <% if (pagination.hasPrev) { %><a href="/admin/comments?page=<%= pagination.page - 1 %>&type=<%= filters.type %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
                <% pagination.pages.forEach(function(p) { %><a href="/admin/comments?page=<%= p %>&type=<%= filters.type %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
                <% if (pagination.hasNext) { %><a href="/admin/comments?page=<%= pagination.page + 1 %>&type=<%= filters.type %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
            </div>
        </div>
        <% } %>
    </div>
</div>

<%- include('../../adminlayout/admin-layout-bottom') %>
