<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold"><%= mode === 'edit' ? 'Edit FAQ' : 'Add FAQ' %></h1>
    <a href="/admin/faqs" class="text-sm font-medium text-gray-600 hover:text-primary flex items-center gap-1"><i class="icon-arrow-left"></i> Back to FAQs</a>
</div>

<form method="POST" action="<%= formAction %>">
    <div class="grid grid-cols-12 gap-4 lg:gap-6">
        <div class="col-span-12 xxl:col-span-8 space-y-4 lg:space-y-6">
            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-4">Question</h2>
                <textarea name="question" rows="2" required placeholder="e.g. How do I download my admit card?" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary"><%= faq ? faq.question : '' %></textarea>
            </div>

            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-gray-900 text-lg font-bold mb-0">Answer(s)</h2>
                    <button type="button" id="addAnswerBtn" class="btn px-3 py-2 rounded-full bg-white border border-border-color text-gray-900 text-sm font-medium inline-flex items-center gap-2 hover:bg-light">
                        <i class="icon-plus"></i> Add Paragraph
                    </button>
                </div>
                <div id="answersList" class="space-y-3">
                    <% if (faq && faq.answers && faq.answers.length) { %>
                        <% faq.answers.forEach(function(a) { %>
                        <div class="flex items-start gap-2">
                            <textarea name="answers_text" rows="3" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary"><%= a.answer %></textarea>
                            <button type="button" class="removeAnswerBtn shrink-0 mt-1 text-danger hover:text-danger-hover cursor-pointer"><i class="icon-trash-2"></i></button>
                        </div>
                        <% }) %>
                    <% } %>
                </div>
                <p class="text-sm text-gray-400 mt-2 mb-0" id="noAnswersMsg" style="<%= (faq && faq.answers && faq.answers.length) ? 'display:none;' : '' %>">No answer paragraphs yet. Click "Add Paragraph".</p>
            </div>
        </div>

        <div class="col-span-12 xxl:col-span-4 space-y-4 lg:space-y-6">
            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-4">Settings</h2>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Category <span class="text-gray-400 font-normal">(optional)</span></label>
                    <select name="category_id" class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        <option value="">General</option>
                        <% categories.forEach(function(cat) { %>
                            <option value="<%= cat.id %>" <%= faq && faq.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Display Order</label>
                    <input type="number" name="ordering" value="<%= faq ? faq.ordering : 0 %>" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                </div>
                <div class="flex items-center justify-between mb-4">
                    <label class="text-sm font-medium text-gray-900">Active</label>
                    <input type="checkbox" name="status" <%= (!faq || faq.status) ? 'checked' : '' %> class="w-5 h-5 text-primary border-border-color rounded focus:ring-0 cursor-pointer">
                </div>
                <button type="submit" class="w-full py-2.5 px-4 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-hover transition cursor-pointer">
                    <%= mode === 'edit' ? 'Update FAQ' : 'Save FAQ' %>
                </button>
            </div>
        </div>
    </div>
</form>

<%
var pageScripts = `
document.getElementById('addAnswerBtn').addEventListener('click', function () {
  var list = document.getElementById('answersList');
  var row = document.createElement('div');
  row.className = 'flex items-start gap-2';
  row.innerHTML =
    '<textarea name="answers_text" rows="3" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary"></textarea>' +
    '<button type="button" class="removeAnswerBtn shrink-0 mt-1 text-danger hover:text-danger-hover cursor-pointer"><i class="icon-trash-2"></i></button>';
  list.appendChild(row);
  document.getElementById('noAnswersMsg').style.display = 'none';
});

document.addEventListener('click', function (e) {
  var btn = e.target.closest('.removeAnswerBtn');
  if (!btn) return;
  var list = document.getElementById('answersList');
  btn.closest('div').remove();
  if (!list.children.length) document.getElementById('noAnswersMsg').style.display = '';
});
`;
%>

<%- include('../../adminlayout/admin-layout-bottom') %>
