<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-4 mb-6">
    <h1 class="text-gray-900 text-2xl lg:text-3xl font-bold">Banners</h1>
    <button type="button" data-hs-overlay="#addBannerModal" class="px-4 py-2.5 rounded-lg bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition-all shadow-sm">
        <i class="icon-plus text-base"></i> Add Banner
    </button>
</div>

<!-- Search & Banner Table (Styled exactly like Blog List) -->
<div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm overflow-hidden">
    <!-- Card Header -->
    <div class="flex items-center justify-between p-4 sm:p-5 border-b border-gray-100 gap-4 flex-wrap bg-white">
        <h2 class="text-gray-900 text-lg font-bold">All Banners</h2>
        <form method="GET" action="/admin/banners" class="relative w-full sm:w-72">
            <input type="text" name="search" value="<%= search %>" placeholder="Search banner text..." class="w-full bg-gray-50/70 border border-gray-200 text-sm text-gray-900 rounded-xl py-2 pl-4 pr-10 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
            <button type="submit" class="absolute top-1/2 -translate-y-1/2 right-3 text-gray-400 hover:text-gray-600 border-0 bg-transparent p-1 cursor-pointer">
                <i class="icon-search text-base"></i>
            </button>
        </form>
    </div>

    <!-- Table Container -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[650px]">
            <thead>
                <tr class="bg-gray-100/80 border-b border-gray-200/70">
                    <th class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-gray-600">Banner</th>
                    <th class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-gray-600">Colour</th>
                    <th class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-gray-600 text-center">Status</th>
                    <th class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-gray-600 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
                <% if (banners && banners.length) { %>
                    <% banners.forEach(function(b) { %>
                    <tr class="hover:bg-gray-50/60 transition-colors">
                        <!-- Banner Image + Text + URL Column (Matching Blog Layout) -->
                        <td class="px-6 py-4 align-middle">
                            <div class="flex items-center gap-3.5">
                                <div class="w-16 h-11 rounded-lg border border-gray-200 bg-gray-50 flex-shrink-0 overflow-hidden flex items-center justify-center">
                                    <% if (b.image) { %>
                                        <img src="<%= b.image %>" alt="Banner Image" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <i class="icon-image text-gray-300 text-xl"></i>
                                    <% } %>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-semibold text-gray-900 truncate"><%= b.text || 'Untitled Banner' %></div>
                                    <div class="text-xs text-gray-400 truncate max-w-xs mt-0.5"><%= b.url || 'No URL attached' %></div>
                                </div>
                            </div>
                        </td>
                        <!-- Colour Code Column -->
                        <td class="px-6 py-4 align-middle">
                            <% if (b.color) { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-700 bg-gray-100 px-2.5 py-1 rounded-md border border-gray-200">
                                    <span class="w-3 h-3 rounded-full border border-black/10 shrink-0" style="background-color: <%= b.color %>"></span>
                                    <%= b.color %>
                                </span>
                            <% } else { %>
                                <span class="text-xs text-gray-400 italic">None</span>
                            <% } %>
                        </td>
                        <!-- Status Badge Column -->
                        <td class="px-6 py-4 align-middle text-center">
                            <form method="POST" action="/admin/banners/<%= b.id %>/toggle-status" class="inline-block">
                                <button type="submit" class="cursor-pointer inline-flex items-center text-xs font-semibold rounded-full px-3 py-1 border transition-all <%= b.status ? 'text-emerald-700 bg-emerald-50 border-emerald-300 hover:bg-emerald-100' : 'text-gray-500 bg-gray-50 border-gray-300 hover:bg-gray-100' %>">
                                    <%= b.status ? 'Active' : 'Inactive' %>
                                </button>
                            </form>
                        </td>
                        <!-- Actions Column -->
                        <td class="px-6 py-4 align-middle text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <button type="button" class="editBannerBtn p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors" aria-label="Edit" data-hs-overlay="#editBannerModal" data-id="<%= b.id %>" data-text="<%= b.text || '' %>" data-url="<%= b.url || '' %>" data-color="<%= b.color || '' %>" data-image="<%= b.image || '' %>">
                                    <i class="icon-pencil-line text-lg"></i>
                                </button>
                                <button type="button" class="deleteBannerBtn p-2 rounded-lg text-gray-500 hover:text-red-600 hover:bg-red-50 transition-colors" aria-label="Delete" data-hs-overlay="#deleteBannerModal" data-id="<%= b.id %>" data-text="<%= b.text || 'this banner' %>">
                                    <i class="icon-trash-2 text-lg"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-gray-500 bg-white">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <i class="icon-image text-4xl text-gray-300"></i>
                                <p class="text-sm font-medium">No banners found.</p>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div id="addBannerModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/60 overflow-x-hidden overflow-y-auto">
    <div class="p-4 sm:max-w-lg sm:w-full sm:mx-auto min-h-[calc(100vh-3.5rem)] flex items-center justify-center">
        <div class="bg-white border border-gray-200 rounded-2xl shadow-xl w-full overflow-hidden">
            <form method="POST" action="/admin/banners" enctype="multipart/form-data">
                <div class="flex items-center justify-between p-4 sm:px-6 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900">Add New Banner</h3>
                    <button type="button" class="w-8 h-8 inline-flex justify-center items-center rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors" data-hs-overlay="#addBannerModal">
                        <i class="icon-x text-lg"></i>
                    </button>
                </div>
                <div class="p-4 sm:p-6 space-y-4">
                    <!-- Image Input with Preview Box -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Banner Image</label>
                        <div id="addBannerImagePreviewWrapper" class="mb-3 hidden">
                            <div class="relative w-full h-36 rounded-xl border border-gray-200 overflow-hidden bg-gray-50">
                                <img id="addBannerImagePreview" src="" alt="Preview" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <label class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-gray-300 rounded-xl cursor-pointer bg-gray-50/50 hover:bg-gray-100/50 hover:border-primary/50 transition-all">
                            <div class="flex flex-col items-center justify-center pt-2 pb-2 text-center px-4">
                                <i class="icon-image text-xl text-gray-400 mb-1"></i>
                                <p class="text-xs font-semibold text-gray-700">Click to upload banner image</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">PNG, JPG, WEBP formats</p>
                            </div>
                            <input type="file" name="image" class="hidden" accept="image/*" onchange="previewSelectedImage(this, 'addBannerImagePreview', 'addBannerImagePreviewWrapper')">
                        </label>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Banner Text</label>
                        <input type="text" name="text" placeholder="e.g. SSC CGL 2026 Notification Out" class="w-full bg-white border border-gray-300 text-sm text-gray-900 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Link URL</label>
                        <input type="text" name="url" placeholder="/post/ssc-cgl-2026" class="w-full bg-white border border-gray-300 text-sm text-gray-900 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Color Code</label>
                        <input type="text" name="color" placeholder="#ff0000 or red" class="w-full bg-white border border-gray-300 text-sm text-gray-900 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
                    </div>
                    <div class="flex items-center justify-between pt-2">
                        <span class="text-sm font-medium text-gray-700">Active Status</span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="status" value="true" checked class="sr-only peer">
                            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                        </label>
                    </div>
                </div>
                <div class="flex justify-end gap-3 p-4 sm:px-6 border-t border-gray-100 bg-gray-50/50">
                    <button type="button" class="py-2.5 px-5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 transition-all" data-hs-overlay="#addBannerModal">Cancel</button>
                    <button type="submit" class="py-2.5 px-5 text-sm font-medium text-white bg-primary rounded-xl hover:bg-primary-hover transition-all shadow-sm">Save Banner</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div id="editBannerModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/60 overflow-x-hidden overflow-y-auto">
    <div class="p-4 sm:max-w-lg sm:w-full sm:mx-auto min-h-[calc(100vh-3.5rem)] flex items-center justify-center">
        <div class="bg-white border border-gray-200 rounded-2xl shadow-xl w-full overflow-hidden">
            <form method="POST" id="editBannerForm" action="" enctype="multipart/form-data">
                <div class="flex items-center justify-between p-4 sm:px-6 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900">Edit Banner</h3>
                    <button type="button" class="w-8 h-8 inline-flex justify-center items-center rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors" data-hs-overlay="#editBannerModal">
                        <i class="icon-x text-lg"></i>
                    </button>
                </div>
                <div class="p-4 sm:p-6 space-y-4">
                    <!-- Image Input with Live Preview Box -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Banner Image</label>
                        <div id="editBannerImagePreviewWrapper" class="mb-3 hidden">
                            <div class="relative w-full h-36 rounded-xl border border-gray-200 overflow-hidden bg-gray-50 group">
                                <img id="editBannerImagePreview" src="" alt="Current Image" class="w-full h-full object-cover">
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-semibold">
                                    Current Preview
                                </div>
                            </div>
                        </div>
                        <label class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-gray-300 rounded-xl cursor-pointer bg-gray-50/50 hover:bg-gray-100/50 hover:border-primary/50 transition-all">
                            <div class="flex flex-col items-center justify-center pt-2 pb-2 text-center px-4">
                                <i class="icon-image text-xl text-gray-400 mb-1"></i>
                                <p class="text-xs font-semibold text-gray-700">Click to replace banner image</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">Leave empty to keep existing image</p>
                            </div>
                            <input type="file" name="image" class="hidden" accept="image/*" onchange="previewSelectedImage(this, 'editBannerImagePreview', 'editBannerImagePreviewWrapper')">
                        </label>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Banner Text</label>
                        <input type="text" name="text" id="editBannerText" class="w-full bg-white border border-gray-300 text-sm text-gray-900 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Link URL</label>
                        <input type="text" name="url" id="editBannerUrl" class="w-full bg-white border border-gray-300 text-sm text-gray-900 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Color Code</label>
                        <input type="text" name="color" id="editBannerColor" class="w-full bg-white border border-gray-300 text-sm text-gray-900 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
                    </div>
                </div>
                <div class="flex justify-end gap-3 p-4 sm:px-6 border-t border-gray-100 bg-gray-50/50">
                    <button type="button" class="py-2.5 px-5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 transition-all" data-hs-overlay="#editBannerModal">Cancel</button>
                    <button type="submit" class="py-2.5 px-5 text-sm font-medium text-white bg-primary rounded-xl hover:bg-primary-hover transition-all shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteBannerModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/60 overflow-x-hidden overflow-y-auto">
    <div class="p-4 sm:max-w-md sm:w-full sm:mx-auto min-h-[calc(100vh-3.5rem)] flex items-center justify-center">
        <div class="bg-white border border-gray-200 rounded-2xl shadow-xl w-full overflow-hidden">
            <form method="POST" id="deleteBannerForm" action="">
                <div class="p-6 text-center">
                    <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto mb-4">
                        <i class="icon-trash-2 text-xl"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Delete Banner</h3>
                    <p class="text-sm text-gray-600">Are you sure you want to delete "<span id="deleteBannerText" class="font-semibold text-gray-900"></span>"?</p>
                </div>
                <div class="flex justify-end gap-3 p-4 sm:px-6 border-t border-gray-100 bg-gray-50/50">
                    <button type="button" class="py-2.5 px-5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 transition-all" data-hs-overlay="#deleteBannerModal">Cancel</button>
                    <button type="submit" class="py-2.5 px-5 text-sm font-medium text-white bg-red-600 rounded-xl hover:bg-red-700 transition-all shadow-sm">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Live Image Preview Handler
function previewSelectedImage(input, previewImgId, wrapperId) {
    const previewImg = document.getElementById(previewImgId);
    const wrapper = document.getElementById(wrapperId);
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function (e) {
            previewImg.src = e.target.result;
            if (wrapper) wrapper.classList.remove('hidden');
        };
        reader.readAsDataURL(input.files[0]);
    }
}

// Direct Execution - Event Listeners
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.editBannerBtn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const form = document.getElementById('editBannerForm');
            form.action = '/admin/banners/' + btn.dataset.id + '/update';
            
            document.getElementById('editBannerText').value = btn.dataset.text || '';
            document.getElementById('editBannerUrl').value = btn.dataset.url || '';
            document.getElementById('editBannerColor').value = btn.dataset.color || '';
            
            const previewWrapper = document.getElementById('editBannerImagePreviewWrapper');
            const previewImg = document.getElementById('editBannerImagePreview');
            
            if (btn.dataset.image) {
                previewImg.src = btn.dataset.image;
                previewWrapper.classList.remove('hidden');
            } else {
                previewWrapper.classList.add('hidden');
                previewImg.src = '';
            }
        });
    });

    document.querySelectorAll('.deleteBannerBtn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('deleteBannerForm').action = '/admin/banners/' + btn.dataset.id + '/delete';
            document.getElementById('deleteBannerText').textContent = btn.dataset.text || '';
        });
    });
});
</script>
<%- include('../../adminlayout/admin-layout-bottom') %>