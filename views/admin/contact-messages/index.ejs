<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Contact Messages</h1>
</div>

<div class="grid grid-cols-1">
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden">
        <form method="GET" action="/admin/contact-messages" class="flex items-center justify-end flex-wrap gap-3 p-4 border-b border-border-color">
            <select name="status" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                <option value="">All Status</option>
                <option value="unread" <%= filters.status === 'unread' ? 'selected' : '' %>>Unread</option>
                <option value="read" <%= filters.status === 'read' ? 'selected' : '' %>>Read</option>
            </select>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[800px]">
                <thead>
                    <tr class="bg-light">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">From</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Subject</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Received</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    <% if (contactMessages && contactMessages.length) { %>
                        <% contactMessages.forEach(function(m) { %>
                        <tr class="<%= !m.is_read ? 'bg-primary/5' : '' %>">
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <p class="text-sm font-semibold text-gray-900 mb-0"><%= m.name %></p>
                                <p class="text-[13px] text-gray-500 mb-0"><%= m.email %></p>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <button type="button" class="viewMsgBtn text-sm text-gray-700 hover:text-primary text-left cursor-pointer" data-hs-overlay="#viewMsgModal"
                                    data-name="<%= m.name %>" data-email="<%= m.email %>" data-subject="<%= m.subject || '(No Subject)' %>" data-message="<%= m.message.replace(/"/g, '&quot;') %>" data-date="<%= formatDate(m.created_at) %>">
                                    <%= m.subject || '(No Subject)' %>
                                </button>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= formatDate(m.created_at) %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <form method="POST" action="/admin/contact-messages/<%= m.id %>/toggle-read">
                                    <button type="submit" class="cursor-pointer inline-flex items-center text-xs font-bold rounded-lg px-3 py-1 border <%= m.is_read ? 'text-gray-500 border-gray-300' : 'text-primary border-primary' %>"><%= m.is_read ? 'Read' : 'Unread' %></button>
                                </form>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white text-end">
                                <form method="POST" action="/admin/contact-messages/<%= m.id %>/delete" onsubmit="return confirm('Delete this message?');">
                                    <button type="submit" class="size-9 rounded-full hover:bg-gray-100 text-gray-900 hover:text-danger inline-flex items-center justify-center transition-colors cursor-pointer"><i class="icon-trash-2 text-sm"></i></button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5" class="px-6 py-10 text-center text-gray-500 bg-white">No contact messages found.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border-t border-border-color">
            <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total messages</p>
            <div class="flex items-center gap-1">
                <% if (pagination.hasPrev) { %><a href="/admin/contact-messages?page=<%= pagination.page - 1 %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
                <% pagination.pages.forEach(function(p) { %><a href="/admin/contact-messages?page=<%= p %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
                <% if (pagination.hasNext) { %><a href="/admin/contact-messages?page=<%= pagination.page + 1 %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
            </div>
        </div>
        <% } %>
    </div>
</div>

<!-- View Message Modal -->
<div id="viewMsgModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <div class="flex items-center justify-between p-4 border-b border-border-color">
                    <h3 class="text-lg font-bold text-gray-900" id="viewMsgSubject">Subject</h3>
                    <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200" aria-label="Close" data-hs-overlay="#viewMsgModal"><i class="icon-x"></i></button>
                </div>
                <div class="p-4 space-y-3">
                    <p class="text-sm text-gray-500 mb-0">From: <span id="viewMsgName" class="font-medium text-gray-900"></span> (<span id="viewMsgEmail" class="text-gray-600"></span>)</p>
                    <p class="text-sm text-gray-500 mb-0">Received: <span id="viewMsgDate" class="text-gray-700"></span></p>
                    <div class="pt-3 border-t border-border-color">
                        <p id="viewMsgBody" class="text-sm text-gray-700 whitespace-pre-line mb-0"></p>
                    </div>
                </div>
                <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                    <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#viewMsgModal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<%
var pageScripts = `
document.querySelectorAll('.viewMsgBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('viewMsgSubject').textContent = btn.dataset.subject || '';
    document.getElementById('viewMsgName').textContent = btn.dataset.name || '';
    document.getElementById('viewMsgEmail').textContent = btn.dataset.email || '';
    document.getElementById('viewMsgDate').textContent = btn.dataset.date || '';
    document.getElementById('viewMsgBody').textContent = btn.dataset.message || '';
  });
});
`;
%>

<%- include('../../adminlayout/admin-layout-bottom') %>
