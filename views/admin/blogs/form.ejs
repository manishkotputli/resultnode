<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold"><%= mode === 'edit' ? 'Edit Blog Post' : 'Add Blog Post' %></h1>
    <a href="/admin/blogs" class="text-sm font-medium text-gray-600 hover:text-primary flex items-center gap-1"><i class="icon-arrow-left"></i> Back to Blog Posts</a>
</div>

<form method="POST" action="<%= formAction %>" enctype="multipart/form-data" id="blogForm">
    <div class="grid grid-cols-12 gap-4 lg:gap-6">

        <div class="col-span-12 xxl:col-span-8 space-y-4 lg:space-y-6">
            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-4">Content</h2>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Title <span class="text-danger">*</span></label>
                    <input type="text" name="title" id="titleInput" required value="<%= blog ? blog.title : '' %>" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-900 mb-2">Category</label>
                        <select name="category_id" class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            <option value="">Select Category</option>
                            <% categories.forEach(function(cat) { %>
                                <option value="<%= cat.id %>" <%= blog && blog.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-900 mb-2">Slug <span class="text-gray-400 font-normal">(optional)</span></label>
                        <input type="text" name="slug" value="<%= blog ? blog.slug : '' %>" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Short Description</label>
                    <textarea name="short_description" rows="2" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary"><%= blog ? (blog.short_description || '') : '' %></textarea>
                </div>

                <div class="mb-1">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Content</label>
                    <textarea name="content" id="contentEditor"><%= blog ? (blog.content || '') : '' %></textarea>
                </div>
                <p class="text-xs text-gray-400 mt-2 mb-0">Tip: paste an image URL directly in the editor toolbar's image button, or drag &amp; drop / paste an image to auto-upload.</p>

                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Tags <span class="text-gray-400 font-normal">(comma separated)</span></label>
                    <input type="text" name="tags" value="<%= blog ? (blog.tags || '') : '' %>" placeholder="ssc, jobs, exam-tips" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                </div>
            </div>

            <!-- SEO -->
            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-4">SEO Meta</h2>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Meta Title</label>
                    <input type="text" name="meta_title" id="metaTitleInput" value="<%= blog ? (blog.meta_title || '') : '' %>" class="form-input w-full bg-white border border-border-color text-sm rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                    <p class="text-xs text-gray-400 mt-1 mb-0"><span id="metaTitleCount">0</span>/60 characters</p>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Meta Keywords</label>
                    <input type="text" name="meta_keywords" value="<%= blog ? (blog.meta_keywords || '') : '' %>" class="form-input w-full bg-white border border-border-color text-sm rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Meta Description</label>
                    <textarea name="meta_description" id="metaDescInput" rows="2" class="form-input w-full bg-white border border-border-color text-sm rounded-lg py-2 px-3 focus:ring-0 focus:border-primary"><%= blog ? (blog.meta_description || '') : '' %></textarea>
                    <p class="text-xs text-gray-400 mt-1 mb-0"><span id="metaDescCount">0</span>/160 characters</p>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Canonical URL</label>
                    <input type="url" name="canonical_url" value="<%= blog ? (blog.canonical_url || '') : '' %>" class="form-input w-full bg-white border border-border-color text-sm rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                </div>
                <div class="flex items-center gap-6">
                    <label class="flex items-center gap-2 text-sm font-medium text-gray-900"><input type="checkbox" name="noindex" <%= blog && blog.noindex ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-0 cursor-pointer"> No-index</label>
                    <label class="flex items-center gap-2 text-sm font-medium text-gray-900"><input type="checkbox" name="nofollow" <%= blog && blog.nofollow ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-0 cursor-pointer"> No-follow</label>
                </div>
            </div>

            <!-- Google Search Preview -->
            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-4">Search Engine Preview</h2>
                <div class="border border-border-color rounded-lg p-4 bg-white">
                    <p id="serpUrl" class="text-[13px] text-gray-600 mb-1 truncate">yoursite.com &rsaquo; blog &rsaquo; <span id="serpSlug"><%= blog ? blog.slug : 'post-slug' %></span></p>
                    <p id="serpTitle" class="text-[#1a0dab] text-lg leading-snug mb-1 truncate"><%= blog && blog.meta_title ? blog.meta_title : (blog ? blog.title : 'Your Blog Title Appears Here') %></p>
                    <p id="serpDesc" class="text-sm text-gray-600 line-clamp-2 mb-0"><%= blog && blog.meta_description ? blog.meta_description : 'Your meta description will appear here to preview how it looks on Google search results.' %></p>
                </div>
            </div>
        </div>

        <div class="col-span-12 xxl:col-span-4 space-y-4 lg:space-y-6">
            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-4">Thumbnail</h2>

                <div id="thumbPreviewWrap" class="<%= blog && blog.thumbnail ? '' : 'hidden' %> mb-3">
                    <img id="thumbPreviewImg" src="<%= blog && blog.thumbnail ? blog.thumbnail : '' %>" class="w-full h-44 object-cover rounded-lg bg-light border border-border-color" alt="Thumbnail preview">
                </div>
                <div id="thumbPlaceholder" class="<%= blog && blog.thumbnail ? 'hidden' : '' %> w-full h-44 rounded-lg bg-light border border-dashed border-border-color flex items-center justify-center text-gray-400 text-sm mb-3">
                    No image selected
                </div>

                <div class="flex gap-2 mb-2">
                    <button type="button" id="tabUploadBtn" class="thumb-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-lg border border-primary bg-primary text-white cursor-pointer">Upload File</button>
                    <button type="button" id="tabUrlBtn" class="thumb-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-lg border border-border-color bg-white text-gray-700 cursor-pointer">Image URL</button>
                </div>

                <div id="uploadPane">
                    <input type="file" name="thumbnail" id="thumbnailFileInput" accept="image/*" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                    <p class="text-xs text-gray-400 mt-1 mb-0">JPG/PNG/WEBP, max 5MB<%= blog && blog.thumbnail ? '. Leave blank to keep current image.' : '' %></p>
                </div>
                <div id="urlPane" class="hidden">
                    <input type="text" id="thumbnailUrlInput" placeholder="https://example.com/image.jpg" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                    <input type="hidden" name="thumbnail_url" id="thumbnailUrlHidden" value="<%= blog && blog.thumbnail && blog.thumbnail.startsWith('http') ? blog.thumbnail : '' %>">
                    <p class="text-xs text-gray-400 mt-1 mb-0">Paste a direct image link and press Tab/Enter to preview.</p>
                </div>
            </div>

            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-4">Publish</h2>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-900 mb-2">Status</label>
                    <select name="status" class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        <option value="draft" <%= (!blog || blog.status === 'draft') ? 'selected' : '' %>>Draft</option>
                        <option value="published" <%= blog && blog.status === 'published' ? 'selected' : '' %>>Published</option>
                    </select>
                </div>
                <div class="flex items-center justify-between mb-4">
                    <label class="text-sm font-medium text-gray-900">Featured Post</label>
                    <input type="checkbox" name="is_featured" <%= blog && blog.is_featured ? 'checked' : '' %> class="w-5 h-5 text-primary border-border-color rounded focus:ring-0 cursor-pointer">
                </div>
                <button type="submit" class="w-full py-2.5 px-4 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-hover transition cursor-pointer">
                    <%= mode === 'edit' ? 'Update Post' : 'Save Post' %>
                </button>
            </div>

            <% if (mode === 'edit' && blog) { %>
            <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
                <h2 class="text-gray-900 text-lg font-bold mb-3">Stats</h2>
                <div class="text-sm text-gray-600 space-y-2">
                    <p class="mb-0">Views: <%= blog.views %></p>
                    <p class="mb-0">Word Count: <%= blog.word_count %> &middot; Read Time: <%= blog.read_time %> min</p>
                    <p class="mb-0">Likes: <%= blog.likes_count %> &middot; Comments: <%= blog.comments_count %></p>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</form>

<!-- CKEditor 5 Classic Build (free, CDN) -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
<script>
(function () {
  // ---------- Custom upload adapter (drag/drop + paste images inside editor) ----------
  class CustomUploadAdapter {
    constructor(loader) { this.loader = loader; }
    upload() {
      return this.loader.file.then((file) => new Promise((resolve, reject) => {
        const formData = new FormData();
        formData.append('upload', file);
        fetch('/admin/upload/editor-image', { method: 'POST', body: formData })
          .then((r) => r.json())
          .then((data) => {
            if (data.url) resolve({ default: data.url });
            else reject(data.error && data.error.message ? data.error.message : 'Upload failed');
          })
          .catch(() => reject('Upload failed. Please try again.'));
      }));
    }
    abort() {}
  }
  function CustomUploadAdapterPlugin(editor) {
    editor.plugins.get('FileRepository').createUploadAdapter = (loader) => new CustomUploadAdapter(loader);
  }

  ClassicEditor
    .create(document.querySelector('#contentEditor'), {
      extraPlugins: [CustomUploadAdapterPlugin],
      toolbar: {
        items: [
          'heading', '|',
          'bold', 'italic', 'underline', 'strikethrough', '|',
          'link', 'blockQuote', 'insertTable', '|',
          'bulletedList', 'numberedList', 'outdent', 'indent', '|',
          'imageUpload', 'insertImage', 'mediaEmbed', '|',
          'undo', 'redo', '|',
          'sourceEditing'
        ],
        shouldNotGroupWhenFull: true
      },
      image: {
        toolbar: [
          'imageTextAlternative', 'toggleImageCaption', '|',
          'imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|',
          'linkImage'
        ],
        insert: { integrations: ['upload', 'assetManager', 'url'] }
      },
      table: {
        contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells']
      },
      link: { addTargetToExternalLinks: true },
      licenseKey: ''
    })
    .then((editor) => { window.__blogEditor = editor; })
    .catch((err) => console.error('CKEditor init error:', err));

  // ---------- Thumbnail tabs (Upload vs URL) ----------
  var tabUploadBtn = document.getElementById('tabUploadBtn');
  var tabUrlBtn = document.getElementById('tabUrlBtn');
  var uploadPane = document.getElementById('uploadPane');
  var urlPane = document.getElementById('urlPane');

  function activateTab(which) {
    var isUpload = which === 'upload';
    uploadPane.classList.toggle('hidden', !isUpload);
    urlPane.classList.toggle('hidden', isUpload);
    tabUploadBtn.className = 'thumb-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-lg border cursor-pointer ' + (isUpload ? 'border-primary bg-primary text-white' : 'border-border-color bg-white text-gray-700');
    tabUrlBtn.className = 'thumb-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-lg border cursor-pointer ' + (!isUpload ? 'border-primary bg-primary text-white' : 'border-border-color bg-white text-gray-700');
  }
  tabUploadBtn.addEventListener('click', function () { activateTab('upload'); });
  tabUrlBtn.addEventListener('click', function () { activateTab('url'); });
  <% if (blog && blog.thumbnail && blog.thumbnail.startsWith('http')) { %>activateTab('url');<% } %>

  // ---------- Thumbnail preview ----------
  var previewWrap = document.getElementById('thumbPreviewWrap');
  var previewImg = document.getElementById('thumbPreviewImg');
  var placeholder = document.getElementById('thumbPlaceholder');

  function showPreview(src) {
    previewImg.src = src;
    previewWrap.classList.remove('hidden');
    placeholder.classList.add('hidden');
  }
  function clearPreview() {
    previewWrap.classList.add('hidden');
    placeholder.classList.remove('hidden');
  }

  document.getElementById('thumbnailFileInput').addEventListener('change', function (e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (ev) { showPreview(ev.target.result); };
    reader.readAsDataURL(file);
  });

  var urlInput = document.getElementById('thumbnailUrlInput');
  var urlHidden = document.getElementById('thumbnailUrlHidden');
  function applyUrl() {
    var val = urlInput.value.trim();
    urlHidden.value = val;
    if (val) {
      var testImg = new Image();
      testImg.onload = function () { showPreview(val); };
      testImg.onerror = function () { clearPreview(); };
      testImg.src = val;
    } else {
      clearPreview();
    }
  }
  urlInput.addEventListener('change', applyUrl);
  urlInput.addEventListener('keyup', function (e) { if (e.key === 'Enter') applyUrl(); });
  <% if (blog && blog.thumbnail && blog.thumbnail.startsWith('http')) { %>
  urlInput.value = "<%- blog.thumbnail %>";
  <% } %>

  // ---------- Live SEO / SERP preview ----------
  var titleInput = document.getElementById('titleInput');
  var metaTitleInput = document.getElementById('metaTitleInput');
  var metaDescInput = document.getElementById('metaDescInput');
  var serpTitle = document.getElementById('serpTitle');
  var serpDesc = document.getElementById('serpDesc');
  var metaTitleCount = document.getElementById('metaTitleCount');
  var metaDescCount = document.getElementById('metaDescCount');

  function updateSerp() {
    serpTitle.textContent = metaTitleInput.value.trim() || titleInput.value.trim() || 'Your Blog Title Appears Here';
    serpDesc.textContent = metaDescInput.value.trim() || 'Your meta description will appear here to preview how it looks on Google search results.';
    metaTitleCount.textContent = metaTitleInput.value.length;
    metaDescCount.textContent = metaDescInput.value.length;
  }
  [titleInput, metaTitleInput, metaDescInput].forEach(function (el) {
    el.addEventListener('input', updateSerp);
  });
  updateSerp();

  // ---------- Submit hook: if URL thumbnail chosen, make sure file input doesn't override ----------
  document.getElementById('blogForm').addEventListener('submit', function () {
    if (!urlPane.classList.contains('hidden')) {
      document.getElementById('thumbnailFileInput').value = '';
    } else {
      urlHidden.value = '';
    }
  });
})();
</script>

<%- include('../../adminlayout/admin-layout-bottom') %>