<%- include('../../adminlayout/admin-layout-top') %>

<!-- Title -->
<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Blog Posts</h1>
    <a href="/admin/blogs/create" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
        <span class="flex"><i class="icon-plus"></i></span> Add Blog Post
    </a>
</div>

<div class="grid grid-cols-1">
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden">

        <form method="GET" action="/admin/blogs" class="flex items-center justify-between flex-wrap gap-3 p-4 border-b border-border-color">
            <div class="relative w-full sm:w-72">
                <input type="text" name="search" value="<%= filters.search %>" placeholder="Search blog posts..." class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-full py-2 pl-4 pr-10! focus:ring-0 focus:border-border-color">
                <button type="submit" class="absolute top-1/2 -translate-y-1/2 right-3.5 text-base text-gray-500 leading-none cursor-pointer bg-transparent border-0"><i class="icon-search"></i></button>
            </div>
            <div class="flex items-center flex-wrap gap-2 md:gap-3">
                <select name="category" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                    <option value="">All Categories</option>
                    <% categories.forEach(function(cat) { %>
                        <option value="<%= cat.id %>" <%= String(filters.category) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
                    <% }) %>
                </select>
                <select name="status" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                    <option value="">All Status</option>
                    <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
                    <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
                </select>
                <% if (filters.search || filters.category || filters.status) { %>
                <a href="/admin/blogs" class="text-sm text-gray-600 hover:text-primary font-medium">Clear</a>
                <% } %>
            </div>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[900px]">
                <thead>
                    <tr class="bg-light">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Post</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Category</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Views</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    <% if (blogs && blogs.length) { %>
                        <% blogs.forEach(function(b) { %>
                        <tr>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <div class="flex items-center gap-3">
                                    <img src="<%= b.thumbnail || '/admin-assets/logo-small.svg' %>" class="size-10 rounded-lg object-cover shrink-0 bg-light" alt="">
                                    <div>
                                        <a href="/admin/blogs/<%= b.id %>/edit" class="text-sm font-semibold text-gray-900 hover:text-primary transition-colors block"><%= b.title %></a>
                                        <p class="text-[13px] text-gray-500 mb-0"><%= b.slug %></p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <span class="inline-flex items-center text-xs font-semibold text-primary bg-primary/10 border border-primary/20 rounded-md px-2 py-0.5"><%= b.BlogCategory ? b.BlogCategory.name : '-' %></span>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= b.views %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <span class="inline-flex items-center text-xs font-bold rounded-lg px-3 py-1 border <%= b.status === 'published' ? 'text-success border-success' : 'text-gray-500 border-gray-300' %>">
                                    <%= b.status === 'published' ? 'Published' : 'Draft' %>
                                </span>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white text-end">
                                <div class="hs-dropdown [--placement:bottom-right] [--auto-close:inside] relative inline-flex">
                                    <button type="button" class="hs-dropdown-toggle size-9 rounded-full cursor-pointer hover:bg-gray-100 text-gray-900 flex items-center justify-center transition-colors text-base" aria-haspopup="menu" aria-expanded="false" aria-label="Dropdown"><i class="icon-ellipsis-vertical"></i></button>
                                    <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-40 bg-white border border-border-color shadow rounded-lg mt-2 z-1" role="menu" aria-orientation="vertical">
                                        <div class="p-2 space-y-1">
                                            <a class="flex items-center hover:bg-primary-50 px-4 py-1.75 rounded-lg text-sm text-default hover:text-primary focus:outline-hidden focus:bg-white" href="/admin/blogs/<%= b.id %>/edit"><i class="icon-pencil-line me-2"></i>Edit</a>
                                            <form method="POST" action="/admin/blogs/<%= b.id %>/delete" onsubmit="return confirm('Delete this blog post? This cannot be undone.');">
                                                <button type="submit" class="w-full flex items-center hover:bg-primary-50 px-4 py-1.75 rounded-lg text-sm text-danger hover:text-danger focus:outline-hidden focus:bg-white cursor-pointer"><i class="icon-trash-2 me-2"></i>Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5" class="px-6 py-10 text-center text-gray-500 bg-white">No blog posts found. <a href="/admin/blogs/create" class="text-primary font-medium">Add your first post</a>.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border-t border-border-color">
            <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total posts</p>
            <div class="flex items-center gap-1">
                <% if (pagination.hasPrev) { %><a href="/admin/blogs?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&category=<%= filters.category %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
                <% pagination.pages.forEach(function(p) { %><a href="/admin/blogs?page=<%= p %>&search=<%= filters.search %>&category=<%= filters.category %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
                <% if (pagination.hasNext) { %><a href="/admin/blogs?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&category=<%= filters.category %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
            </div>
        </div>
        <% } %>
    </div>
</div>

<%- include('../../adminlayout/admin-layout-bottom') %>
