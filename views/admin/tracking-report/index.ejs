<%- include('../../adminlayout/admin-layout-top') %>

<style>
/* =========================================================
   TRACKING REPORT
========================================================= */

.tracking-stat-card {
    position: relative;
    min-height: 126px;
    background: #ffffff;
    border: 1px solid #e7ebf0;
    border-radius: 6px;
    padding: 17px 17px 15px 20px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .025);
    transition: all .2s ease;
}

.tracking-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, .06);
}

.tracking-stat-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
}

.stat-blue::before {
    background: #3b82f6;
}

.stat-green::before {
    background: #22c55e;
}

.stat-yellow::before {
    background: #f59e0b;
}

.stat-red::before {
    background: #ef4444;
}

.tracking-stat-content {
    min-width: 0;
}

.tracking-stat-title {
    margin: 0 0 7px;
    color: #6b7280;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
}

.tracking-stat-value {
    margin: 0 0 7px;
    color: #111827;
    font-size: 22px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.35px;
}

.tracking-stat-growth {
    margin: 0;
    color: #9ca3af;
    font-size: 10px;
    line-height: 1.45;
}

.tracking-stat-growth.positive {
    color: #16a34a;
}

.tracking-stat-growth.negative {
    color: #dc2626;
}

.tracking-stat-growth span:first-child {
    font-weight: 700;
}

.tracking-stat-growth small {
    color: #9ca3af;
    font-size: 10px;
}

.tracking-stat-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 10px;
}

.tracking-stat-icon img {
    width: 42px;
    height: 42px;
    object-fit: contain;
}


/* =========================================================
   FILTER
========================================================= */

.tracking-filter-wrap {
    display: flex;
    align-items: center;
}

.tracking-filter {
    min-height: 42px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 4px 8px;
    display: flex;
    align-items: center;
    gap: 7px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, .03);
}

.tracking-select,
.tracking-date,
.tracking-year {
    height: 32px;
    border: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    color: #374151;
    font-size: 12px;
    font-weight: 500;
}

.tracking-select {
    min-width: 125px;
    padding: 0 25px 0 5px;
}

.tracking-year {
    width: 72px;
    padding: 0 4px;
}

.tracking-date {
    width: 125px;
    padding: 0 5px;
}

.tracking-extra {
    border-left: 1px solid #e5e7eb !important;
    padding-left: 10px !important;
}

.tracking-date-arrow {
    color: #9ca3af;
    font-size: 12px;
}

.tracking-filter-spinner {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #2563eb;
    animation: trackingSpin .8s linear infinite;
}

@keyframes trackingSpin {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}


/* =========================================================
   CHART CARDS
========================================================= */

.tracking-chart-card {
    background: #ffffff;
    border: 1px solid #e7ebf0;
    border-radius: 6px;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .025);
    padding: 18px;
}

.tracking-chart-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 5px;
}

.tracking-chart-title {
    margin: 0;
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}

.tracking-chart-subtitle {
    margin: 4px 0 0;
    color: #9ca3af;
    font-size: 11px;
}

#chartIncomeExpense,
#chartRevenue {
    min-height: 320px;
}


/* =========================================================
   COMMON DASHBOARD CARDS
========================================================= */

.tracking-dashboard-card {
    background: #fff;
    border: 1px solid #e7ebf0;
    border-radius: 6px;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .025);
    padding: 18px;
}


/* =========================================================
   TABLE
========================================================= */

.tracking-dashboard-card table th {
    font-size: 11px;
    font-weight: 600;
    color: #6b7280;
}

.tracking-dashboard-card table td {
    font-size: 12px;
    color: #374151;
}

.tracking-dashboard-card table tbody tr:last-child {
    border-bottom: 0;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 767px) {

    .tracking-filter-wrap {
        width: 100%;
    }

    .tracking-filter {
        width: 100%;
        overflow-x: auto;
    }

    .tracking-stat-card {
        min-height: 118px;
    }

    .tracking-stat-value {
        font-size: 20px;
    }

    .tracking-select {
        min-width: 115px;
    }

    .tracking-date {
        width: 115px;
    }
}
</style>


<!-- =========================================================
     PAGE HEADER + FILTER
========================================================= -->

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">

    <div>
        <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold mb-1">
            Tracking Report
        </h1>

        <p class="text-sm text-gray-500 mb-0">
            Showing:
            <span id="rangeLabel" class="font-medium text-gray-700">
                <%= data.range.label %>
            </span>
        </p>
    </div>


    <!-- Automatic Date Filter -->
    <div class="tracking-filter-wrap">

        <div class="tracking-filter">

            <i class="icon-calendar text-gray-500"></i>


            <!-- Main Filter -->

            <select
                id="filterType"
                class="tracking-select"
            >

                <option
                    value="today"
                    <%= data.range.filter === 'today' ? 'selected' : '' %>
                >
                    Today
                </option>

                <option
                    value="last_7_days"
                    <%= data.range.filter === 'last_7_days' ? 'selected' : '' %>
                >
                    Last 7 Days
                </option>

                <option
                    value="last_30_days"
                    <%= data.range.filter === 'last_30_days' ? 'selected' : '' %>
                >
                    Last 30 Days
                </option>

                <option
                    value="this_month"
                    <%= data.range.filter === 'this_month' ? 'selected' : '' %>
                >
                    This Month
                </option>

                <option
                    value="previous_month"
                    <%= data.range.filter === 'previous_month' ? 'selected' : '' %>
                >
                    Previous Month
                </option>

                <option
                    value="month"
                    <%= data.range.filter === 'month' ? 'selected' : '' %>
                >
                    Month
                </option>

                <option
                    value="year"
                    <%= data.range.filter === 'year' ? 'selected' : '' %>
                >
                    Year
                </option>

                <option
                    value="custom"
                    <%= data.range.filter === 'custom' ? 'selected' : '' %>
                >
                    Custom Range
                </option>

            </select>


            <!-- Month -->

            <select
                id="filterMonth"
                class="tracking-select tracking-extra hidden"
            >

                <% [
                    'January',
                    'February',
                    'March',
                    'April',
                    'May',
                    'June',
                    'July',
                    'August',
                    'September',
                    'October',
                    'November',
                    'December'
                ].forEach(function(m, i) { %>

                    <option value="<%= i + 1 %>">
                        <%= m %>
                    </option>

                <% }) %>

            </select>


            <!-- Year -->

            <input
                type="number"
                id="filterYear"
                min="2000"
                max="2100"
                value="<%= new Date().getFullYear() %>"
                class="tracking-year tracking-extra hidden"
            >


            <!-- Custom From -->

            <input
                type="date"
                id="filterFrom"
                class="tracking-date tracking-extra hidden"
            >


            <span
                id="filterDateArrow"
                class="tracking-date-arrow hidden"
            >
                →
            </span>


            <!-- Custom To -->

            <input
                type="date"
                id="filterTo"
                class="tracking-date tracking-extra hidden"
            >


            <!-- Loading -->

            <span
                id="filterSpinner"
                class="hidden tracking-filter-spinner"
            >
                <i class="icon-loader-2"></i>
            </span>

        </div>

    </div>

</div>



