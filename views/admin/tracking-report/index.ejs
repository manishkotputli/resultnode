<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <div>
        <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold mb-1">Tracking Report</h1>
        <p class="text-sm text-gray-500 mb-0">Showing: <span id="rangeLabel" class="font-medium text-gray-700"><%= data.range.label %></span></p>
    </div>

    <!-- Date Filter -->
    <div class="flex items-center flex-wrap gap-2">
        <select id="filterType" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
            <option value="today" <%= data.range.filter === 'today' ? 'selected' : '' %>>Today</option>
            <option value="last_7_days" <%= data.range.filter === 'last_7_days' ? 'selected' : '' %>>Last 7 Days</option>
            <option value="last_30_days" <%= data.range.filter === 'last_30_days' ? 'selected' : '' %>>Last 30 Days</option>
            <option value="this_month" <%= data.range.filter === 'this_month' ? 'selected' : '' %>>This Month</option>
            <option value="previous_month" <%= data.range.filter === 'previous_month' ? 'selected' : '' %>>Previous Month</option>
            <option value="month" <%= data.range.filter === 'month' ? 'selected' : '' %>>Month</option>
            <option value="year" <%= data.range.filter === 'year' ? 'selected' : '' %>>Year</option>
            <option value="custom" <%= data.range.filter === 'custom' ? 'selected' : '' %>>Custom Range</option>
        </select>

        <select id="filterMonth" class="hidden form-select bg-white border border-border-color text-sm rounded-full py-2 px-3 focus:ring-0">
            <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function(m, i) { %>
                <option value="<%= i + 1 %>"><%= m %></option>
            <% }) %>
        </select>
        <input type="number" id="filterYear" placeholder="Year" class="hidden form-input w-24 bg-white border border-border-color text-sm rounded-full py-2 px-3 focus:ring-0" value="<%= new Date().getFullYear() %>">

        <input type="date" id="filterFrom" class="hidden form-input bg-white border border-border-color text-sm rounded-full py-2 px-3 focus:ring-0">
        <input type="date" id="filterTo" class="hidden form-input bg-white border border-border-color text-sm rounded-full py-2 px-3 focus:ring-0">

        <button type="button" id="applyFilterBtn" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition">
            <i class="icon-filter"></i> Apply
        </button>
        <span id="filterSpinner" class="hidden animate-spin text-primary"><i class="icon-loader-2"></i></span>
    </div>
</div>

<!-- Stat Cards -->
