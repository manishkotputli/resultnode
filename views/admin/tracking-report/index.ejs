<%

pageScripts = `

/* =========================================================
   APEX
========================================================= */

var __apex = window.ApexCharts;

var chartIncomeExpense = null;
var chartRevenue = null;

var INR = new Intl.NumberFormat('en-IN');

var filterRequestController = null;
var filterTimer = null;



/* =========================================================
   HELPERS
========================================================= */

function esc(s) {

    var d = document.createElement('div');

    d.textContent =
        s == null ? '' : String(s);

    return d.innerHTML;
}


function money(n) {

    return '₹' +
        INR.format(
            Math.round(
                Number(n) || 0
            )
        );
}


function fmtDate(d) {

    return d
        ? new Date(d).toLocaleDateString(
            'en-IN',
            {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            }
        )
        : '-';
}


function growthClass(n) {

    return Number(n) >= 0
        ? 'positive'
        : 'negative';
}


function healthClass(status) {

    if (
        status === 'connected' ||
        status === 'operational' ||
        status === 'writable'
    ) {

        return 'text-success border-success';

    }

    if (status === 'error') {

        return 'text-danger border-danger';

    }

    if (status === 'not_configured') {

        return 'text-gray-500 border-gray-300';

    }

    return 'text-primary border-primary';
}


function healthLabel(status) {

    var map = {

        connected: 'Connected',

        operational: 'Operational',

        writable: 'Writable',

        error: 'Error',

        not_configured: 'Not Configured',

        available_manual_trigger:
            'Manual Trigger'

    };

    return map[status] || status;
}



/* =========================================================
   FILTER VISIBILITY
========================================================= */

function updateFilterVisibility() {

    var type =
        document.getElementById('filterType').value;

    var month =
        document.getElementById('filterMonth');

    var year =
        document.getElementById('filterYear');

    var from =
        document.getElementById('filterFrom');

    var to =
        document.getElementById('filterTo');

    var arrow =
        document.getElementById('filterDateArrow');


    month.classList.add('hidden');
    year.classList.add('hidden');
    from.classList.add('hidden');
    to.classList.add('hidden');
    arrow.classList.add('hidden');


    if (type === 'month') {

        month.classList.remove('hidden');
        year.classList.remove('hidden');

    }

    else if (type === 'year') {

        year.classList.remove('hidden');

    }

    else if (type === 'custom') {

        from.classList.remove('hidden');
        arrow.classList.remove('hidden');
        to.classList.remove('hidden');

    }
}



/* =========================================================
   BUILD FILTER QUERY
========================================================= */

function buildQuery() {

    var type =
        document.getElementById('filterType').value;

    var params =
        new URLSearchParams();

    params.set(
        'filter',
        type
    );


    if (type === 'month') {

        params.set(
            'month',
            document.getElementById('filterMonth').value
        );

        params.set(
            'year',
            document.getElementById('filterYear').value
        );

    }


    else if (type === 'year') {

        params.set(
            'year',
            document.getElementById('filterYear').value
        );

    }


    else if (type === 'custom') {

        var from =
            document.getElementById('filterFrom').value;

        var to =
            document.getElementById('filterTo').value;


        if (from) {

            params.set(
                'from',
                from
            );

        }


        if (to) {

            params.set(
                'to',
                to
            );

        }

    }


    return params.toString();
}



/* =========================================================
   CUSTOM RANGE CHECK
========================================================= */

function customRangeReady() {

    var from =
        document.getElementById('filterFrom').value;

    var to =
        document.getElementById('filterTo').value;

    return !!from && !!to;
}



/* =========================================================
   AUTO FILTER
========================================================= */

function scheduleFilterApply() {

    clearTimeout(filterTimer);


    filterTimer =
        setTimeout(
            function () {

                var type =
                    document.getElementById('filterType').value;


                /*
                 * Custom range only executes
                 * after both dates are selected.
                 */

                if (
                    type === 'custom' &&
                    !customRangeReady()
                ) {

                    return;

                }


                applyFilter();

            },
            120
        );
}



/* =========================================================
   APPLY FILTER AJAX
========================================================= */

async function applyFilter() {

    var spinner =
        document.getElementById('filterSpinner');


    /*
     * Cancel old request.
     */

    if (filterRequestController) {

        filterRequestController.abort();

    }


    filterRequestController =
        new AbortController();


    spinner.classList.remove('hidden');


    var qs =
        buildQuery();


    try {

        var res =
            await fetch(
                '/admin/tracking-report/data?' + qs,
                {
                    headers: {
                        'X-Requested-With':
                            'XMLHttpRequest'
                    },

                    signal:
                        filterRequestController.signal
                }
            );


        if (!res.ok) {

            throw new Error(
                'HTTP ' + res.status
            );

        }


        var json =
            await res.json();


        if (json.ok) {

            renderDashboard(
                json.data
            );


            /*
             * Update URL without page reload.
             */

            try {

                history.replaceState(
                    null,
                    '',
                    '/admin/tracking-report?' + qs
                );

            }

            catch (e2) {

                console.warn(
                    'URL update failed',
                    e2
                );

            }

        }


    }

    catch (e) {

        /*
         * AbortError is normal when
         * user changes filter quickly.
         */

        if (
            e.name !== 'AbortError'
        ) {

            console.error(
                'Tracking report refresh failed:',
                e
            );

        }

    }

    finally {

        spinner.classList.add('hidden');

    }
}



