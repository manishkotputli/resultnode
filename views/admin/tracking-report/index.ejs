            c.serverOs
        ],

        [
            'Memory',
            c.memoryFree +
            ' free / ' +
            c.memoryTotal
        ],

        [
            'Heap',
            c.heapUsed +
            ' / ' +
            c.heapTotal
        ],

        [
            'Uptime',
            c.uptime
        ],

        [
            'Disk',
            c.diskFree +
            ' free / ' +
            c.diskTotal
        ],

        [
            'Timezone',
            c.timezone
        ]

    ];


    document.getElementById(
        'serverConfigGrid'
    ).innerHTML =

        items.map(
            function (it) {

                return (

                    '<div class="p-3 rounded-lg border border-border-color">' +

                    '<p class="text-xs text-gray-500 mb-1">' +
                    it[0] +
                    '</p>' +

                    '<p class="text-sm font-semibold text-gray-900 mb-0 truncate">' +
                    esc(it[1]) +
                    '</p>' +

                    '</div>'

                );

            }
        ).join('');

}



/* =========================================================
   CHARTS
========================================================= */

function renderCharts(d) {

    if (!__apex) {

        console.warn(
            'ApexCharts is not loaded.'
        );

        return;
    }


    /* =====================================================
       INCOME / EXPENSE AREA CHART
    ===================================================== */

    var dates =
        d.incomeExpense.series.length

            ? [
                ...new Set(
                    d.incomeExpense.series.map(
                        function (s) {
                            return s.date;
                        }
                    )
                )
            ].sort()

            : [];


    var incomeMap = {};
    var expenseMap = {};


    d.incomeExpense.series.forEach(
        function (s) {

            var value =
                Number(s.total || 0);


            if (
                s.type === 'income'
            ) {

                incomeMap[s.date] =
                    value;

            }

            else {

                expenseMap[s.date] =
                    value;

            }

        }
    );


    var incomeData =
        dates.map(
            function (date) {

                return incomeMap[date] || 0;

            }
        );


    var expenseData =
        dates.map(
            function (date) {

                return expenseMap[date] || 0;

            }
        );


    var netData =
        dates.map(
            function (date, index) {

                return (

                    Number(
                        incomeData[index] || 0
                    ) -

                    Number(
                        expenseData[index] || 0
                    )

                );

            }
        );


    var chartCategories =
        dates.length
            ? dates
            : ['No Data'];


    var ieOptions = {

        chart: {

            type: 'area',

            height: 330,

            toolbar: {
                show: false
            },

            zoom: {
                enabled: false
            },

            fontFamily: 'inherit',

            animations: {

                enabled: true,

                easing: 'easeinout',

                speed: 500

            }

        },


        series: [

            {
                name: 'Income',
                data: dates.length
                    ? incomeData
                    : [0]
            },

            {
                name: 'Expense',
                data: dates.length
                    ? expenseData
                    : [0]
            },

            {
                name: 'Net Income',
                data: dates.length
                    ? netData
                    : [0]
            }

        ],


        colors: [

            '#2563eb',

            '#ef4444',

            '#22c55e'

        ],


        stroke: {

            curve: 'smooth',

            width: 2

        },


        fill: {

            type: 'gradient',

            gradient: {

                shadeIntensity: 1,

                opacityFrom: 0.20,

                opacityTo: 0.02,

                stops: [
                    0,
                    90,
                    100
                ]

            }

        },


        markers: {

            size: 0,

            strokeWidth: 2,

            hover: {

                size: 5

            }

        },


        dataLabels: {

            enabled: false

        },


        grid: {

            borderColor: '#e5e7eb',

            strokeDashArray: 4,

            padding: {

                left: 5,

                right: 10

            }

        },


        xaxis: {

            categories:
                chartCategories,

            axisBorder: {

                show: false

            },

            axisTicks: {

                show: false

            },

            labels: {

                style: {

                    colors:
                        '#6b7280',

                    fontSize:
                        '10px'

                },

                formatter:
                    function (value) {

                        if (
                            !value ||
                            value === 'No Data'
                        ) {

                            return value;

                        }


                        var date =
                            new Date(value);


                        if (
                            isNaN(
                                date.getTime()
                            )
                        ) {

                            return value;

                        }


                        return date.toLocaleDateString(
                            'en-IN',
                            {
                                day: '2-digit',
                                month: 'short'
                            }
                        );

                    }

            }

        },


        yaxis: {

            labels: {

                style: {

                    colors:
                        '#6b7280',

                    fontSize:
                        '10px'

                },

                formatter:
                    function (value) {

                        return money(value);

                    }

            }

        },


        legend: {

            position:
                'top',

            horizontalAlign:
                'right',

            fontSize:
                '11px',

            markers: {

                width:
                    7,

                height:
                    7,

                radius:
                    50

            },

            itemMargin: {

                horizontal:
                    8

            }

        },


        tooltip: {

            shared:
                true,

            intersect:
                false,

            y: {

                formatter:
                    function (value) {

                        return money(value);

                    }

            }

        },


        noData: {

            text:
                'No data available',

            align:
                'center',

            verticalAlign:
                'middle',

            style: {

                color:
                    '#9ca3af',

                fontSize:
                    '13px'

            }

        }

    };


    if (chartIncomeExpense) {

        chartIncomeExpense.updateOptions(
            ieOptions,
            true,
            true
        );

    }

    else {

        chartIncomeExpense =
            new __apex(
                document.querySelector(
                    '#chartIncomeExpense'
                ),
                ieOptions
            );

        chartIncomeExpense.render();

    }



    /* =====================================================
       REVENUE DONUT
    ===================================================== */

    var courseRevenue =
        Number(
            d.revenueBreakdown.course || 0
        );


    var testSeriesRevenue =
        Number(
            d.revenueBreakdown.testSeries || 0
        );


    var otherRevenue =
        Number(
            d.revenueBreakdown.other || 0
        );


    var revenueTotal =
        courseRevenue +
        testSeriesRevenue +
        otherRevenue;


    var revOptions = {

        chart: {

            type: 'donut',

            height: 330,

            fontFamily:
                'inherit',

            animations: {

                enabled:
                    true,

                speed:
                    500

            }

        },


        series: [

            courseRevenue,

            testSeriesRevenue,

            otherRevenue

        ],


        labels: [

            'Course Revenue',

            'Test Series',

            'Other Revenue'

        ],


        colors: [

            '#3b82f6',

            '#f59e0b',

            '#8b5cf6'

        ],


        stroke: {

            width:
                4,

            colors:
                ['#ffffff']

        },


        dataLabels: {

            enabled:
                true,

            style: {

                fontSize:
                    '11px',

                fontWeight:
                    600

            },

            dropShadow: {

                enabled:
                    false

            },

            formatter:
                function (value) {

                    return Math.round(
                        value
                    ) + '%';

                }

        },


        plotOptions: {

            pie: {

                expandOnClick:
                    false,

                donut: {

                    size:
                        '68%',

                    labels: {

                        show:
                            true,


                        name: {

                            show:
                                true,

                            color:
                                '#6b7280',

                            fontSize:
                                '11px',

                            offsetY:
                                -5

                        },


                        value: {

                            show:
                                true,

                            color:
                                '#111827',

                            fontSize:
                                '22px',

                            fontWeight:
                                700,

                            offsetY:
                                8,

                            formatter:
                                function (value) {

                                    return money(
                                        value
                                    );

                                }

                        },


                        total: {

                            show:
                                true,

                            label:
                                'Total Revenue',

                            color:
                                '#6b7280',

                            fontSize:
                                '11px',

                            formatter:
                                function () {

                                    return money(
                                        revenueTotal
                                    );

                                }

                        }

                    }

                }

            }

        },


        legend: {

            position:
                'bottom',

            horizontalAlign:
                'center',

            fontSize:
                '11px',

            labels: {

                colors:
                    '#374151'

            },

            markers: {

                width:
                    8,

                height:
                    8,

                radius:
                    50

            },

            itemMargin: {

                horizontal:
                    8,

                vertical:
                    4

            }

        },


        tooltip: {

            y: {

                formatter:
                    function (value) {

                        return money(
                            value
                        );

                    }

            }

        },


        responsive: [

            {

                breakpoint:
                    640,

                options: {

                    chart: {

                        height:
                            300

                    },

                    legend: {

                        fontSize:
                            '10px'

                    }

                }

            }

        ],


        noData: {

            text:
                'No revenue data',

            align:
                'center',

            verticalAlign:
                'middle',

            style: {

                color:
                    '#9ca3af',

                fontSize:
                    '13px'

            }

        }

    };


    if (chartRevenue) {

        chartRevenue.updateOptions(
            revOptions,
            true,
            true
        );

        chartRevenue.updateSeries([

            courseRevenue,

            testSeriesRevenue,

            otherRevenue

        ]);

    }

    else {

        chartRevenue =
            new __apex(
                document.querySelector(
                    '#chartRevenue'
                ),
                revOptions
            );

        chartRevenue.render();

    }

}



/* =========================================================
   RENDER DASHBOARD
========================================================= */

function renderDashboard(d) {

    document.getElementById(
        'rangeLabel'
    ).textContent =
        d.range.label;


    renderStatCards(d);


    renderIncomeExpenseTable(
        'tbody-income-category',
        d.incomeExpense.incomeByCategory
    );


    renderIncomeExpenseTable(
        'tbody-expense-category',
        d.incomeExpense.expenseByCategory
    );


    renderTransactions(
        d.incomeExpense.topTransactions
    );


    renderTopPosts(
        'tbody-top-posts-views',
        d.posts.topByViews
    );


    renderTopPosts(
        'tbody-top-posts-clicks',
        d.posts.topByClicks
    );


    renderTopPosts(
        'tbody-top-posts-likes',
        d.posts.topByLikes
    );


    document.getElementById(
        'posts-ctr'
    ).textContent =
        d.posts.ctr;


    renderCategoryPosts(
        d.posts.byCategory
    );


    renderTopBlogs(
        d.blogs.topByViews
    );


    renderBlogCategory(
        d.blogs.byCategory
    );


    renderTopPurchasable(
        'tbody-top-courses',
        d.courses.top,
        'course'
    );


    renderTopPurchasable(
        'tbody-top-testseries',
        d.testSeries.top,
        'testSeries'
    );


    renderSiteHealth(
        d.siteHealth
    );


    renderServerConfig(
        d.serverConfig
    );


    renderCharts(d);

}



