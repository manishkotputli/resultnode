<%
// Escape backticks, ${ sequences, and </script breakouts before embedding
// this JSON inside a backtick-delimited JS string below — titles can come
// from scraped/user content and may contain any character.
const dashboardJson = JSON.stringify(data)
  .replace(/\\/g, '\\\\')
  .replace(/`/g, '\\`')
  .replace(/\$\{/g, '\\${')
  .replace(/</g, '\\u003c');
%>
<%
pageScripts = `
var __apex = window.ApexCharts;
var chartIncomeExpense = null;
var chartRevenue = null;
var INR = new Intl.NumberFormat('en-IN');

function esc(s) {
  var d = document.createElement('div');
  d.textContent = s == null ? '' : String(s);
  return d.innerHTML;
}
function money(n) { return '₹' + INR.format(Math.round(Number(n) || 0)); }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '-'; }
function growthClass(n) { return n >= 0 ? 'text-success' : 'text-danger'; }
function healthClass(status) {
  if (status === 'connected' || status === 'operational' || status === 'writable') return 'text-success border-success';
  if (status === 'error') return 'text-danger border-danger';
  if (status === 'not_configured') return 'text-gray-500 border-gray-300';
  return 'text-primary border-primary';
}
function healthLabel(status) {
  var map = { connected: 'Connected', operational: 'Operational', writable: 'Writable', error: 'Error', not_configured: 'Not Configured', available_manual_trigger: 'Manual Trigger' };
  return map[status] || status;
}

function updateFilterVisibility() {
  var type = document.getElementById('filterType').value;
  document.getElementById('filterMonth').classList.toggle('hidden', type !== 'month');
  document.getElementById('filterYear').classList.toggle('hidden', type !== 'month' && type !== 'year');
  document.getElementById('filterFrom').classList.toggle('hidden', type !== 'custom');
  document.getElementById('filterTo').classList.toggle('hidden', type !== 'custom');
}

function buildQuery() {
  var type = document.getElementById('filterType').value;
  var params = new URLSearchParams();
  params.set('filter', type);
  if (type === 'month') {
    params.set('month', document.getElementById('filterMonth').value);
    params.set('year', document.getElementById('filterYear').value);
  } else if (type === 'year') {
    params.set('year', document.getElementById('filterYear').value);
  } else if (type === 'custom') {
    params.set('from', document.getElementById('filterFrom').value);
    params.set('to', document.getElementById('filterTo').value);
  }
  return params.toString();
}

function renderStatCards(d) {
  document.getElementById('stat-total-users').textContent = d.stats.totalUsers;
  document.getElementById('stat-new-users').textContent = d.stats.newUsers;
  var ug = document.getElementById('stat-user-growth');
  ug.textContent = (d.stats.userGrowth >= 0 ? '+' : '') + d.stats.userGrowth + '% vs prev';
  ug.className = 'text-xs mb-0 ' + growthClass(d.stats.userGrowth);
  document.getElementById('stat-active-users').textContent = d.stats.activeUsers;
  document.getElementById('stat-total-posts').textContent = d.stats.totalPosts;
  document.getElementById('stat-total-blogs').textContent = d.stats.totalBlogs;
  document.getElementById('stat-total-courses').textContent = d.stats.totalCourses;
  document.getElementById('stat-total-testseries').textContent = d.stats.totalTestSeries;
  document.getElementById('stat-total-revenue').textContent = money(d.stats.totalRevenue);
  document.getElementById('stat-total-income').textContent = money(d.stats.totalIncome);
  document.getElementById('stat-total-expense').textContent = money(d.stats.totalExpense);
  document.getElementById('stat-net-income').textContent = money(d.stats.netIncome);

  var ig = document.getElementById('stat-income-growth');
  ig.textContent = (d.stats.incomeGrowth >= 0 ? '+' : '') + d.stats.incomeGrowth + '% vs prev';
  ig.className = 'text-xs mb-0 ' + growthClass(d.stats.incomeGrowth);

  var eg = document.getElementById('stat-expense-growth');
  eg.textContent = (d.stats.expenseGrowth >= 0 ? '+' : '') + d.stats.expenseGrowth + '% vs prev';
  eg.className = 'text-xs mb-0 ' + growthClass(-d.stats.expenseGrowth);

  var ng = document.getElementById('stat-net-growth');
  ng.textContent = (d.stats.netIncomeGrowth >= 0 ? '+' : '') + d.stats.netIncomeGrowth + '% vs prev';
  ng.className = 'text-xs mb-0 ' + growthClass(d.stats.netIncomeGrowth);
}

function renderIncomeExpenseTable(id, rows) {
  var tbody = document.getElementById(id);
  if (!rows.length) { tbody.innerHTML = '<tr><td colspan="4" class="py-4 text-center text-gray-400">No data for this period</td></tr>'; return; }
  tbody.innerHTML = rows.map(function (r) {
    return '<tr class="border-b border-border-color last:border-0">' +
      '<td class="py-2 pr-3">' + esc(r.name) + '</td>' +
      '<td class="py-2 pr-3">' + money(r.total) + '</td>' +
      '<td class="py-2 pr-3">' + r.percentage + '%</td>' +
      '<td class="py-2">' + r.txn_count + '</td></tr>';
  }).join('');
}

function renderTransactions(rows) {
  var tbody = document.getElementById('tbody-top-transactions');
  if (!rows.length) { tbody.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-gray-400">No transactions in this period</td></tr>'; return; }
  tbody.innerHTML = rows.map(function (r) {
    var badge = r.type === 'Income' ? 'text-success border-success' : 'text-danger border-danger';
    return '<tr class="border-b border-border-color last:border-0">' +
      '<td class="py-2 pr-3"><span class="inline-flex text-xs font-bold rounded-lg px-2 py-0.5 border ' + badge + '">' + r.type + '</span></td>' +
      '<td class="py-2 pr-3">' + esc(r.category) + '</td>' +
      '<td class="py-2 pr-3">' + esc(r.description) + '</td>' +
      '<td class="py-2 pr-3">' + money(r.amount) + '</td>' +
      '<td class="py-2">' + fmtDate(r.date) + '</td></tr>';
  }).join('');
}

function renderTopPosts(id, rows) {
  var tbody = document.getElementById(id);
  if (!rows.length) { tbody.innerHTML = '<tr><td class="py-4 text-center text-gray-400">No data</td></tr>'; return; }
  tbody.innerHTML = rows.map(function (r) {
    return '<tr class="border-b border-border-color last:border-0">' +
      '<td class="py-2 pr-2 text-gray-900 truncate max-w-[180px]">' + esc(r.post.title) + '</td>' +
      '<td class="py-2 text-right font-semibold">' + r.count + '</td></tr>';
  }).join('');
}

function renderCategoryPosts(rows) {
  var tbody = document.getElementById('tbody-category-posts');
  if (!rows.length) { tbody.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-gray-400">No categories</td></tr>'; return; }
  tbody.innerHTML = rows.map(function (r) {
    return '<tr class="border-b border-border-color last:border-0">' +
      '<td class="py-2 pr-3">' + esc(r.name) + '</td>' +
      '<td class="py-2 pr-3">' + r.postCount + '</td>' +
      '<td class="py-2 pr-3">' + r.views + '</td>' +
      '<td class="py-2 pr-3">' + r.clicks + '</td>' +
      '<td class="py-2">' + r.ctr + '%</td></tr>';
  }).join('');
}

function renderTopBlogs(rows) {
  var tbody = document.getElementById('tbody-top-blogs');
  if (!rows.length) { tbody.innerHTML = '<tr><td class="py-4 text-center text-gray-400">No blogs</td></tr>'; return; }
  tbody.innerHTML = rows.map(function (r) {
    return '<tr class="border-b border-border-color last:border-0">' +
      '<td class="py-2 pr-2 text-gray-900 truncate max-w-[220px]">' + esc(r.title) + '</td>' +
      '<td class="py-2 pr-2 text-gray-500">' + r.views + ' views</td>' +
      '<td class="py-2 text-right font-semibold">' + r.likes_count + ' likes</td></tr>';
  }).join('');
}

function renderBlogCategory(rows) {
  var tbody = document.getElementById('tbody-blog-category');
  if (!rows.length) { tbody.innerHTML = '<tr><td colspan="4" class="py-4 text-center text-gray-400">No categories</td></tr>'; return; }
  tbody.innerHTML = rows.map(function (r) {
    return '<tr class="border-b border-border-color last:border-0">' +
      '<td class="py-2 pr-3">' + esc(r.name) + '</td>' +
      '<td class="py-2 pr-3">' + r.blogCount + '</td>' +
      '<td class="py-2 pr-3">' + r.views + '</td>' +
      '<td class="py-2">' + r.likes + '</td></tr>';
  }).join('');
}

function renderTopPurchasable(id, rows, key) {
  var tbody = document.getElementById(id);
  if (!rows.length) { tbody.innerHTML = '<tr><td colspan="3" class="py-4 text-center text-gray-400">No sales in this period</td></tr>'; return; }
  tbody.innerHTML = rows.map(function (r) {
    var item = r[key];
    return '<tr class="border-b border-border-color last:border-0">' +
      '<td class="py-2 pr-3">' + esc(item.title) + '</td>' +
      '<td class="py-2 pr-3">' + money(r.revenue) + '</td>' +
      '<td class="py-2">' + r.enrollments + '</td></tr>';
  }).join('');
}

function renderSiteHealth(h) {
  var items = [
    ['Application', h.application], ['Database', h.database], ['Cache', h.cache],
    ['Storage', h.storage], ['Queue', h.queue], ['Cron', h.cron],
  ];
  document.getElementById('siteHealthGrid').innerHTML = items.map(function (it) {
    return '<div class="p-3 rounded-lg border border-border-color text-center">' +
      '<p class="text-xs text-gray-500 mb-1">' + it[0] + '</p>' +
      '<span class="inline-flex text-xs font-bold rounded-lg px-2 py-1 border ' + healthClass(it[1]) + '">' + healthLabel(it[1]) + '</span></div>';
  }).join('');
}

function renderServerConfig(c) {
  var items = [
    ['Node Version', c.nodeVersion], ['Environment', c.environment], ['Server OS', c.serverOs],
    ['Memory', c.memoryFree + ' free / ' + c.memoryTotal], ['Heap', c.heapUsed + ' / ' + c.heapTotal],
    ['Uptime', c.uptime], ['Disk', c.diskFree + ' free / ' + c.diskTotal], ['Timezone', c.timezone],
  ];
  document.getElementById('serverConfigGrid').innerHTML = items.map(function (it) {
    return '<div class="p-3 rounded-lg border border-border-color">' +
      '<p class="text-xs text-gray-500 mb-1">' + it[0] + '</p>' +
      '<p class="text-sm font-semibold text-gray-900 mb-0 truncate">' + esc(it[1]) + '</p></div>';
  }).join('');
}

function renderCharts(d) {
  var dates = d.incomeExpense.series.length ? [...new Set(d.incomeExpense.series.map(function (s) { return s.date; }))].sort() : [];
  var incomeMap = {}, expenseMap = {};
  d.incomeExpense.series.forEach(function (s) {
    if (s.type === 'income') incomeMap[s.date] = s.total; else expenseMap[s.date] = s.total;
  });
  var incomeData = dates.map(function (dt) { return incomeMap[dt] || 0; });
  var expenseData = dates.map(function (dt) { return expenseMap[dt] || 0; });
  var netData = dates.map(function (dt, i) { return (incomeData[i] || 0) - (expenseData[i] || 0); });

  var ieOptions = {
    chart: { type: 'area', height: 320, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [
      { name: 'Income', data: incomeData }, { name: 'Expense', data: expenseData }, { name: 'Net Income', data: netData },
    ],
    xaxis: { categories: dates.length ? dates : ['No data'], labels: { style: { fontSize: '11px' } } },
    colors: ['#22c55e', '#ef4444', '#3b82f6'],
    stroke: { curve: 'smooth', width: 2 },
    dataLabels: { enabled: false },
    legend: { position: 'top' },
  };

  if (chartIncomeExpense) { chartIncomeExpense.updateOptions(ieOptions); }
  else if (__apex) { chartIncomeExpense = new __apex(document.querySelector('#chartIncomeExpense'), ieOptions); chartIncomeExpense.render(); }

  var revOptions = {
    chart: { type: 'donut', height: 320, fontFamily: 'inherit' },
    series: [d.revenueBreakdown.course, d.revenueBreakdown.testSeries, d.revenueBreakdown.other],
    labels: ['Course Revenue', 'Test Series Revenue', 'Other'],
    colors: ['#3b82f6', '#f97316', '#a3a3a3'],
    legend: { position: 'bottom' },
  };

  if (chartRevenue) { chartRevenue.updateOptions(revOptions); }
  else if (__apex) { chartRevenue = new __apex(document.querySelector('#chartRevenue'), revOptions); chartRevenue.render(); }
}

function renderDashboard(d) {
  document.getElementById('rangeLabel').textContent = d.range.label;
  renderStatCards(d);
  renderIncomeExpenseTable('tbody-income-category', d.incomeExpense.incomeByCategory);
  renderIncomeExpenseTable('tbody-expense-category', d.incomeExpense.expenseByCategory);
  renderTransactions(d.incomeExpense.topTransactions);
  renderTopPosts('tbody-top-posts-views', d.posts.topByViews);
  renderTopPosts('tbody-top-posts-clicks', d.posts.topByClicks);
  renderTopPosts('tbody-top-posts-likes', d.posts.topByLikes);
  document.getElementById('posts-ctr').textContent = d.posts.ctr;
  renderCategoryPosts(d.posts.byCategory);
  renderTopBlogs(d.blogs.topByViews);
  renderBlogCategory(d.blogs.byCategory);
  renderTopPurchasable('tbody-top-courses', d.courses.top, 'course');
  renderTopPurchasable('tbody-top-testseries', d.testSeries.top, 'testSeries');
  renderSiteHealth(d.siteHealth);
  renderServerConfig(d.serverConfig);
  renderCharts(d);
}

async function applyFilter() {
  var btn = document.getElementById('applyFilterBtn');
  var spinner = document.getElementById('filterSpinner');
  btn.disabled = true;
  spinner.classList.remove('hidden');
  try {
    var qs = buildQuery();
    var res = await fetch('/admin/tracking-report/data?' + qs, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    var json = await res.json();
    if (json.ok) {
      renderDashboard(json.data);
      try { history.replaceState(null, '', '/admin/tracking-report?' + qs); } catch (e2) { /* non-critical */ }
    }
  } catch (e) {
    console.error('Tracking report refresh failed:', e);
  } finally {
    btn.disabled = false;
    spinner.classList.add('hidden');
  }
}

document.getElementById('filterType').addEventListener('change', function () { updateFilterVisibility(); });
document.getElementById('applyFilterBtn').addEventListener('click', applyFilter);
updateFilterVisibility();
renderDashboard(${dashboardJson});
`;
