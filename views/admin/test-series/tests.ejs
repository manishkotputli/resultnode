<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-2">
    <a href="/admin/test-series" class="text-sm font-medium text-gray-600 hover:text-primary flex items-center gap-1"><i class="icon-arrow-left"></i> Back to Test Series</a>
</div>
<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <div>
        <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold mb-1"><%= series.title %></h1>
        <p class="text-sm text-gray-500 mb-0">Manage the individual tests inside this series.</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="/admin/test-series/<%= series.id %>/results" class="px-4 py-2 rounded-full bg-white border border-border-color text-gray-900 text-sm font-medium hover:bg-light">View Results</a>
        <button data-hs-overlay="#addTestModal" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
            <span class="flex"><i class="icon-plus"></i></span> Add Test
        </button>
    </div>
</div>

<div class="grid grid-cols-1">
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[760px]">
                <thead>
                    <tr class="border-b border-border-color bg-gray-50/50">
                        <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">#</th>
                        <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Test</th>
                        <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Duration</th>
                        <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Negative Marking</th>
                        <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Questions</th>
                        <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Attempts</th>
                        <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 bg-white text-gray-900 text-end text-[13px] font-semibold uppercase tracking-wider">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    <% if (tests && tests.length) { %>
                        <% tests.forEach(function(t) { %>
                        <tr>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm font-semibold text-gray-900">#<%= t.test_number %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm font-semibold text-gray-900"><%= t.title %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= t.duration_minutes || series.default_duration_minutes || '—' %><%= (t.duration_minutes || series.default_duration_minutes) ? ' min' : '' %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600">-<%= t.negative_marking !== null ? t.negative_marking : series.default_negative_marking %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <a href="/admin/test-series/<%= series.id %>/tests/<%= t.id %>/questions" class="text-sm text-primary font-medium hover:underline"><%= t.questionCount %> question<%= t.questionCount === 1 ? '' : 's' %></a>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= t.attemptCount %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <span class="inline-flex items-center text-xs font-bold rounded-lg px-2.5 py-1 border <%= t.is_active ? 'text-success border-success' : 'text-gray-500 border-gray-300' %>"><%= t.is_active ? 'Active' : 'Inactive' %></span>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white text-end">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/admin/test-series/<%= series.id %>/tests/<%= t.id %>/questions" class="size-9 rounded-full hover:bg-gray-100 text-gray-900 flex items-center justify-center transition-colors" aria-label="Questions"><i class="icon-list-checks text-sm"></i></a>
                                    <button type="button"
                                        class="editTestBtn size-9 rounded-full hover:bg-gray-100 text-gray-900 flex items-center justify-center transition-colors"
                                        aria-label="Edit"
                                        data-hs-overlay="#editTestModal"
                                        data-id="<%= t.id %>"
                                        data-number="<%= t.test_number %>"
                                        data-title="<%= t.title %>"
                                        data-duration="<%= t.duration_minutes || '' %>"
                                        data-negative="<%= t.negative_marking !== null ? t.negative_marking : '' %>"
                                        data-active="<%= t.is_active ? '1' : '0' %>">
                                        <i class="icon-pencil-line text-sm"></i>
                                    </button>
                                    <button type="button"
                                        class="deleteTestBtn size-9 rounded-full hover:bg-gray-100 text-gray-900 hover:text-danger flex items-center justify-center transition-colors"
                                        aria-label="Delete"
                                        data-hs-overlay="#deleteTestModal"
                                        data-id="<%= t.id %>"
                                        data-title="<%= t.title %>">
                                        <i class="icon-trash-2 text-sm"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="8" class="px-6 py-10 text-center text-gray-500 bg-white">No tests yet. Add the first one to get started.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border-t border-border-color">
            <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total</p>
            <div class="flex items-center gap-1">
                <% if (pagination.hasPrev) { %><a href="/admin/test-series/<%= series.id %>/tests?page=<%= pagination.page - 1 %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
                <% pagination.pages.forEach(function(p) { %><a href="/admin/test-series/<%= series.id %>/tests?page=<%= p %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
                <% if (pagination.hasNext) { %><a href="/admin/test-series/<%= series.id %>/tests?page=<%= pagination.page + 1 %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
            </div>
        </div>
        <% } %>
    </div>
</div>

<!-- Add Test Modal -->
<div id="addTestModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" action="/admin/test-series/<%= series.id %>/tests">
                    <div class="flex items-center justify-between p-4 border-b border-border-color">
                        <h3 class="text-lg font-bold text-gray-900">Add Test</h3>
                        <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200" aria-label="Close" data-hs-overlay="#addTestModal"><i class="icon-x"></i></button>
                    </div>
                    <div class="p-4 space-y-4">
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Test Number <span class="text-danger">*</span></label>
                                <input type="number" min="1" name="test_number" required value="<%= nextTestNumber %>" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Duration (min)</label>
                                <input type="number" min="1" name="duration_minutes" placeholder="<%= series.default_duration_minutes || 'series default' %>" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Title <span class="text-danger">*</span></label>
                            <input type="text" name="title" required placeholder="e.g. Full Syllabus Mock Test 1" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Negative Marking <span class="text-gray-400 font-normal">(optional override)</span></label>
                            <input type="number" step="0.01" min="0" name="negative_marking" placeholder="series default: <%= series.default_negative_marking %>" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-gray-900">Active</label>
                            <input type="checkbox" name="is_active" checked class="w-5 h-5 text-primary border-border-color rounded focus:ring-0 cursor-pointer">
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#addTestModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-hover cursor-pointer">Add Test</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Test Modal -->
<div id="editTestModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" id="editTestForm" action="">
                    <div class="flex items-center justify-between p-4 border-b border-border-color">
                        <h3 class="text-lg font-bold text-gray-900">Edit Test</h3>
                        <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200" aria-label="Close" data-hs-overlay="#editTestModal"><i class="icon-x"></i></button>
                    </div>
                    <div class="p-4 space-y-4">
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Test Number <span class="text-danger">*</span></label>
                                <input type="number" min="1" name="test_number" id="editTestNumber" required class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Duration (min)</label>
                                <input type="number" min="1" name="duration_minutes" id="editTestDuration" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Title <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="editTestTitle" required class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Negative Marking <span class="text-gray-400 font-normal">(optional override)</span></label>
                            <input type="number" step="0.01" min="0" name="negative_marking" id="editTestNegative" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-gray-900">Active</label>
                            <input type="checkbox" name="is_active" id="editTestActive" class="w-5 h-5 text-primary border-border-color rounded focus:ring-0 cursor-pointer">
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#editTestModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-hover cursor-pointer">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Test Modal -->
<div id="deleteTestModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" id="deleteTestForm" action="">
                    <div class="p-4 sm:p-7">
                        <div class="text-center">
                            <div class="flex justify-center mb-4">
                                <div class="flex items-center justify-center size-14 rounded-full bg-danger/10"><i class="icon-trash-2 text-danger text-2xl!"></i></div>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 mb-2">Delete Test</h3>
                            <p class="text-sm text-gray-600 mb-0">Delete "<span id="deleteTestTitle" class="font-semibold"></span>"? This also removes its questions and attempts. This cannot be undone.</p>
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#deleteTestModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-danger rounded-lg hover:bg-danger-hover cursor-pointer">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%
var pageScripts = `
document.querySelectorAll('.editTestBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('editTestForm').action = '/admin/test-series/${series.id}/tests/' + btn.dataset.id + '/update';
    document.getElementById('editTestNumber').value = btn.dataset.number || '';
    document.getElementById('editTestTitle').value = btn.dataset.title || '';
    document.getElementById('editTestDuration').value = btn.dataset.duration || '';
    document.getElementById('editTestNegative').value = btn.dataset.negative || '';
    document.getElementById('editTestActive').checked = btn.dataset.active === '1';
  });
});
document.querySelectorAll('.deleteTestBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('deleteTestForm').action = '/admin/test-series/${series.id}/tests/' + btn.dataset.id + '/delete';
    document.getElementById('deleteTestTitle').textContent = btn.dataset.title || '';
  });
});
`;
%>

<%- include('../../adminlayout/admin-layout-bottom') %>
