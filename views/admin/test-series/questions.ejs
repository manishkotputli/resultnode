<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-2">
    <a href="/admin/test-series/<%= seriesId %>/tests" class="text-sm font-medium text-gray-600 hover:text-primary flex items-center gap-1"><i class="icon-arrow-left"></i> Back to Tests</a>
</div>
<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <div>
        <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold mb-1">Test <%= test.test_number %>: <%= test.title %></h1>
        <p class="text-sm text-gray-500 mb-0"><%= total %> question<%= total === 1 ? '' : 's' %> in this test.</p>
    </div>
    <button data-hs-overlay="#addQuestionModal" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
        <span class="flex"><i class="icon-plus"></i></span> Add Question
    </button>
</div>

<div class="space-y-3">
    <% if (questions && questions.length) { %>
        <% questions.forEach(function(q, idx) { %>
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4 lg:p-5">
            <div class="flex items-start justify-between gap-3 mb-3">
                <p class="text-sm font-semibold text-gray-900 mb-0"><span class="text-gray-400">Q<%= idx + 1 + (pagination.page - 1) * 20 %>.</span> <%= q.question_text %></p>
                <div class="flex items-center gap-2 shrink-0">
                    <span class="text-xs font-bold text-gray-500 whitespace-nowrap"><%= q.marks %> mark<%= Number(q.marks) === 1 ? '' : 's' %></span>
                    <button type="button"
                        class="editQuestionBtn size-8 rounded-full hover:bg-gray-100 text-gray-900 flex items-center justify-center transition-colors"
                        aria-label="Edit"
                        data-hs-overlay="#editQuestionModal"
                        data-id="<%= q.id %>"
                        data-text="<%= q.question_text %>"
                        data-a="<%= q.option_a %>"
                        data-b="<%= q.option_b %>"
                        data-c="<%= q.option_c %>"
                        data-d="<%= q.option_d %>"
                        data-correct="<%= q.correct_option %>"
                        data-marks="<%= q.marks %>">
                        <i class="icon-pencil-line text-sm"></i>
                    </button>
                    <button type="button"
                        class="deleteQuestionBtn size-8 rounded-full hover:bg-gray-100 text-gray-900 hover:text-danger flex items-center justify-center transition-colors"
                        aria-label="Delete"
                        data-hs-overlay="#deleteQuestionModal"
                        data-id="<%= q.id %>">
                        <i class="icon-trash-2 text-sm"></i>
                    </button>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <% ['A','B','C','D'].forEach(function(opt) { %>
                <% var val = { A: q.option_a, B: q.option_b, C: q.option_c, D: q.option_d }[opt]; %>
                <div class="flex items-center gap-2 text-sm rounded-lg px-3 py-2 border <%= q.correct_option === opt ? 'border-success bg-success/5 text-success font-medium' : 'border-border-color text-gray-600' %>">
                    <span class="size-5 shrink-0 rounded-full border flex items-center justify-center text-[10px] font-bold <%= q.correct_option === opt ? 'border-success text-success' : 'border-gray-300 text-gray-400' %>"><%= opt %></span>
                    <span class="truncate"><%= val %></span>
                    <% if (q.correct_option === opt) { %><i class="icon-check ms-auto"></i><% } %>
                </div>
                <% }) %>
            </div>
        </div>
        <% }) %>
    <% } else { %>
        <div class="text-center py-16 text-gray-500 bg-white-50 rounded-lg border border-border-color">No questions yet. Add the first one to get started.</div>
    <% } %>
</div>

<% if (pagination.totalPages > 1) { %>
<div class="flex items-center justify-between flex-wrap gap-3 mt-6">
    <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total</p>
    <div class="flex items-center gap-1">
        <% if (pagination.hasPrev) { %><a href="/admin/test-series/<%= seriesId %>/tests/<%= test.id %>/questions?page=<%= pagination.page - 1 %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
        <% pagination.pages.forEach(function(p) { %><a href="/admin/test-series/<%= seriesId %>/tests/<%= test.id %>/questions?page=<%= p %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
        <% if (pagination.hasNext) { %><a href="/admin/test-series/<%= seriesId %>/tests/<%= test.id %>/questions?page=<%= pagination.page + 1 %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
    </div>
</div>
<% } %>

<!-- Add Question Modal -->
<div id="addQuestionModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" action="/admin/test-series/<%= seriesId %>/tests/<%= test.id %>/questions">
                    <div class="flex items-center justify-between p-4 border-b border-border-color">
                        <h3 class="text-lg font-bold text-gray-900">Add Question</h3>
                        <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200" aria-label="Close" data-hs-overlay="#addQuestionModal"><i class="icon-x"></i></button>
                    </div>
                    <div class="p-4 space-y-4 max-h-[70vh] overflow-y-auto">
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Question <span class="text-danger">*</span></label>
                            <textarea name="question_text" required rows="2" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary"></textarea>
                        </div>
                        <div class="grid grid-cols-1 gap-2">
                            <input type="text" name="option_a" required placeholder="Option A" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            <input type="text" name="option_b" required placeholder="Option B" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            <input type="text" name="option_c" required placeholder="Option C" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            <input type="text" name="option_d" required placeholder="Option D" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Correct Option <span class="text-danger">*</span></label>
                                <select name="correct_option" required class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                    <option value="D">D</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Marks</label>
                                <input type="number" step="0.5" min="0" name="marks" value="1" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            </div>
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#addQuestionModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-hover cursor-pointer">Add Question</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Question Modal -->
<div id="editQuestionModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" id="editQuestionForm" action="">
                    <div class="flex items-center justify-between p-4 border-b border-border-color">
                        <h3 class="text-lg font-bold text-gray-900">Edit Question</h3>
                        <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200" aria-label="Close" data-hs-overlay="#editQuestionModal"><i class="icon-x"></i></button>
                    </div>
                    <div class="p-4 space-y-4 max-h-[70vh] overflow-y-auto">
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Question <span class="text-danger">*</span></label>
                            <textarea name="question_text" id="editQuestionText" required rows="2" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary"></textarea>
                        </div>
                        <div class="grid grid-cols-1 gap-2">
                            <input type="text" name="option_a" id="editOptionA" required placeholder="Option A" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            <input type="text" name="option_b" id="editOptionB" required placeholder="Option B" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            <input type="text" name="option_c" id="editOptionC" required placeholder="Option C" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            <input type="text" name="option_d" id="editOptionD" required placeholder="Option D" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Correct Option <span class="text-danger">*</span></label>
                                <select name="correct_option" id="editCorrectOption" required class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                    <option value="D">D</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-900 mb-2">Marks</label>
                                <input type="number" step="0.5" min="0" name="marks" id="editMarks" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                            </div>
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#editQuestionModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-hover cursor-pointer">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Question Modal -->
<div id="deleteQuestionModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" id="deleteQuestionForm" action="">
                    <div class="p-4 sm:p-7">
                        <div class="text-center">
                            <div class="flex justify-center mb-4">
                                <div class="flex items-center justify-center size-14 rounded-full bg-danger/10"><i class="icon-trash-2 text-danger text-2xl!"></i></div>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 mb-2">Delete Question</h3>
                            <p class="text-sm text-gray-600 mb-0">This cannot be undone.</p>
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#deleteQuestionModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-danger rounded-lg hover:bg-danger-hover cursor-pointer">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%
var pageScripts = `
document.querySelectorAll('.editQuestionBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('editQuestionForm').action = '/admin/test-series/${seriesId}/tests/${test.id}/questions/' + btn.dataset.id + '/update';
    document.getElementById('editQuestionText').value = btn.dataset.text || '';
    document.getElementById('editOptionA').value = btn.dataset.a || '';
    document.getElementById('editOptionB').value = btn.dataset.b || '';
    document.getElementById('editOptionC').value = btn.dataset.c || '';
    document.getElementById('editOptionD').value = btn.dataset.d || '';
    document.getElementById('editCorrectOption').value = btn.dataset.correct || 'A';
    document.getElementById('editMarks').value = btn.dataset.marks || 1;
  });
});
document.querySelectorAll('.deleteQuestionBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('deleteQuestionForm').action = '/admin/test-series/${seriesId}/tests/${test.id}/questions/' + btn.dataset.id + '/delete';
  });
});
`;
%>

<%- include('../../adminlayout/admin-layout-bottom') %>
