<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * { box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f4f4f5; margin: 0; padding: 32px 16px; color: #1f2937; }
        .sheet { max-width: 680px; margin: 0 auto; background: #fff; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; }
        .header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 28px 32px; border-bottom: 1px solid #e5e7eb; }
        .brand { display: flex; align-items: center; gap: 10px; }
        .brand img { height: 32px; }
        .brand .name { font-size: 18px; font-weight: 700; }
        .badge { display: inline-flex; align-items: center; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; text-transform: capitalize; }
        .badge.completed { color: #138743; background: rgba(19,135,67,0.1); }
        .badge.pending { color: #fdaf22; background: rgba(253,175,34,0.12); }
        .badge.failed { color: #bf0000; background: rgba(191,0,0,0.1); }
        .badge.refunded { color: #6b7280; background: #f3f4f6; }
        .body { padding: 28px 32px; }
        .title { font-size: 22px; font-weight: 700; margin: 0 0 4px; }
        .subtitle { font-size: 13px; color: #6b7280; margin: 0 0 24px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
        .label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #9ca3af; margin-bottom: 4px; }
        .value { font-size: 14px; font-weight: 600; color: #111827; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #9ca3af; padding: 10px 0; border-bottom: 1px solid #e5e7eb; }
        td { padding: 14px 0; border-bottom: 1px solid #f3f4f6; font-size: 14px; }
        .total-row td { border-bottom: none; padding-top: 16px; font-size: 16px; font-weight: 700; }
        .footer { padding: 20px 32px; background: #fafafa; border-top: 1px solid #e5e7eb; font-size: 12px; color: #9ca3af; text-align: center; }
        .actions { max-width: 680px; margin: 16px auto 0; display: flex; justify-content: flex-end; gap: 8px; }
        .btn { padding: 9px 18px; border-radius: 999px; font-size: 14px; font-weight: 600; border: 1px solid #e5e7eb; background: #fff; color: #111827; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
        .btn.primary { background: #70bf4c; border-color: #70bf4c; color: #fff; }
        @media print {
            body { background: #fff; padding: 0; }
            .actions { display: none; }
            .sheet { border: none; border-radius: 0; }
        }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="header">
            <div class="brand">
                <% if (typeof site_setting !== 'undefined' && site_setting && site_setting.logo) { %>
                    <img src="<%= site_setting.logo %>" alt="">
                <% } %>
                <span class="name"><%= (typeof site_setting !== 'undefined' && site_setting && site_setting.site_title) ? site_setting.site_title : 'Receipt' %></span>
            </div>
            <span class="badge <%= purchase.payment_status %>"><%= purchase.payment_status %></span>
        </div>
        <div class="body">
            <p class="title">Payment Receipt</p>
            <p class="subtitle">Order <%= purchase.order_id || ('#' + purchase.id) %></p>

            <div class="grid">
                <div>
                    <div class="label">Billed To</div>
                    <div class="value"><%= purchase.User ? purchase.User.name : '—' %></div>
                    <div style="font-size:13px;color:#6b7280;"><%= purchase.User ? purchase.User.email : '' %></div>
                </div>
                <div>
                    <div class="label">Order Date</div>
                    <div class="value"><%= formatDate(purchase.purchased_at || purchase.created_at) %></div>
                </div>
                <div>
                    <div class="label">Payment Method</div>
                    <div class="value" style="text-transform:capitalize;"><%= purchase.payment_method || '—' %></div>
                </div>
                <div>
                    <div class="label">Transaction ID</div>
                    <div class="value"><%= purchase.transaction_id || '—' %></div>
                </div>
            </div>

            <table>
                <thead>
                    <tr><th>Item</th><th>Type</th><th style="text-align:right;">Amount</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><%= purchase.itemTitle %></td>
                        <td style="text-transform:capitalize;"><%= purchase.purchasable_type === 'course' ? 'Course' : 'Test Series' %></td>
                        <td style="text-align:right;">₹<%= Number(purchase.amount).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                    </tr>
                    <tr class="total-row">
                        <td colspan="2">Total Paid</td>
                        <td style="text-align:right;">₹<%= Number(purchase.amount).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="footer">
            <% if (typeof site_setting !== 'undefined' && site_setting && site_setting.contact_email) { %>Questions about this order? Contact <%= site_setting.contact_email %><% } else { %>This is a system-generated receipt.<% } %>
        </div>
    </div>
    <div class="actions">
        <button class="btn primary" onclick="window.print()">Print / Save as PDF</button>
    </div>
</body>
</html>
