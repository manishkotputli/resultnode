<script>
var ALL_BANKS = <%- bankOptionsJson %>;
var ALL_CATEGORIES = <%- categoryOptionsJson %>;

function feFilterBank(prefix) {
  var userSel = document.getElementById(prefix + 'EntryUser');
  var bankSel = document.getElementById(prefix + 'EntryBank');
  if (!userSel || !bankSel) return;
  var userId = userSel.value ? parseInt(userSel.value, 10) : null;
  var keep = bankSel.value;
  bankSel.innerHTML = '';
  var blank = document.createElement('option');
  blank.value = '';
  blank.textContent = 'Cash / no account';
  bankSel.appendChild(blank);
  ALL_BANKS.filter(function (b) { return !userId || b.user_id === userId; }).forEach(function (b) {
    var opt = document.createElement('option');
    opt.value = b.id;
    opt.textContent = b.name;
    bankSel.appendChild(opt);
  });
  bankSel.value = keep;
}

function feFilterCategory(prefix) {
  var userSel = document.getElementById(prefix + 'EntryUser');
  var typeSel = document.getElementById(prefix + 'EntryType');
  var catSel = document.getElementById(prefix + 'EntryCategory');
  if (!userSel || !typeSel || !catSel) return;
  var userId = userSel.value ? parseInt(userSel.value, 10) : null;
  var type = typeSel.value ? parseInt(typeSel.value, 10) : null;
  var keep = catSel.value;
  catSel.innerHTML = '';
  var blank = document.createElement('option');
  blank.value = '';
  blank.textContent = userId ? 'Select category' : 'Select user first';
  catSel.appendChild(blank);
  ALL_CATEGORIES.filter(function (c) {
    return (!userId || c.user_id === userId) && (!type || Number(c.type) === type);
  }).forEach(function (c) {
    var opt = document.createElement('option');
    opt.value = c.id;
    opt.textContent = c.name;
    catSel.appendChild(opt);
  });
  catSel.value = keep;
}

['add', 'edit'].forEach(function (prefix) {
  var userEl = document.getElementById(prefix + 'EntryUser');
  var typeEl = document.getElementById(prefix + 'EntryType');
  if (userEl) userEl.addEventListener('change', function () { feFilterBank(prefix); feFilterCategory(prefix); });
  if (typeEl) typeEl.addEventListener('change', function () { feFilterCategory(prefix); });
});
feFilterBank('add');
feFilterCategory('add');

document.querySelectorAll('.editBankBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('editBankForm').action = '/admin/income-expense/bank/' + btn.dataset.id + '/update';
    document.getElementById('editBankUser').value = btn.dataset.user || '';
    document.getElementById('editBankName').value = btn.dataset.name || '';
    document.getElementById('editBankAccount').value = btn.dataset.account || '';
    document.getElementById('editBankBalance').value = btn.dataset.balance || 0;
    document.getElementById('editBankActive').checked = btn.dataset.active === '1';
  });
});

document.querySelectorAll('.deleteBankBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('deleteBankForm').action = '/admin/income-expense/bank/' + btn.dataset.id + '/delete';
    document.getElementById('deleteBankName').textContent = btn.dataset.name || '';
  });
});

document.querySelectorAll('.editEntryBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('editEntryForm').action = '/admin/income-expense/' + btn.dataset.id + '/update';
    document.getElementById('editEntryUser').value = btn.dataset.user || '';
    document.getElementById('editEntryType').value = btn.dataset.type || '1';
    feFilterBank('edit');
    feFilterCategory('edit');
    document.getElementById('editEntryCategory').value = btn.dataset.category || '';
    document.getElementById('editEntryBank').value = btn.dataset.bank || '';
    document.getElementById('editEntryTitle').value = btn.dataset.title || '';
    document.getElementById('editEntryAmount').value = btn.dataset.amount || '';
    document.getElementById('editEntryDate').value = btn.dataset.date || '';
    document.getElementById('editEntryNote').value = btn.dataset.note || '';
  });
});

document.querySelectorAll('.deleteEntryBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('deleteEntryForm').action = '/admin/income-expense/' + btn.dataset.id + '/delete';
    document.getElementById('deleteEntryTitle').textContent = btn.dataset.title || '';
  });
});
</script>

