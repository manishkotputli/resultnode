<%
function money(n) {
  return '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function maskAccount(acc) {
  if (!acc) return '•••• ••••';
  var clean = String(acc).replace(/\s+/g, '');
  var last4 = clean.slice(-4);
  return last4 ? ('•••• ' + last4) : '•••• ••••';
}
var cardThemes = ['fin-card-a', 'fin-card-b', 'fin-card-c', 'fin-card-d', 'fin-card-e', 'fin-card-f'];

var bankOptionsJson = JSON.stringify(allBanks.map(function (b) {
  return { id: b.id, name: b.name, user_id: b.user_id };
}));
var categoryOptionsJson = JSON.stringify(allCategories.map(function (c) {
  return { id: c.id, name: c.name, user_id: c.user_id, type: c.type };
}));
%>

<%- include('../../adminlayout/admin-layout-top') %>

<style>
.fin-card { color: #fff; box-shadow: 0 10px 30px -12px rgba(0,0,0,0.35); }
.fin-card-a { background: linear-gradient(135deg, #232b36 0%, #0c0f14 100%); }
.fin-card-b { background: linear-gradient(135deg, #0f9b8e 0%, #0b5f57 100%); }
.fin-card-c { background: linear-gradient(135deg, #4a8f34 0%, #16260f 100%); }
.fin-card-d { background: linear-gradient(135deg, #0f6aad 0%, #062338 100%); }
.fin-card-e { background: linear-gradient(135deg, #5b4a9e 0%, #1c1533 100%); }
.fin-card-f { background: linear-gradient(135deg, #c17a24 0%, #2e1a08 100%); }
</style>




<!-- Title -->
<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <div>
        <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold mb-1">Income &amp; Expense</h1>
        <p class="text-sm text-gray-500 mb-0">Every user's accounts and transactions, in one place.</p>
    </div>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-12 gap-4 lg:gap-6 mb-4 lg:mb-6">
    <div class="col-span-12 sm:col-span-6 xl:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-success text-white text-2xl"><i class="icon-trending-up"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Total Income</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= money(stats.income) %></h3>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 xl:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-danger text-white text-2xl"><i class="icon-trending-down"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Total Expense</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= money(stats.expense) %></h3>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 xl:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-secondary text-white text-2xl"><i class="icon-scale"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Net Balance</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= money(stats.balance) %></h3>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 xl:col-span-3">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5 hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3 h-full">
            <span class="size-14 shrink-0 flex items-center justify-center rounded-full bg-primary text-white text-2xl"><i class="icon-wallet"></i></span>
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Active Accounts</p>
                <h3 class="text-xl font-bold text-gray-900 leading-none mb-0"><%= stats.totalBanks %></h3>
            </div>
        </div>
    </div>
</div>

<!-- Accounts -->
<div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden mb-4 lg:mb-6" id="accounts">
    <div class="flex items-center justify-between p-4 border-b border-border-color gap-2 flex-wrap">
        <div>
            <h2 class="text-gray-900 text-lg font-bold mb-0.5">Accounts</h2>
            <p class="text-sm text-gray-500 mb-0"><%= banksTotal %> account<%= banksTotal === 1 ? '' : 's' %> across all users</p>
        </div>
        <button data-hs-overlay="#addBankModal" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
            <span class="flex"><i class="icon-plus"></i></span> Add Account
        </button>
    </div>

    <div class="p-4 lg:p-5">
        <% if (banks && banks.length) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
            <% banks.forEach(function(bank) { %>
            <% var theme = cardThemes[bank.id % cardThemes.length]; %>
            <div class="fin-card <%= theme %> rounded-2xl p-5 relative overflow-hidden">
                <div class="flex items-start justify-between mb-6">
                    <div>
                        <p class="text-white/60 text-[11px] font-semibold uppercase tracking-wider mb-1">Account</p>
                        <h4 class="text-white text-base font-bold mb-0"><%= bank.name %></h4>
                    </div>
                    <div class="hs-dropdown [--placement:bottom-right] [--auto-close:inside] relative inline-flex">
                        <button type="button" class="hs-dropdown-toggle size-8 rounded-full bg-white/15 hover:bg-white/25 text-white flex items-center justify-center transition-colors" aria-haspopup="menu" aria-expanded="false" aria-label="Account options"><i class="icon-ellipsis-vertical text-sm"></i></button>
                        <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-36 bg-white border border-border-color shadow rounded-lg mt-2 z-1" role="menu" aria-orientation="vertical">
                            <div class="p-2 space-y-1">
                                <button type="button"
                                    class="editBankBtn w-full flex items-center hover:bg-primary-50 px-4 py-1.75 rounded-lg text-sm text-default hover:text-primary focus:outline-hidden focus:bg-white cursor-pointer"
                                    data-hs-overlay="#editBankModal"
                                    data-id="<%= bank.id %>"
                                    data-user="<%= bank.user_id %>"
                                    data-name="<%= bank.name %>"
                                    data-account="<%= bank.account_number || '' %>"
                                    data-balance="<%= bank.opening_balance %>"
                                    data-active="<%= bank.is_active ? '1' : '0' %>">
                                    <i class="icon-pencil-line me-2"></i>Edit
                                </button>
                                <button type="button"
                                    class="deleteBankBtn w-full flex items-center hover:bg-primary-50 px-4 py-1.75 rounded-lg text-sm text-danger hover:text-danger focus:outline-hidden focus:bg-white cursor-pointer"
                                    data-hs-overlay="#deleteBankModal"
                                    data-id="<%= bank.id %>"
                                    data-name="<%= bank.name %>">
                                    <i class="icon-trash-2 me-2"></i>Remove
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="size-9 rounded-md bg-gradient-to-br from-warning to-orange mb-4"></div>

                <p class="text-white text-lg font-semibold tracking-widest mb-6"><%= maskAccount(bank.account_number) %></p>

                <div class="flex items-end justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-white/60 text-[10px] font-semibold uppercase tracking-wider mb-1">Account Holder</p>
                        <p class="text-white text-sm font-semibold mb-0 truncate"><%= bank.User ? bank.User.name : '—' %></p>
                    </div>
                    <div class="text-right shrink-0">
                        <p class="text-white/60 text-[10px] font-semibold uppercase tracking-wider mb-1">Balance</p>
                        <p class="text-white text-base font-bold mb-0"><%= money(bank.current_balance) %></p>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>

        <% var totalBankPages = Math.max(1, Math.ceil(banksTotal / banksPerPage)); %>
        <% if (totalBankPages > 1) { %>
        <div class="flex items-center justify-center gap-1 mt-5">
            <% for (var bp = 1; bp <= totalBankPages; bp++) { %>
                <a href="/admin/income-expense?bank_page=<%= bp %>#accounts" class="size-9 flex items-center justify-center rounded-full border text-sm <%= bp === bankPage ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= bp %></a>
            <% } %>
        </div>
        <% } %>

        <% } else { %>
        <div class="text-center py-10">
            <span class="size-14 rounded-full bg-primary/10 text-primary text-2xl inline-flex items-center justify-center mb-3"><i class="icon-wallet"></i></span>
            <p class="text-gray-500 mb-0">No accounts yet. Add the first one to get started.</p>
        </div>
        <% } %>
    </div>
</div>

<!-- Transactions -->
<div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden" id="transactions">
    <div class="flex items-center justify-between p-4 border-b border-border-color gap-2 flex-wrap">
        <div>
            <h2 class="text-gray-900 text-lg font-bold mb-0.5">Transactions</h2>
            <p class="text-sm text-gray-500 mb-0"><%= total %> entr<%= total === 1 ? 'y' : 'ies' %> recorded</p>
        </div>
        <button data-hs-overlay="#addEntryModal" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
            <span class="flex"><i class="icon-plus"></i></span> Add Entry
        </button>
    </div>

    <form method="GET" action="/admin/income-expense" class="flex items-center justify-between flex-wrap gap-3 p-4 border-b border-border-color">
        <div class="relative w-full sm:w-72">
            <input type="text" name="search" value="<%= filters.search %>" placeholder="Search by title..." class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-full py-2 pl-4 pr-10! focus:ring-0 focus:border-border-color">
            <button type="submit" class="absolute top-1/2 -translate-y-1/2 right-3.5 text-base text-gray-500 leading-none cursor-pointer bg-transparent border-0"><i class="icon-search"></i></button>
        </div>
        <div class="flex items-center flex-wrap gap-2 md:gap-3">
            <select name="type" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                <option value="">All Types</option>
                <option value="1" <%= filters.type === '1' ? 'selected' : '' %>>Income</option>
                <option value="2" <%= filters.type === '2' ? 'selected' : '' %>>Expense</option>
            </select>
            <select name="user" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                <option value="">All Users</option>
                <% users.forEach(function(u) { %>
                    <option value="<%= u.id %>" <%= String(filters.user) === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
                <% }) %>
            </select>
            <% if (filters.search || filters.type || filters.user) { %>
            <a href="/admin/income-expense" class="text-sm text-gray-600 hover:text-primary font-medium">Clear</a>
            <% } %>
        </div>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full min-w-[900px]">
            <thead>
                <tr class="border-b border-border-color bg-gray-50/50">
                    <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Date</th>
                    <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Title</th>
                    <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Category</th>
                    <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">Account</th>
                    <th class="px-6 py-3 bg-white text-gray-900 text-start text-[13px] font-semibold uppercase tracking-wider">User</th>
                    <th class="px-6 py-3 bg-white text-gray-900 text-end text-[13px] font-semibold uppercase tracking-wider">Amount</th>
                    <th class="px-6 py-3 bg-white text-gray-900 text-end text-[13px] font-semibold uppercase tracking-wider">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <% if (entries && entries.length) { %>
                    <% entries.forEach(function(entry) { %>
                    <tr>
                        <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= formatDate(entry.transaction_date) %></span></td>
                        <td class="px-6 py-4 border-b border-border-color bg-white">
                            <div class="flex items-center gap-3">
                                <span class="size-9 shrink-0 flex items-center justify-center rounded-full <%= Number(entry.type) === 1 ? 'bg-success/10 text-success' : 'bg-danger/10 text-danger' %> text-base">
                                    <i class="<%= Number(entry.type) === 1 ? 'icon-banknote-arrow-up' : 'icon-banknote-arrow-down' %>"></i>
                                </span>
                                <div>
                                    <p class="text-sm font-semibold text-gray-900 mb-0"><%= entry.title %></p>
                                    <span class="inline-flex items-center text-[11px] font-bold rounded px-1.5 py-0.5 <%= Number(entry.type) === 1 ? 'text-success bg-success/10' : 'text-danger bg-danger/10' %>"><%= Number(entry.type) === 1 ? 'Income' : 'Expense' %></span>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= entry.IncomeExpenseCategory ? entry.IncomeExpenseCategory.name : '—' %></span></td>
                        <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= entry.Bank ? entry.Bank.name : 'Cash / none' %></span></td>
                        <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= entry.User ? entry.User.name : '—' %></span></td>
                        <td class="px-6 py-4 border-b border-border-color bg-white text-end">
                            <span class="text-sm font-bold <%= Number(entry.type) === 1 ? 'text-success' : 'text-danger' %>"><%= Number(entry.type) === 1 ? '+' : '-' %><%= money(entry.amount) %></span>
                        </td>
                        <td class="px-6 py-4 border-b border-border-color bg-white text-end">
                            <div class="flex items-center justify-end gap-2">
                                <button type="button"
                                    class="editEntryBtn size-9 rounded-full hover:bg-gray-100 text-gray-900 flex items-center justify-center transition-colors"
                                    aria-label="Edit"
                                    data-hs-overlay="#editEntryModal"
                                    data-id="<%= entry.id %>"
                                    data-user="<%= entry.user_id %>"
                                    data-type="<%= entry.type %>"
                                    data-category="<%= entry.category_id %>"
                                    data-bank="<%= entry.bank_id || '' %>"
                                    data-title="<%= entry.title %>"
                                    data-amount="<%= entry.amount %>"
                                    data-date="<%= entry.transaction_date %>"
                                    data-note="<%= entry.note || '' %>">
                                    <i class="icon-pencil-line text-sm"></i>
                                </button>
                                <button type="button"
                                    class="deleteEntryBtn size-9 rounded-full hover:bg-gray-100 text-gray-900 hover:text-danger flex items-center justify-center transition-colors"
                                    aria-label="Delete"
                                    data-hs-overlay="#deleteEntryModal"
                                    data-id="<%= entry.id %>"
                                    data-title="<%= entry.title %>">
                                    <i class="icon-trash-2 text-sm"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7" class="px-6 py-10 text-center text-gray-500 bg-white">No entries found.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% var totalPages = Math.max(1, Math.ceil(total / perPage)); %>
    <% if (totalPages > 1) { %>
    <div class="flex items-center justify-between flex-wrap gap-3 p-4 border-t border-border-color">
        <p class="text-sm text-gray-600 mb-0">Page <%= page %> of <%= totalPages %> &middot; <%= total %> total entries</p>
        <div class="flex items-center gap-1">
            <% if (page > 1) { %>
                <a href="/admin/income-expense?page=<%= page - 1 %>&search=<%= filters.search %>&type=<%= filters.type %>&user=<%= filters.user %>#transactions" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a>
            <% } %>
            <% var pStart = Math.max(1, page - 2); var pEnd = Math.min(totalPages, page + 2); %>
            <% for (var p = pStart; p <= pEnd; p++) { %>
                <a href="/admin/income-expense?page=<%= p %>&search=<%= filters.search %>&type=<%= filters.type %>&user=<%= filters.user %>#transactions" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a>
            <% } %>
            <% if (page < totalPages) { %>
                <a href="/admin/income-expense?page=<%= page + 1 %>&search=<%= filters.search %>&type=<%= filters.type %>&user=<%= filters.user %>#transactions" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a>
            <% } %>
        </div>
    </div>
    <% } %>
</div>

<!-- Add Bank Modal -->
<div id="addBankModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" action="/admin/income-expense/bank">
                    <div class="flex items-center justify-between p-4 border-b border-border-color">
                        <h3 class="text-lg font-bold text-gray-900">Add Account</h3>
                        <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200" aria-label="Close" data-hs-overlay="#addBankModal">
                            <i class="icon-x"></i>
                        </button>
                    </div>
                    <div class="p-4 space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">User <span class="text-danger">*</span></label>
                            <select name="user_id" required class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                                <option value="">Select user</option>
                                <% users.forEach(function(u) { %>
                                    <option value="<%= u.id %>"><%= u.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Account Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" required placeholder="e.g. HDFC Savings" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Account Number <span class="text-gray-400 font-normal">(optional)</span></label>
                            <input type="text" name="account_number" placeholder="e.g. 000123452345" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Opening Balance</label>
                            <input type="number" step="0.01" min="0" name="opening_balance" value="0" class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-gray-900">Active</label>
                            <input type="checkbox" name="is_active" checked class="w-5 h-5 text-primary border-border-color rounded focus:ring-0 cursor-pointer">
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#addBankModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-hover cursor-pointer">Add Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Bank Modal (shared, populated via JS) -->
<div id="editBankModal" class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">
    <div>
        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">
            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">
                <form method="POST" id="editBankForm" action="">
                    <div class="flex items-center justify-between p-4 border-b border-border-color">
                        <h3 class="text-lg font-bold text-gray-900">Edit Account</h3>
                        <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200" aria-label="Close" data-hs-overlay="#editBankModal">
                            <i class="icon-x"></i>
                        </button>
                    </div>
                    <div class="p-4 space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">User <span class="text-danger">*</span></label>
                            <select name="user_id" id="editBankUser" required class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                                <option value="">Select user</option>
                                <% users.forEach(function(u) { %>
                                    <option value="<%= u.id %>"><%= u.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Account Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" id="editBankName" required class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3 focus:ring-0 focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-900 mb-2">Account Number</label>
