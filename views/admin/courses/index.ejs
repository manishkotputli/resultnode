<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Courses</h1>
    <a href="/admin/courses/create" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
        <span class="flex"><i class="icon-plus"></i></span> Add Course
    </a>
</div>

<div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4 mb-6">
    <form method="GET" action="/admin/courses" class="flex items-center justify-between flex-wrap gap-3">
        <div class="relative w-full sm:w-72">
            <input type="text" name="search" value="<%= filters.search %>" placeholder="Search courses..." class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-full py-2 pl-4 pr-10! focus:ring-0 focus:border-border-color">
            <button type="submit" class="absolute top-1/2 -translate-y-1/2 right-3.5 text-base text-gray-500 leading-none cursor-pointer bg-transparent border-0"><i class="icon-search"></i></button>
        </div>
        <select name="status" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
            <option value="">All Status</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
    </form>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 lg:gap-6">
    <% if (courses && courses.length) { %>
        <% courses.forEach(function(c) { %>
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden flex flex-col">
            <img src="<%= c.thumbnail || '/admin-assets/logo-small.svg' %>" class="w-full h-40 object-cover bg-light" alt="<%= c.title %>">
            <div class="p-4 flex flex-col grow">
                <div class="flex items-start justify-between gap-2 mb-2">
                    <h3 class="text-gray-900 text-base font-bold mb-0"><%= c.title %></h3>
                    <span class="shrink-0 inline-flex items-center text-xs font-bold rounded-lg px-2.5 py-1 border <%= c.is_active ? 'text-success border-success' : 'text-gray-500 border-gray-300' %>"><%= c.is_active ? 'Active' : 'Inactive' %></span>
                </div>
                <p class="text-sm text-gray-500 mb-3 line-clamp-2 grow"><%= (c.description || '').slice(0, 100) %></p>
<div class="flex items-center flex-wrap gap-x-3 gap-y-1 text-xs text-gray-500 mb-3">
    <span class="inline-flex items-center gap-1"><i class="icon-play-circle"></i> <%= c.lessonCount %> lesson<%= c.lessonCount === 1 ? '' : 's' %></span>
    <% if (c.duration_hours) { %><span class="inline-flex items-center gap-1"><i class="icon-timer"></i> <%= c.duration_hours %> hrs</span><% } %>
</div>
<div class="flex items-center gap-2 mb-4">
                    <% if (c.discount_price) { %>
                        <span class="text-lg font-bold text-gray-900">₹<%= c.discount_price %></span>
                        <span class="text-sm text-gray-400 line-through">₹<%= c.price %></span>
                    <% } else { %>
                        <span class="text-lg font-bold text-gray-900">₹<%= c.price %></span>
                    <% } %>
                </div>
                
                <div class="flex items-center gap-2 mt-auto">
                    <a href="/admin/courses/<%= c.id %>/lessons" class="block text-center py-2 mb-2 rounded-full bg-primary/10 text-primary text-sm font-medium hover:bg-primary/20">Manage Lessons</a>
                    <a href="/admin/courses/<%= c.id %>/edit" class="flex-1 text-center py-2 rounded-full bg-white border border-border-color text-gray-900 text-sm font-medium hover:bg-light">Edit</a>
                    <form method="POST" action="/admin/courses/<%= c.id %>/delete" onsubmit="return confirm('Delete this course? This cannot be undone.');" class="flex-1">
                        <button type="submit" class="w-full py-2 rounded-full bg-white border border-border-color text-danger text-sm font-medium hover:bg-danger/5 cursor-pointer">Delete</button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    <% } else { %>
        <div class="col-span-full text-center py-16 text-gray-500 bg-white-50 rounded-lg border border-border-color">No courses found. <a href="/admin/courses/create" class="text-primary font-medium">Add your first course</a>.</div>
    <% } %>
</div>

<% if (pagination.totalPages > 1) { %>
<div class="flex items-center justify-between flex-wrap gap-3 mt-6">
    <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total courses</p>
    <div class="flex items-center gap-1">
        <% if (pagination.hasPrev) { %><a href="/admin/courses?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
        <% pagination.pages.forEach(function(p) { %><a href="/admin/courses?page=<%= p %>&search=<%= filters.search %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
        <% if (pagination.hasNext) { %><a href="/admin/courses?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&status=<%= filters.status %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
    </div>
</div>
<% } %>

<%- include('../../adminlayout/admin-layout-bottom') %>
