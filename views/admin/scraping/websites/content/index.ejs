<%- include('../../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Scraped Content</h1>
</div>

<div class="grid grid-cols-1">
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden">

        <form method="GET" action="/admin/scraping/content" class="flex items-center justify-between flex-wrap gap-3 p-4 border-b border-border-color">
            <div class="relative w-full sm:w-64">
                <input type="text" name="search" value="<%= filters.search %>" placeholder="Search title..." class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-full py-2 pl-4 pr-10! focus:ring-0 focus:border-border-color">
                <button type="submit" class="absolute top-1/2 -translate-y-1/2 right-3.5 text-base text-gray-500 leading-none cursor-pointer bg-transparent border-0"><i class="icon-search"></i></button>
            </div>
            <div class="flex items-center flex-wrap gap-2 md:gap-3">
                <select name="website" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                    <option value="">All Websites</option>
                    <% websites.forEach(function(w) { %><option value="<%= w.id %>" <%= String(filters.website) === String(w.id) ? 'selected' : '' %>><%= w.name %></option><% }) %>
                </select>
                <select name="status" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                    <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Pending</option>
                    <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
                    <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                    <option value="" <%= filters.status === '' ? 'selected' : '' %>>All</option>
                </select>
            </div>
        </form>

        <form method="POST" action="/admin/scraping/content/bulk" id="bulkForm">
            <div class="flex items-center gap-3 p-4 border-b border-border-color bg-light" id="bulkBar" style="display:none;">
                <span class="text-sm text-gray-600"><span id="selectedCount">0</span> selected</span>
                <button type="submit" name="bulk_action" value="publish" class="text-sm font-medium text-success hover:underline cursor-pointer">Bulk Publish</button>
                <button type="submit" name="bulk_action" value="reject" class="text-sm font-medium text-orange hover:underline cursor-pointer">Bulk Reject</button>
                <button type="submit" name="bulk_action" value="delete" onclick="return confirm('Delete selected items?');" class="text-sm font-medium text-danger hover:underline cursor-pointer">Bulk Delete</button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px]">
                    <thead>
                        <tr class="bg-light">
                            <th class="px-4 py-3 text-left"><input type="checkbox" id="selectAll" class="w-4 h-4 rounded cursor-pointer"></th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Title</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Website</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Scraped</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Status</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        <% if (items && items.length) { %>
                            <% items.forEach(function(it) { %>
                            <tr>
                                <td class="px-4 py-4 border-b border-border-color bg-white"><input type="checkbox" name="ids" value="<%= it.id %>" class="rowCheck w-4 h-4 rounded cursor-pointer"></td>
                                <td class="px-4 py-4 border-b border-border-color bg-white">
                                    <a href="/admin/scraping/content/<%= it.id %>/edit" class="text-sm font-semibold text-gray-900 hover:text-primary"><%= it.post_title %></a>
                                    <p class="text-[12px] text-gray-400 mb-0 truncate max-w-[320px]"><a href="<%= it.detail_url %>" target="_blank" rel="noopener" class="hover:underline"><%= it.detail_url %></a></p>
                                </td>
                                <td class="px-4 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= it.ScrapingWebsite ? it.ScrapingWebsite.name : '-' %></span></td>
                                <td class="px-4 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= formatDate(it.scraped_at) %></span></td>
                                <td class="px-4 py-4 border-b border-border-color bg-white">
                                    <span class="inline-flex items-center text-xs font-bold rounded-lg px-2.5 py-1 border <%= it.status === 'published' ? 'text-success border-success' : (it.status === 'rejected' ? 'text-danger border-danger' : 'text-orange border-orange') %>">
                                        <%= it.status === 'draft' ? 'Pending' : it.status %>
                                    </span>
                                </td>
                                <td class="px-4 py-4 border-b border-border-color bg-white text-end">
                                    <div class="flex items-center justify-end gap-1">
                                        <a href="/admin/scraping/content/<%= it.id %>/edit" class="size-9 rounded-full hover:bg-gray-100 text-gray-900 inline-flex items-center justify-center" title="Preview / Edit"><i class="icon-pencil-line text-sm"></i></a>
                                        <% if (it.status === 'draft') { %>
                                        <form method="POST" action="/admin/scraping/content/<%= it.id %>/publish"><button type="submit" class="size-9 rounded-full hover:bg-gray-100 text-success inline-flex items-center justify-center cursor-pointer" title="Publish"><i class="icon-check text-sm"></i></button></form>
                                        <form method="POST" action="/admin/scraping/content/<%= it.id %>/reject"><button type="submit" class="size-9 rounded-full hover:bg-gray-100 text-orange inline-flex items-center justify-center cursor-pointer" title="Reject"><i class="icon-x text-sm"></i></button></form>
                                        <% } %>
                                        <form method="POST" action="/admin/scraping/content/<%= it.id %>/delete" onsubmit="return confirm('Delete this item?');"><button type="submit" class="size-9 rounded-full hover:bg-gray-100 text-danger inline-flex items-center justify-center cursor-pointer" title="Delete"><i class="icon-trash-2 text-sm"></i></button></form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6" class="px-6 py-10 text-center text-gray-500 bg-white">No items found for this filter.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </form>

        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border-t border-border-color">
            <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total</p>
            <div class="flex items-center gap-1">
                <% if (pagination.hasPrev) { %><a href="/admin/scraping/content?page=<%= pagination.page - 1 %>&status=<%= filters.status %>&website=<%= filters.website %>&search=<%= filters.search %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
                <% pagination.pages.forEach(function(p) { %><a href="/admin/scraping/content?page=<%= p %>&status=<%= filters.status %>&website=<%= filters.website %>&search=<%= filters.search %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
                <% if (pagination.hasNext) { %><a href="/admin/scraping/content?page=<%= pagination.page + 1 %>&status=<%= filters.status %>&website=<%= filters.website %>&search=<%= filters.search %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
            </div>
        </div>
        <% } %>
    </div>
</div>

<%
pageScripts = `
var selectAll = document.getElementById('selectAll');
var bulkBar = document.getElementById('bulkBar');
var selectedCount = document.getElementById('selectedCount');

function refreshBulkBar() {
  var checked = document.querySelectorAll('.rowCheck:checked').length;
  selectedCount.textContent = checked;
  bulkBar.style.display = checked > 0 ? 'flex' : 'none';
}

selectAll.addEventListener('change', function () {
  document.querySelectorAll('.rowCheck').forEach(function (cb) { cb.checked = selectAll.checked; });
  refreshBulkBar();
});

document.addEventListener('change', function (e) {
  if (e.target.classList.contains('rowCheck')) refreshBulkBar();
});
`;
%>

<%- include('../../../adminlayout/admin-layout-bottom') %>
