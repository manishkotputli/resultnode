<%- include('../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Scraping Dashboard</h1>
    <a href="/admin/scraping/websites" class="btn px-4 py-2 rounded-full bg-primary text-white text-sm font-medium inline-flex items-center gap-2 hover:bg-primary-hover transition hover:text-white">
        <i class="icon-plus"></i> Manage Websites
    </a>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-2 lg:grid-cols-3 xxl:grid-cols-6 gap-4 mb-6">
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4">
        <p class="text-xs font-medium text-gray-500 mb-1">Total Websites</p>
        <h3 class="text-2xl font-bold text-gray-900 mb-0"><%= stats.totalWebsites %></h3>
    </div>
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4">
        <p class="text-xs font-medium text-gray-500 mb-1">Active Websites</p>
        <h3 class="text-2xl font-bold text-success mb-0"><%= stats.activeWebsites %></h3>
    </div>
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4">
        <p class="text-xs font-medium text-gray-500 mb-1">Pending Review</p>
        <h3 class="text-2xl font-bold text-orange mb-0"><%= stats.pendingContent %></h3>
    </div>
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4">
        <p class="text-xs font-medium text-gray-500 mb-1">Published Today</p>
        <h3 class="text-2xl font-bold text-primary mb-0"><%= stats.publishedToday %></h3>
    </div>
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4">
        <p class="text-xs font-medium text-gray-500 mb-1">Failed Today</p>
        <h3 class="text-2xl font-bold text-danger mb-0"><%= stats.failedToday %></h3>
    </div>
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-4">
        <p class="text-xs font-medium text-gray-500 mb-1">Success Rate</p>
        <h3 class="text-2xl font-bold text-gray-900 mb-0"><%= stats.successRate %>%</h3>
    </div>
</div>

<div class="grid grid-cols-12 gap-4 lg:gap-6">

    <!-- Daily published bar chart (simple, no external chart lib needed) -->
    <div class="col-span-12 xxl:col-span-6">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
            <h2 class="text-gray-900 text-lg font-bold mb-4">Posts Published — Last 7 Days</h2>
            <% const maxCount = Math.max(1, ...dailyCounts.map(d => d.count)); %>
            <div class="flex items-end gap-3 h-40">
                <% dailyCounts.forEach(function(d) { %>
                <div class="flex-1 flex flex-col items-center justify-end h-full gap-2">
                    <span class="text-xs font-semibold text-gray-700"><%= d.count %></span>
                    <div class="w-full bg-primary/15 rounded-t-md relative" style="height: <%= Math.round((d.count / maxCount) * 100) %>%; min-height: 4px;">
                        <div class="absolute inset-0 bg-primary rounded-t-md"></div>
                    </div>
                    <span class="text-[11px] text-gray-400"><%= d.date.slice(5) %></span>
                </div>
                <% }) %>
            </div>
        </div>
    </div>

    <!-- Recent website activity -->
    <div class="col-span-12 xxl:col-span-6">
        <div class="bg-white-50 rounded-lg border border-border-color shadow-xs p-5">
            <h2 class="text-gray-900 text-lg font-bold mb-4">Recent Website Activity</h2>
            <div class="space-y-3">
                <% if (recentActivity && recentActivity.length) { %>
                    <% recentActivity.forEach(function(w) { %>
                    <div class="flex items-center justify-between p-2 rounded-lg hover:bg-light">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-gray-900 mb-0 truncate"><%= w.name %></p>
                            <p class="text-xs text-gray-400 mb-0">Last run: <%= formatDate(w.last_scraped_at) %></p>
                        </div>
                        <span class="shrink-0 inline-flex items-center text-xs font-bold rounded-lg px-2.5 py-1 border <%= w.last_status === 'success' ? 'text-success border-success' : (w.last_status === 'failed' ? 'text-danger border-danger' : 'text-gray-500 border-gray-300') %>">
                            <%= w.last_status || 'idle' %>
                        </span>
                    </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-sm text-gray-500">No scraping runs yet. <a href="/admin/scraping/websites" class="text-primary font-medium">Add a website</a> to get started.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../../adminlayout/admin-layout-bottom') %>
