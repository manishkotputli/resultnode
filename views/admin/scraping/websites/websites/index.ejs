                    </div>
                    <div class="flex justify-end gap-2 p-4 border-t border-border-color">
                        <button type="button" class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50 cursor-pointer" data-hs-overlay="#editWebsiteModal">Cancel</button>
                        <button type="submit" class="py-2 px-4 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-hover cursor-pointer">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%
pageScripts = `
function toggleCronInput(root) {
  var sel = root.querySelector('.schedule-select');
  var cronInput = root.querySelector('.cron-input');
  function sync() { cronInput.classList.toggle('hidden', sel.value !== 'custom'); }
  sel.addEventListener('change', sync);
  sync();
}
document.querySelectorAll('#addWebsiteModal, #editWebsiteModal').forEach(toggleCronInput);

document.querySelectorAll('.editWebsiteBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.getElementById('editWebsiteForm').action = '/admin/scraping/websites/' + btn.dataset.id + '/update';
    document.getElementById('editWName').value = btn.dataset.name || '';
    document.getElementById('editWUrl').value = btn.dataset.url || '';
    document.getElementById('editWScraperType').value = btn.dataset.scraperType || 'puppeteer';
    document.getElementById('editWActive').value = btn.dataset.active === 'true' ? 'on' : 'off';
    document.getElementById('editWScheduleType').value = btn.dataset.scheduleType || 'manual';
    document.getElementById('editWCron').value = btn.dataset.cron || '';
    document.getElementById('editWList').value = btn.dataset.listSelector || '';
    document.getElementById('editWTitle').value = btn.dataset.titleSelector || '';
    document.getElementById('editWLink').value = btn.dataset.linkSelector || '';
    document.getElementById('editWDate').value = btn.dataset.dateSelector || '';
    document.getElementById('editWDetail').value = btn.dataset.detailSelector || '';
    document.getElementById('editWAutoPublish').checked = btn.dataset.autoPublish === 'true';

    var selectedCats = [];
    try { selectedCats = JSON.parse(btn.dataset.categories || '[]'); } catch (e) {}
    document.querySelectorAll('#editWCategories input[type=checkbox]').forEach(function (cb) {
      cb.checked = selectedCats.indexOf(cb.value) !== -1;
    });

    var cronInput = document.getElementById('editWCron');
    cronInput.classList.toggle('hidden', document.getElementById('editWScheduleType').value !== 'custom');
  });
});

// ---- Run Now: AJAX + animated "processing" state, no page reload ----
document.querySelectorAll('.runNowBtn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    if (btn.disabled) return;
    var id = btn.dataset.websiteId;
    var row = document.querySelector('tr[data-website-row="' + id + '"]');
    var statusCell = row.querySelector('[data-cell="status"]');
    var errorCell = row.querySelector('[data-cell="error"]');
    var originalStatusHtml = statusCell.innerHTML;

    btn.disabled = true;
    btn.innerHTML = '<i class="icon-loader-2 text-sm animate-spin"></i>';
    statusCell.innerHTML =
      '<span class="inline-flex items-center gap-1.5 text-xs font-bold rounded-lg px-2.5 py-1 border text-orange border-orange">' +
      '<span class="relative flex size-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange opacity-75"></span><span class="relative inline-flex rounded-full size-2 bg-orange"></span></span>' +
      'processing…</span>';
    if (errorCell) errorCell.innerHTML = '';

    fetch('/admin/scraping/websites/' + id + '/run', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
    })
      .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
      .then(function (res) {
        btn.disabled = false;
        btn.innerHTML = '<i class="icon-play text-sm"></i>';

        if (!res.ok || !res.data.ok) {
          statusCell.innerHTML = '<span class="inline-flex items-center text-xs font-bold rounded-lg px-2.5 py-1 border text-danger border-danger">failed</span>';
          if (errorCell) errorCell.innerHTML = '<span class="text-danger">⚠ ' + (res.data.error || 'Scrape failed') + '</span>';
          return;
        }

        var d = res.data;
        statusCell.innerHTML = '<span class="inline-flex items-center text-xs font-bold rounded-lg px-2.5 py-1 border text-success border-success">success</span>';
        var itemsCell = row.querySelector('[data-cell="items"] span');
        if (itemsCell) itemsCell.textContent = (parseInt(itemsCell.textContent, 10) || 0) + d.imported;
        var lastRunCell = row.querySelector('[data-cell="last_run"] span');
        if (lastRunCell) lastRunCell.textContent = 'Just now';

        var msg = d.imported + ' new item(s)';
        if (d.published) msg += ', ' + d.published + ' auto-published';
        msg += ', ' + d.skipped + ' duplicate(s) skipped';
        if (window.HSOverlay) { /* no-op, keeping hook for future toast lib */ }
        console.log('[scrape] ' + msg);
      })
      .catch(function () {
        btn.disabled = false;
        btn.innerHTML = '<i class="icon-play text-sm"></i>';
        statusCell.innerHTML = originalStatusHtml;
        if (errorCell) errorCell.innerHTML = '<span class="text-danger">⚠ Network error — check server logs</span>';
      });
  });
});
`;
