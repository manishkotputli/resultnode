<%- include('../../../adminlayout/admin-layout-top') %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-gray-900 text-xl lg:text-[28px] font-bold">Scraping Logs</h1>
</div>

<div class="grid grid-cols-1">
    <div class="bg-white-50 rounded-lg border border-border-color shadow-xs overflow-hidden">

        <form method="GET" action="/admin/scraping/logs" class="flex items-center justify-between flex-wrap gap-3 p-4 border-b border-border-color">
            <div class="relative w-full sm:w-64">
                <input type="text" name="search" value="<%= filters.search %>" placeholder="Search title..." class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-full py-2 pl-4 pr-10! focus:ring-0 focus:border-border-color">
                <button type="submit" class="absolute top-1/2 -translate-y-1/2 right-3.5 text-base text-gray-500 leading-none cursor-pointer bg-transparent border-0"><i class="icon-search"></i></button>
            </div>
            <div class="flex items-center flex-wrap gap-2 md:gap-3">
                <select name="website" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                    <option value="">All Websites</option>
                    <% websites.forEach(function(w) { %><option value="<%= w.id %>" <%= String(filters.website) === String(w.id) ? 'selected' : '' %>><%= w.name %></option><% }) %>
                </select>
                <select name="status" onchange="this.form.submit()" class="form-select bg-white border border-border-color text-sm font-medium text-gray-900 rounded-full py-2 px-3 focus:ring-0">
                    <option value="">All Status</option>
                    <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Pending</option>
                    <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
                    <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                </select>
            </div>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[800px]">
                <thead>
                    <tr class="bg-light">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Title</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Website</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Scraped At</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Published Post</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    <% if (items && items.length) { %>
                        <% items.forEach(function(it) { %>
                        <tr>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm font-medium text-gray-900"><%= it.post_title %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= it.ScrapingWebsite ? it.ScrapingWebsite.name : '-' %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white"><span class="text-sm text-gray-600"><%= formatDate(it.scraped_at) %></span></td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <span class="inline-flex items-center text-xs font-bold rounded-lg px-2.5 py-1 border <%= it.status === 'published' ? 'text-success border-success' : (it.status === 'rejected' ? 'text-danger border-danger' : 'text-orange border-orange') %>">
                                    <%= it.status === 'draft' ? 'Pending' : it.status %>
                                </span>
                            </td>
                            <td class="px-6 py-4 border-b border-border-color bg-white">
                                <% if (it.post_id) { %><a href="/admin/posts/<%= it.post_id %>/edit" class="text-sm text-primary hover:underline">View Post</a><% } else { %><span class="text-sm text-gray-400">—</span><% } %>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5" class="px-6 py-10 text-center text-gray-500 bg-white">No scraping history yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border-t border-border-color">
            <p class="text-sm text-gray-600 mb-0">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= total %> total</p>
            <div class="flex items-center gap-1">
                <% if (pagination.hasPrev) { %><a href="/admin/scraping/logs?page=<%= pagination.page - 1 %>&status=<%= filters.status %>&website=<%= filters.website %>&search=<%= filters.search %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-left"></i></a><% } %>
                <% pagination.pages.forEach(function(p) { %><a href="/admin/scraping/logs?page=<%= p %>&status=<%= filters.status %>&website=<%= filters.website %>&search=<%= filters.search %>" class="size-9 flex items-center justify-center rounded-full border text-sm <%= p === pagination.page ? 'bg-primary text-white border-primary' : 'border-border-color hover:bg-light' %>"><%= p %></a><% }) %>
                <% if (pagination.hasNext) { %><a href="/admin/scraping/logs?page=<%= pagination.page + 1 %>&status=<%= filters.status %>&website=<%= filters.website %>&search=<%= filters.search %>" class="size-9 flex items-center justify-center rounded-full border border-border-color text-sm hover:bg-light"><i class="icon-chevron-right"></i></a><% } %>
            </div>
        </div>
        <% } %>
    </div>
</div>

<%- include('../../../adminlayout/admin-layout-bottom') %>
