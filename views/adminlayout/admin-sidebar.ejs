<!-- =========================
     Sidebar
========================= -->
<aside class="sidebar" id="sidebar">

    <!-- Logo -->
    <div class="sidebar-logo">
        <div>
            <a href="/admin/dashboard" class="logo logo-normal">
                <img src="/admin-assets/logo.png" alt="Logo">
            </a>

            <a href="/admin/dashboard" class="logo-small">
                <img src="/admin-assets/logo-small.png" alt="Logo">
            </a>

            <a href="/admin/dashboard" class="dark-logo">
                <img src="/admin-assets/logo-white.png" alt="Logo">
            </a>
        </div>

        <button class="sidenav-toggle-btn btn p-0 active" id="toggle_btn" aria-label="Toggle Sidebar">
            <i class="icon-chevron-left"></i>
        </button>

        <button type="button" class="sidebar-close" aria-label="Close Sidebar">
            <i class="icon icon-x"></i>
        </button>
    </div>

    <div class="sidebar-inner" data-simplebar>

        <div id="sidebar-menu" class="sidebar-menu">

            <ul>

                <!-- Dashboard -->
                <li class="menu-title"><span>Main</span></li>

                <li>
                    <a href="/admin/dashboard"
                        class="<%= active==='dashboard' ? 'active' : '' %>">
                        <i class="icon-layout-panel-left"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <!-- ================= Content ================= -->

                <li class="menu-title">
                    <span>Content Management</span>
                </li>

                <!-- Posts -->

                <li class="submenu <%= ['posts','add-post'].includes(active) ? 'active' : '' %>">

                    <a href="javascript:void(0);">
                        <i class="icon-file-text"></i>
                        <span>Posts</span>
                        <span class="menu-arrow"></span>
                    </a>

                    <ul>

                        <li>
                            <a href="/admin/posts"
                                class="<%= active==='posts' ? 'active' : '' %>">
                                All Posts
                            </a>
                        </li>

                        <li>
                            <a href="/admin/posts/create"
                                class="<%= active==='add-post' ? 'active' : '' %>">
                                Add New
                            </a>
                        </li>

                        <% if(navCategories?.length){ %>

                            <% navCategories.forEach(cat=>{ %>

                                <li>
                                    <a href="/admin/posts?category=<%= cat.slug %>">
                                        <%= cat.name %>
                                    </a>
                                </li>

                            <% }) %>

                        <% } %>

                    </ul>

                </li>

                <!-- Categories -->

                <li>
                    <a href="/admin/categories"
                        class="<%= active==='categories' ? 'active' : '' %>">
                        <i class="icon-folder-tree"></i>
                        <span>Categories</span>
                    </a>
                </li>

                <!-- Blog -->

                <li class="submenu <%= active==='blogs' ? 'active' : '' %>">

                    <a href="javascript:void(0);">
                        <i class="icon-newspaper"></i>
                        <span>Blog</span>
                        <span class="menu-arrow"></span>
                    </a>

                    <ul>

                        <li>
                            <a href="/admin/blogs"
                                class="<%= active==='blogs' ? 'active' : '' %>">
                                All Blogs
                            </a>
                        </li>

                        <li>
                            <a href="/admin/blogs/create">
                                Add Blog
                            </a>
                        </li>

                        <li>
                            <a href="/admin/blog-categories">
                                Blog Categories
                            </a>
                        </li>

                    </ul>

                </li>

                <!-- Courses -->

                <li>
                    <a href="/admin/courses"
                        class="<%= active==='courses' ? 'active' : '' %>">
                        <i class="icon-graduation-cap"></i>
                        <span>Courses</span>
                    </a>
                </li>

                <!-- Test Series -->

                <li>
                    <a href="/admin/test-series"
                        class="<%= active==='test-series' ? 'active' : '' %>">
                        <i class="icon-clipboard-check"></i>
                        <span>Test Series</span>
                    </a>
                </li>

                <!-- Banners -->

                <li>
                    <a href="/admin/banners"
                        class="<%= active==='banners' ? 'active' : '' %>">
                        <i class="icon-image"></i>
                        <span>Banners</span>
                    </a>
                </li>

                <!-- FAQs -->

                <li>
                    <a href="/admin/faqs"
                        class="<%= active==='faqs' ? 'active' : '' %>">
                        <i class="icon-circle-help"></i>
                        <span>FAQs</span>
                    </a>
                </li>



                <!-- ================= Scraping ================= -->

<li class="menu-title">
    <span>Scraping</span>
</li>

<li class="submenu <%= ['scraping-dashboard','scraping-websites','scraping-content','scraping-logs'].includes(active) ? 'active' : '' %>">

    <a href="javascript:void(0);">
        <i class="icon-database-import"></i>
        <span>Scraping</span>
        <span class="menu-arrow"></span>
    </a>

    <ul>

        <li>
            <a href="/admin/scraping/dashboard"
               class="<%= active==='scraping-dashboard' ? 'active' : '' %>">
                Dashboard
            </a>
        </li>

        <li>
            <a href="/admin/scraping/websites"
               class="<%= active==='scraping-websites' ? 'active' : '' %>">
                Websites
            </a>
        </li>

        <li>
            <a href="/admin/scraping/content"
               class="<%= active==='scraping-content' ? 'active' : '' %>">
                Scraped Content
            </a>
        </li>

        <li>
            <a href="/admin/scraping/logs"
               class="<%= active==='scraping-logs' ? 'active' : '' %>">
                Logs
            </a>
        </li>

    </ul>

</li>

                <!-- ================= Sales ================= -->

                <li class="menu-title">
                    <span>Sales</span>
                </li>

                <li>
                    <a href="/admin/purchases"
                        class="<%= active==='purchases' ? 'active' : '' %>">
                        <i class="icon-receipt"></i>
                        <span>Purchases</span>
                    </a>
                </li>

                <li>
                    <a href="/admin/income-expense"
                        class="<%= active==='income-expense' ? 'active' : '' %>">
                        <i class="icon-wallet"></i>
                        <span>Income & Expense</span>
                    </a>
                </li>

                <!-- ================= Users ================= -->

                <li class="menu-title">
                    <span>Users</span>
                </li>

                <li>
                    <a href="/admin/users"
                        class="<%= active==='users' ? 'active' : '' %>">
                        <i class="icon-users"></i>
                        <span>Users</span>
                    </a>
                </li>

                <li>
                    <a href="/admin/comments"
                        class="<%= active==='comments' ? 'active' : '' %>">
                        <i class="icon-message-square"></i>
                        <span>Comments</span>
                    </a>
                </li>

                <li>
                    <a href="/admin/contact-messages"
                        class="<%= active==='contact-messages' ? 'active' : '' %>">
                        <i class="icon-mail"></i>
                        <span>Contact Messages</span>
                    </a>
                </li>

                <!-- ================= Administration ================= -->

                <li class="menu-title">
                    <span>Administration</span>
                </li>

                <li>
                    <a href="/admin/roles"
                        class="<%= active==='roles' ? 'active' : '' %>">
                        <i class="icon-shield-check"></i>
                        <span>Roles & Permissions</span>
                    </a>
                </li>

                <!-- Settings -->

                <li class="submenu <%= ['settings','profile'].includes(active) ? 'active' : '' %>">

                    <a href="javascript:void(0);">
                        <i class="icon-settings"></i>
                        <span>Settings</span>
                        <span class="menu-arrow"></span>
                    </a>

                    <ul>

                        <li>
                            <a href="/admin/settings"
                                class="<%= active==='settings' ? 'active' : '' %>">
                                General Settings
                            </a>
                        </li>

                        <li>
                            <a href="/admin/profile"
                                class="<%= active==='profile' ? 'active' : '' %>">
                                Profile
                            </a>
                        </li>

                    </ul>

                </li>

            </ul>

        </div>

    </div>

</aside>
