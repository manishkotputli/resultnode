<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' && title ? title : ((site_setting && site_setting.site_title) || 'Sarkari Result') %></title>
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
    <meta property="og:description" content="<%= metaDescription %>">
  <% } %>
  <% if (typeof metaKeywords !== 'undefined' && metaKeywords) { %>
    <meta name="keywords" content="<%= metaKeywords %>">
  <% } %>
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : ((site_setting && site_setting.site_title) || 'Sarkari Result') %>">
  <meta property="og:type" content="article">
  <% if (site_setting && site_setting.favicon) { %>
    <link rel="icon" href="<%= site_setting.favicon %>">
  <% } %>

  <link rel="stylesheet" href="/css/sarkari-style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">

  <% if (typeof pageStyles !== 'undefined' && pageStyles) { %>
    <style><%- pageStyles %></style>
  <% } %>
</head>
<body>

  <%- include('./header') %>
  <%- include('./navbar') %>

  <% if (typeof messages !== 'undefined' && (messages.success || messages.error)) { %>
    <div class="flash-messages" style="max-width:1100px;margin:12px auto 0;padding:0 15px;">
      <% (messages.success || []).forEach(function(m) { %>
        <div style="background:#e6f7ea;border:1px solid #0a8a3e;color:#0a8a3e;padding:10px 14px;border-radius:4px;margin-bottom:8px;"><%= m %></div>
      <% }) %>
      <% (messages.error || []).forEach(function(m) { %>
        <div style="background:#fdeaea;border:1px solid #c00;color:#c00;padding:10px 14px;border-radius:4px;margin-bottom:8px;"><%= m %></div>
      <% }) %>
    </div>
  <% } %>

  <div class="page-wrapper">
