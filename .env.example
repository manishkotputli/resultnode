APP_NAME="Sarkari Result"
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# DB_DIALECT: sqlite | mysql | postgres
# Laravel app currently runs on sqlite by default - keeping that here too so
# `npm install && npm run db:migrate && npm run db:seed && npm start` works
# immediately with zero external DB setup. Switch to mysql any time by
# changing DB_DIALECT and filling in the DB_* values below.
DB_DIALECT=sqlite
DB_STORAGE=./database/database.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sarkari_result
DB_USER=root
DB_PASSWORD=

SESSION_SECRET=replace_with_a_long_random_string
UPLOAD_DIR=public/uploads
